# Build output
[Bb]in/
[Oo]bj/
.vs/
*.user

# Python analytics environments and generated caches
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# dotnet publish output (regenerated by scripts/iis-setup.ps1)
/publish/

# OSS reference repos — cloned for reading / UI reference, not part of this project.
# See _research/README.md. Delete the folder anytime to reclaim disk.
/_research/

# SDD scratch (subagent-driven-development workspace)
/.superpowers/

# git worktrees (isolated task workspaces)
/.claude/worktrees/

# Obsidian vault — shared config is committed; only per-user editor state is ignored
/.obsidian/workspace.json
/.obsidian/workspace-mobile.json
/.obsidian/cache
/.obsidian/plugins/*/data.json

# Throwaway scratch dir (JHora reference exports now live in docs/artifacts/reference-charts/)
/scratch/

# Ad-hoc CLI output redirects
/build_output.txt
/verify_*_output.txt

# Ad-hoc DDL notebooks
/db/*.ipynb

# Chart snapshot mismatches (transient; the committed baseline is *-sample.svg)
/docs/artifacts/ui/*-sample.received.svg

# Throwaway browser profiles + server logs from the UI-verification scripts
/reports/edge-*-profile*/
/reports/*.log
/reports/*.err.log

# Playwright E2E failure artifacts (tests/Ikiastrro.Web.E2E)
/reports/e2e/

# Saved-people CSV safety copies (personal data)
/exports/

# Historic-figures expansion pipeline intermediates (regenerable)
/tools/historic_figures/candidates.json
/tools/historic_figures/picked.json
/tools/historic_figures/facts.json
