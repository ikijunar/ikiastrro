@page "/charts"
@using Microsoft.AspNetCore.Components.Forms
@using Ikiastrro.Core.Engines.Astronomy
@inject BirthDetailsRepository BirthDetailsRepo
@inject ChartResultsRepository ChartResultsRepo
@inject ChartKeyDetailsRepository ChartKeyDetailsRepo
@inject BirthDetailDeletionService DeletionService
@inject ChartGenerationService ChartGenerationService
@inject BirthDetailsCsvService CsvService
@inject JkdInterchangeService JkdService
@inject IPlaceResolver PlaceResolver
@inject DatabaseMaintenanceService DbMaintenanceService
@inject AyanamsaRuleRepository AyanamsaRules
@inject Microsoft.JSInterop.IJSRuntime JS
@inject ActivePerson Active
@inject LifeMatterReferenceRepository LifeMatterReferenceRepo
@inject FamilyRepository FamilyRepo
@inject Ikiastrro.Data.Statistics.AnalyticsSubjectRepository AnalyticsSubjectRepo

<PageTitle>Saved Charts — ikiastrro</PageTitle>

<div class="sp-layout">
    <aside class="sp-art" aria-hidden="true">
        <img class="sp-art-light" src="/images/ganesha-9planet-brand.png" alt="" />
        <img class="sp-art-dark" src="/images/ganesha-9planet-dark.png" alt="" />
    </aside>

    <div class="sp-content">
        <div class="sp-header">
            <div>
                <h1>SAVED CHARTS</h1>
            </div>
            <div class="sp-toolbar">
                <div class="sp-menu">
                    <button type="button" class="sp-menu-btn" @onclick="@(() => ToggleMenu("settings"))">Settings <span class="sp-caret">▾</span></button>
                    @if (_openMenu == "settings")
                    {
                        <div class="sp-menu-panel">
                            <button type="button" class="sp-menu-item" @onclick="@(() => ToggleMenu("preferences"))">PREFERENCES</button>
                            <button type="button" class="sp-menu-item" @onclick="@(() => ToggleMenu("export"))">EXPORT</button>
                            <button type="button" class="sp-menu-item" @onclick="@(() => ToggleMenu("import"))">IMPORT</button>
                            <button type="button" class="sp-menu-item" disabled="@AnyBusy" @onclick="@(() => { _openMenu = null; _pendingDbReset = true; })">RESET DB</button>
                            <button type="button" class="sp-menu-item" disabled="@AnyBusy" @onclick="@(() => { _openMenu = null; _pendingRecalculate = true; })">RECALCULATE</button>
                        </div>
                    }
                    @if (_openMenu == "preferences")
                    {
                        <div class="sp-menu-panel sp-menu-panel-wide">
                            <div class="sp-prefs-body">
                                @* Fixed, not a choice (decisions/004-ayanamsa-traditional-lahiri.md): every chart
                                   is generated with tbl_Rule_Ayanamsa's one default. *@
                                <p class="sp-prefs-fixed"><span>Ayanāṁśa</span> @_ayanamsaName <em>fixed for every chart</em></p>
                                <MudSelect T="string" Label="Color Theme" Value="_colorTheme"
                                           ValueChanged="OnColorThemeChanged" Dense="true" Variant="Variant.Outlined">
                                    <MudSelectItem T="string" Value="@("default-light")">Default Light</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("nebula-light")">Nebula-Light</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("cosmic-light")">Cosmic Light</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("cosmic-dark")">Cosmic Dark</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("nebula-dark-7band")">Nebula Violet Dark (7BAND)</MudSelectItem>
                                </MudSelect>
                                <MudSelect T="string" Label="Choose Chart Type" Value="_chartStyle"
                                           ValueChanged="OnChartStyleChanged" Dense="true" Variant="Variant.Outlined">
                                    <MudSelectItem T="string" Value="@("south-indian")">South Indian — default</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("north-indian")" Disabled="true">North Indian — planned</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("west-indian")" Disabled="true">West Indian — planned</MudSelectItem>
                                </MudSelect>
                            </div>
                        </div>
                    }
                    @if (_openMenu == "export")
                    {
                        <div class="sp-menu-panel">
                            <a class="sp-menu-item" href="/export/people.csv" @onclick="@(() => _openMenu = null)">All people as CSV</a>
                            <a class="sp-menu-item" href="/export/people.jkd" @onclick="@(() => _openMenu = null)">As .JKD</a>
                        </div>
                    }
                    @if (_openMenu == "import")
                    {
                        <div class="sp-menu-panel">
                            <label for="sp-csv-input" class="sp-menu-item" @onclick="@(() => _openMenu = null)">From CSV file…</label>
                            <label for="sp-jkd-input" class="sp-menu-item" @onclick="@(() => _openMenu = null)">From Horoscope Explorer (.JKD)…</label>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (_openMenu is not null)
        {
            <div class="sp-menu-backdrop" @onclick="@(() => _openMenu = null)"></div>
        }

        @* Hidden native file inputs — the two Import menu items are <label for="..."> so clicking them
           opens the browser's file picker with no JS interop needed. Wrapped in a literal div (rather
           than relying on ::deep alone) because Blazor CSS isolation never stamps the scope attribute
           on/around a child *component*'s own root — InputFile has no ancestor to carry it otherwise,
           so the hiding rule would have nothing scoped to match against. *@
        <div class="sp-hidden-inputs">
            <InputFile id="sp-csv-input" OnChange="HandleCsvSelected" accept=".csv,.vedicdb" />
            <InputFile id="sp-jkd-input" OnChange="HandleJkdSelected" accept=".jkd,.JKD" />
        </div>

        @if (_isBuilding)
        {
            <div class="sp-progress" role="progressbar" aria-valuemin="0" aria-valuemax="@_buildTotal" aria-valuenow="@_buildDone">
                <div class="sp-progress-bar" style="width:@(_buildTotal == 0 ? 0 : _buildDone * 100 / _buildTotal)%"></div>
            </div>
            <p class="sp-progress-label">Building @_buildDone / @_buildTotal…</p>
        }

        @if (_importStatus is not null)
        {
            <p class="sp-import-status">@_importStatus</p>
        }

        <PairModeTabs @bind-Mode="_mode" />
        <label class="sp-namefilter">
            <span>Name</span>
            <input type="search" placeholder="Search saved people…" @bind="_nameFilter" @bind:event="oninput" />
        </label>

        <div class="sp-subrow">
            <p class="sp-count">@_rows.Count saved chart@(_rows.Count == 1 ? "" : "s")</p>
            @if (MissingCount > 0)
            {
                <button type="button" class="sp-build-btn" @onclick="BuildMissing" disabled="@AnyBusy">
                    @(_isBuilding ? "Building…" : $"Build missing ({MissingCount})")
                </button>
            }
        </div>

        @if (_rows.Count == 0)
        {
            <p class="muted">No people saved yet.</p>
        }
        else
        {
            @if (_mode == PairMode.Individual)
            {
                <div class="saved-charts-table"><DataTable TRow="Row" Rows="FilteredRows" InitialSortHeader="Name" Columns="Cols" /></div>
            }
            else
            {
                <FamilyPairsTable Mode="_mode" Filter="@_nameFilter" />
            }
        }

        <ConfirmDialog IsOpen="@(_pendingDelete is not null)"
                       Message="@($"Delete {_pendingDelete?.Person.Name}'s chart and all computed data? This can't be undone.")"
                       IsBusy="_isDeleting" OnConfirm="HandleDelete" OnCancel="() => _pendingDelete = null" />

        <ConfirmDialog IsOpen="_pendingDbReset"
                       Message="Permanently delete ALL saved people and every generated chart on this server. This can't be undone."
                       ConfirmLabel="Reset Database" BusyLabel="Resetting…"
                       IsBusy="_isResettingDb" OnConfirm="HandleDbReset" OnCancel="() => _pendingDbReset = false" />

        <ConfirmDialog IsOpen="_pendingRecalculate"
                       Message="Force-recalculate every saved person's charts and Dasha, even ones already built. Existing results are overwritten."
                       ConfirmLabel="Recalculate All" BusyLabel="Recalculating…"
                       IsBusy="_isRecalculating" OnConfirm="HandleRecalculate" OnCancel="() => _pendingRecalculate = false" />

@if (_pendingPrint is not null)
{
    <PrintModuleDialog PersonName="@_pendingPrint.Person.Name" KeyInference="_keyInferenceModules"
                       Compatibility="_compatibilityModules" OnPrint="OpenPrint" OnCancel="() => _pendingPrint = null" />
}

@if (_edit is not null)
{
    <div class="edit-backdrop" @onclick="CancelEdit">
        <div class="edit-box" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <h2 class="edit-title">Edit @_editOriginalName</h2>

            <label class="edit-field ef-center">
                <span>Name</span>
                <input type="text" @bind="_edit.Name" @bind:event="oninput" />
            </label>

            <div class="edit-field">
                <span>Sex</span>
                <div class="edit-radio">
                    <label><input type="radio" name="sex" value="Male"
                                  checked="@(_edit.Sex == "Male")" @onchange="@(() => _edit.Sex = "Male")" /> Male</label>
                    <label><input type="radio" name="sex" value="Female"
                                  checked="@(_edit.Sex == "Female")" @onchange="@(() => _edit.Sex = "Female")" /> Female</label>
                </div>
            </div>

            <div class="edit-birth">
                <p class="edit-note">Changing any field below rebuilds every chart for this person.</p>
                <label class="edit-field ef-center">
                    <span>Date of Birth</span>
                    <input type="date" @bind="_edit.Dob" />
                </label>
                <label class="edit-field ef-center">
                    <span>Time of Birth</span>
                    <input type="time" step="1" @bind="_edit.Tob" />
                </label>
                <label class="edit-field ef-center">
                    <span>City</span>
                    <input type="text" @bind="_edit.City" />
                </label>
                <label class="edit-field ef-center">
                    <span>Country</span>
                    <input type="text" @bind="_edit.Country" />
                </label>
            </div>

            @if (_editError is not null)
            {
                <p class="edit-error" role="alert">@_editError</p>
            }

            <div class="edit-actions">
                <button type="button" class="btn-cancel" @onclick="CancelEdit" disabled="@_isSaving">Cancel</button>
                <button type="button" class="btn-confirm" @onclick="SaveEdit" disabled="@_isSaving">
                    @(_isSaving ? (_regenerating ? "Rebuilding charts…" : "Saving…") : "Save")
                </button>
            </div>
        </div>
    </div>
}

@if (_researchEdit is not null)
{
    <div class="edit-backdrop" @onclick="CancelResearchEdit">
        <div class="edit-box research-box" role="dialog" aria-modal="true"
             aria-labelledby="research-title" @onclick:stopPropagation="true">
            <h2 class="edit-title" id="research-title">Statistical use · @_researchName</h2>
            <p class="edit-note">Saving a chart does not grant research permission. Only mark a
                person eligible when their explicit permission has been recorded.</p>

            <label class="edit-field">
                <span>Research status</span>
                <select @bind="_researchEdit.ResearchUseStatus">
                    <option value="PENDING">Pending — not included</option>
                    <option value="ELIGIBLE">Eligible — include in future datasets</option>
                    <option value="EXCLUDED">Excluded</option>
                    <option value="WITHDRAWN">Withdrawn</option>
                </select>
            </label>
            <label class="edit-field">
                <span>Record classification</span>
                <select @bind="_researchEdit.SubjectClassification">
                    <option value="PERSONAL">Personal</option>
                    <option value="RESEARCH">Research participant</option>
                    <option value="TEST">Test fixture</option>
                    <option value="DEMO">Demonstration</option>
                    <option value="SYNTHETIC">Synthetic</option>
                </select>
            </label>
            <label class="edit-field">
                <span>Birth-time quality</span>
                <select @bind="_researchEdit.BirthTimeQuality">
                    <option value="UNKNOWN">Unknown</option>
                    <option value="APPROXIMATE">Approximate</option>
                    <option value="RECORDED">Recorded</option>
                    <option value="RECTIFIED">Rectified</option>
                </select>
            </label>
            @if (_researchEdit.ResearchUseStatus == "ELIGIBLE")
            {
                <label class="research-confirm">
                    <input type="checkbox" @bind="_researchEdit.ExplicitPermissionConfirmed" />
                    I confirm that explicit permission for statistical use has been recorded.
                </label>
            }
            @if (_researchError is not null)
            {
                <p class="edit-error" role="alert">@_researchError</p>
            }
            <div class="edit-actions">
                <button type="button" class="btn-cancel" @onclick="CancelResearchEdit">Cancel</button>
                <button type="button" class="btn-confirm" @onclick="SaveResearchEdit">Save status</button>
            </div>
        </div>
    </div>
}

        @if (_error is not null)
        {
            <p class="saved-charts-error" role="alert">@_error</p>
        }
    </div>
</div>

@code {
    private const int BuildBatchCap = 25;   // per press; the button re-shows for the rest if more remain (decisions/002)
    private const string BuiltChartType = "D1";

    private record Row(BirthDetails Person, bool IsBuilt, string Lagna,
        IReadOnlyDictionary<string, IReadOnlyList<string>> Glyphs,
        Ikiastrro.Data.Statistics.AnalyticsSubjectRecord? AnalyticsSubject);

    private readonly List<Row> _rows = new();
    private PairMode _mode = PairMode.Individual;
    private string _nameFilter = string.Empty;
    private IReadOnlyList<Row> FilteredRows => string.IsNullOrWhiteSpace(_nameFilter)
        ? _rows
        : _rows.Where(r => PersonName.Matches(r.Person.Name, _nameFilter)).ToList();
    private Row? _pendingDelete;
    private bool _isDeleting;
    private string? _error;
    private string? _openMenu;   // "settings" | "preferences" | "import" | "export" | null

    // --- Preferences (moved here from Home.razor) — chart style is in-memory for this session only.
    // The ayanamsa is shown, not chosen: it is locked (decisions/004). ---
    private string _chartStyle = "south-indian";
    private string _colorTheme = "default-light";
    private string _ayanamsaName = AyanamsaDefinition.Default.DisplayName;

    // --- import/build state ---
    private string? _importStatus;
    private bool _isBuilding;
    private int _buildDone;
    private int _buildTotal;
    private int MissingCount => _rows.Count(r => !r.IsBuilt);

    // --- DB RESET / RECALCULATE state ---
    private bool _pendingDbReset;
    private bool _isResettingDb;
    private bool _pendingRecalculate;
    private bool _isRecalculating;
    private bool AnyBusy => _isBuilding || _isDeleting || _isSaving || _isResettingDb || _isRecalculating;

    // --- edit state ---
    private EditForm? _edit;
    private int _editId;
    private string _editOriginalName = "";
    private BirthDetails? _editOriginal;
    private string? _editError;
    private bool _isSaving;
    private bool _regenerating;

    private IReadOnlyList<DataTable<Row>.Column> Cols => new[]
    {
        new DataTable<Row>.Column("Name", r => r.Person.Name, r => @<a href="@($"/astro-facts/{r.Person.Id}")">@r.Person.Name</a>),
        new DataTable<Row>.Column("Sex", r => r.Person.Sex ?? "", r => @<text>@r.Person.Sex</text>),
        new DataTable<Row>.Column("Name No.", r => r.Person.NameNumberRoot ?? 0, r => r.Person.NameNumberRoot is null
            ? @<text>—</text>
            : @<text>@r.Person.NameNumberCompound/@r.Person.NameNumberRoot</text>),
        new DataTable<Row>.Column("Date of Birth", r => r.Person.DateOfBirth, r => @<text>@r.Person.DateOfBirth.ToString("d MMM yyyy")</text>),
        new DataTable<Row>.Column("Time of Birth", r => r.Person.TimeOfBirth, r => @<text>@r.Person.TimeOfBirth.ToString("HH:mm")</text>),
        new DataTable<Row>.Column("Place", r => r.Person.PlaceCity, r => @<text>@r.Person.PlaceCity, @r.Person.PlaceCountry</text>),
        new DataTable<Row>.Column("Status", r => r.IsBuilt, r => r.IsBuilt
            ? @<span class="sp-built sp-built-yes"><span class="sp-dot"></span>Built</span>
            : @<span class="sp-built sp-built-no"><span class="sp-dot"></span>Not built</span>),
        new DataTable<Row>.Column("", _ => 0, r => @<div class="row-actions">
            <EditIconButton Title="@($"Edit {r.Person.Name}")" OnClick="() => StartEdit(r)" />
            <DeleteIconButton Title="@($"Delete {r.Person.Name}")" OnClick="() => _pendingDelete = r" />
            <PrintIconButton Title="@($"Print {r.Person.Name}'s charts")" OnClick="() => PrintPerson(r)" />
        </div>),
    };

    protected override void OnInitialized()
    {
        // Like Home, this is a person-list page, not a per-person one — clear whatever the
        // previously-open person left behind (name/tabs in the app bar, Astro Facts's master
        // step rail in the band) so navigating here from a person's page doesn't leave stale
        // header state behind (rammyps, 2026-09-25 bug report).
        Active.Clear();
        Load();
        try { _ayanamsaName = AyanamsaRules.GetActiveDefault().DisplayName; }
        catch (InvalidOperationException ex) { _ayanamsaName = ex.Message; }   // a non-Lahiri default is refused
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _colorTheme = await JS.InvokeAsync<string>("ikiastrroTheme.get");
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnColorThemeChanged(string value)
    {
        _colorTheme = value;
        _openMenu = null;
        await JS.InvokeVoidAsync("ikiastrroTheme.setAndReload", value);
    }

    // Selecting a preference applies it and collapses the panel.
    private void OnChartStyleChanged(string value) { _chartStyle = value; _openMenu = null; }

    private void Load()
    {
        _rows.Clear();
        var built = ChartResultsRepo.GetBirthDetailIdsWithChartType(BuiltChartType);
        var analyticsSubjects = AnalyticsSubjectRepo.GetAll();
        foreach (var p in BirthDetailsRepo.GetAll())
        {
            var d1 = ChartResultsRepo.GetByBirthDetailId(p.Id).FirstOrDefault(r => r.ChartType == "D1");
            var kd = d1 is null ? Array.Empty<ChartKeyDetail>() : ChartKeyDetailsRepo.GetByChartResultId(d1.Id);
            var lagna = kd.FirstOrDefault(k => k.Planet == "Ascendant")?.Sign ?? "";
            var glyphs = kd.Where(k => k.PointKind == "Graha" && k.Planet != "Ascendant")
                .GroupBy(k => k.Sign)
                .ToDictionary(g => g.Key, g => (IReadOnlyList<string>)g.Select(k => k.Planet).ToList());
            _rows.Add(new Row(p, built.Contains(p.Id), lagna, glyphs,
                analyticsSubjects.GetValueOrDefault(p.Id)));
        }
    }

    private ResearchForm? _researchEdit;
    private string _researchName = "";
    private string? _researchError;

    private void StartResearchEdit(Row row)
    {
        _researchName = row.Person.Name;
        _researchError = null;
        _researchEdit = new ResearchForm
        {
            BirthDetailId = row.Person.Id,
            ResearchUseStatus = row.AnalyticsSubject?.ResearchUseStatus ?? "PENDING",
            SubjectClassification = row.AnalyticsSubject?.SubjectClassification ?? "PERSONAL",
            BirthTimeQuality = row.AnalyticsSubject?.BirthTimeQuality ?? "UNKNOWN"
        };
    }

    private void CancelResearchEdit() => _researchEdit = null;

    private void SaveResearchEdit()
    {
        if (_researchEdit is null) return;
        try
        {
            AnalyticsSubjectRepo.Save(new(
                _researchEdit.BirthDetailId,
                _researchEdit.ResearchUseStatus,
                _researchEdit.SubjectClassification,
                _researchEdit.BirthTimeQuality,
                _researchEdit.ExplicitPermissionConfirmed));
            _researchEdit = null;
            Load();
        }
        catch (ArgumentException ex)
        {
            _researchError = ex.Message;
        }
    }

    private sealed class ResearchForm
    {
        public int BirthDetailId { get; set; }
        public string ResearchUseStatus { get; set; } = "PENDING";
        public string SubjectClassification { get; set; } = "PERSONAL";
        public string BirthTimeQuality { get; set; } = "UNKNOWN";
        public bool ExplicitPermissionConfirmed { get; set; }
    }

    private void ToggleMenu(string menu) => _openMenu = _openMenu == menu ? null : menu;

    // --- print ---
    private Row? _pendingPrint;
    private IReadOnlyList<PrintModule> _keyInferenceModules = [];
    private IReadOnlyList<PrintModule> _compatibilityModules = [];

    /// <summary>Print opens the module picker (PrintModuleDialog) rather than printing straight
    /// away (rammyps, 2026-10-02): the report holds any Astro Facts tabs and Key Inference
    /// modules, all ticked by default. Key Inference's life areas are read when it opens.</summary>
    private void PrintPerson(Row r)
    {
        _keyInferenceModules =
        PrintModules.KeyInference(LifeMatterReferenceRepo.GetCategories(1));
        // Compatibility: the person's recorded spouse(s), ticked by default.
        _compatibilityModules = FamilyRepo.GetFor(r.Person.Id)
            .Where(f => f.Role is "Wife" or "Husband")
            .Select(f => PrintModules.Partner(f.RelativeId, $"With {f.RelativeName} ({f.Role.ToLowerInvariant()})"))
            .ToList();
        _pendingPrint = r;
    }

    /// <summary>The report opens in a new tab and prints itself once rendered (PrintReport.razor).</summary>
    private async Task OpenPrint((IReadOnlyList<string> AstroFacts, IReadOnlyList<string> KeyInference, IReadOnlyList<string> Compatibility) picked)
    {
        var id = _pendingPrint!.Person.Id;
        _pendingPrint = null;
        await JS.InvokeVoidAsync("open", PrintModules.Url(id, picked.AstroFacts, picked.KeyInference, picked.Compatibility), "_blank");
    }

    private async Task HandleCsvSelected(InputFileChangeEventArgs e)
    {
        _error = null;
        _importStatus = null;
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var result = await CsvService.ImportAsync(stream);
            _importStatus = $"CSV: imported {result.Added}, skipped {result.Skipped} existing name(s)."
                + (result.Errors.Count > 0 ? $" {result.Errors.Count} row error(s) — {string.Join(" | ", result.Errors.Take(5))}" : "");
            Load();
        }
        catch (Exception ex)
        {
            _error = $"CSV import failed: {ex.Message}";
        }
    }

    private async Task HandleJkdSelected(InputFileChangeEventArgs e)
    {
        _error = null;
        _importStatus = null;
        var tempPath = Path.Combine(Path.GetTempPath(), $"ikiastrro-import-{Guid.NewGuid():N}.JKD");
        try
        {
            await using (var input = e.File.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024))
            await using (var output = File.Create(tempPath))
                await input.CopyToAsync(output);

            var result = await JkdService.ImportAsync(tempPath);
            _importStatus = $".JKD: imported {result.Added}, skipped {result.Skipped} existing name(s).";
            Load();
        }
        catch (Exception ex)
        {
            _error = $".JKD import failed: {ex.Message}";
        }
        finally
        {
            if (File.Exists(tempPath)) File.Delete(tempPath);
        }
    }

    /// <summary>Foreground loop, capped per press — Phase 2 (a hosted BackgroundService + SignalR
    /// progress) is deferred until this proves routine (decisions/002).</summary>
    private async Task BuildMissing()
    {
        var toBuild = _rows.Where(r => !r.IsBuilt).Take(BuildBatchCap).ToList();
        if (toBuild.Count == 0) return;

        _error = null;
        _isBuilding = true;
        _buildDone = 0;
        _buildTotal = toBuild.Count;
        StateHasChanged();

        foreach (var row in toBuild)
        {
            try
            {
                ChartGenerationService.GenerateAll(row.Person);
            }
            catch (Exception ex)
            {
                _error = $"Could not build {row.Person.Name}: {ex.Message}";
            }
            _buildDone++;
            StateHasChanged();
            await Task.Yield();   // let the progress bar actually reach the browser between builds
        }

        _isBuilding = false;
        Load();
    }

    private void HandleDelete()
    {
        if (_pendingDelete is null) return;
        _isDeleting = true;
        _error = null;
        var name = _pendingDelete.Person.Name;
        try
        {
            DeletionService.DeleteBirthDetail(_pendingDelete.Person.Id);
            _pendingDelete = null;
            Load();
        }
        catch (Exception ex)
        {
            // A delete that throws must not take the whole Blazor circuit down with it.
            _error = $"Could not delete {name}: {ex.Message}";
        }
        finally
        {
            _isDeleting = false;
        }
    }

    /// <summary>Shells to db/checks/Reset-AllTransactionalData.ps1 (DatabaseMaintenanceService) —
    /// full wipe, including every saved person.</summary>
    private async Task HandleDbReset()
    {
        _isResettingDb = true;
        _error = null;
        try
        {
            // Safety copy first: if it can't be written the reset is aborted (caught below).
            var backup = CsvService.ExportToDefaultFolder("pre-reset");
            await DbMaintenanceService.ResetAllDataAsync();
            _pendingDbReset = false;
            if (backup is not null) _importStatus = $"Saved people backed up to {backup} before the reset.";
            Load();
        }
        catch (Exception ex)
        {
            _error = $"Database reset failed: {ex.Message}";
        }
        finally
        {
            _isResettingDb = false;
        }
    }

    /// <summary>Shells to db/checks/Rebuild-AllGeneratedData.ps1 (DatabaseMaintenanceService) —
    /// force-regenerates every saved person's charts + Dasha via `dotnet run -- rebuild-all`,
    /// even people already marked Built.</summary>
    private async Task HandleRecalculate()
    {
        _isRecalculating = true;
        _error = null;
        try
        {
            await DbMaintenanceService.RecalculateAllChartsAsync();
            _pendingRecalculate = false;
            Load();
        }
        catch (Exception ex)
        {
            _error = $"Recalculate failed: {ex.Message}";
        }
        finally
        {
            _isRecalculating = false;
        }
    }

    private void StartEdit(Row r)
    {
        var p = r.Person;
        _editId = p.Id;
        _editOriginal = p;
        _editOriginalName = p.Name;
        _editError = null;
        _edit = new EditForm
        {
            Name = p.Name,
            Sex = p.Sex ?? "",
            Dob = p.DateOfBirth,
            Tob = p.TimeOfBirth,
            City = p.PlaceCity,
            Country = p.PlaceCountry,
        };
    }

    private void CancelEdit()
    {
        if (_isSaving) return;
        _edit = null;
        _editError = null;
    }

    private async Task SaveEdit()
    {
        if (_edit is null || _editOriginal is null || _isSaving) return;
        _editError = null;

        if (string.IsNullOrWhiteSpace(_edit.Name) || string.IsNullOrWhiteSpace(_edit.Sex)
            || string.IsNullOrWhiteSpace(_edit.City) || string.IsNullOrWhiteSpace(_edit.Country))
        {
            _editError = "Name, sex, city and country can't be blank.";
            return;
        }

        var dob = _edit.Dob;
        var tob = _edit.Tob;
        var birthChanged =
            dob != _editOriginal.DateOfBirth || tob != _editOriginal.TimeOfBirth
            || !string.Equals(_edit.City.Trim(), _editOriginal.PlaceCity, StringComparison.OrdinalIgnoreCase)
            || !string.Equals(_edit.Country.Trim(), _editOriginal.PlaceCountry, StringComparison.OrdinalIgnoreCase);

        _isSaving = true;
        _regenerating = birthChanged;
        try
        {
            var updated = new BirthDetails
            {
                Id = _editId,
                Name = _edit.Name.Trim(),
                Sex = _edit.Sex,
                DateOfBirth = dob,
                TimeOfBirth = tob,
                PlaceCity = _edit.City.Trim(),
                PlaceCountry = _edit.Country.Trim(),
                Latitude = _editOriginal.Latitude,
                Longitude = _editOriginal.Longitude,
                UtcOffset = _editOriginal.UtcOffset,
                IanaTimeZoneId = _editOriginal.IanaTimeZoneId,
                CreatedAt = _editOriginal.CreatedAt,
            };

            if (birthChanged)
            {
                var place = await PlaceResolver.ResolveAsync(updated.PlaceCity, updated.PlaceCountry, dob);
                updated.Latitude = place.Latitude;
                updated.Longitude = place.Longitude;
                updated.UtcOffset = place.UtcOffset.ToString();
                updated.IanaTimeZoneId = place.IanaTimeZoneId;
            }

            BirthDetailsRepo.Update(updated);

            if (birthChanged)
                ChartGenerationService.GenerateAll(updated);   // delete-first-then-regenerate

            _edit = null;
            Load();
        }
        catch (Exception ex)
        {
            _editError = $"Could not save: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
            _regenerating = false;
        }
    }

    private sealed class EditForm
    {
        public string Name { get; set; } = "";
        public string Sex { get; set; } = "";
        public DateOnly Dob { get; set; }
        public TimeOnly Tob { get; set; }
        public string City { get; set; } = "";
        public string Country { get; set; } = "";
    }
}
