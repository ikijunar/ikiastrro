@page "/"
@inject BirthDetailsRepository BirthDetailsRepo
@inject NavigationManager Nav

<PageTitle>ikiastrro</PageTitle>

<h1>ikiastrro</h1>
<p>Pick a saved person to open their charts, or add someone new.</p>

@if (_people.Count == 0)
{
    <p class="muted">No charts saved yet — add your first person.</p>
}
else
{
    <input class="home-search" type="search" placeholder="Filter by name…" @bind="_filter" @bind:event="oninput" />
    <div class="home-rows">
        @foreach (var person in Filtered())
        {
            <a class="home-row" href="@($"/charts/{person.Id}")">
                <span class="home-meta">
                    <b>@person.Name</b>
                    <span>@person.DateOfBirth.ToString("d MMM yyyy") · @person.EffectiveTimeOfBirth.ToString("h:mm tt")</span>
                    <span>@person.PlaceCity, @person.PlaceCountry</span>
                </span>
            </a>
        }
    </div>
}

<button class="btn-add" type="button" @onclick='() => Nav.NavigateTo("/add")'>＋ Add someone</button>

@code {
    // No chart thumbnail in this list any more (2026-09-05, rammyps's call: "no need to have the
    // chart component to the left of the Name") — so this page no longer needs a D1 lookup per
    // person, just BirthDetailsRepo.GetAll(). ChartResultsRepo/ChartKeyDetailsRepo (only ever used
    // to build that thumbnail) are dropped along with it.
    private List<BirthDetails> _people = new();
    private string _filter = "";

    protected override void OnInitialized() => _people = BirthDetailsRepo.GetAll().ToList();

    private IEnumerable<BirthDetails> Filtered() => string.IsNullOrWhiteSpace(_filter)
        ? _people
        : _people.Where(p => p.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase));
}
