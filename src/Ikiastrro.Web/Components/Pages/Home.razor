@page "/"
@using Ikiastrro.Core.Engines.Astronomy
@inject BirthDetailsRepository BirthDetailsRepo
@inject ChartGenerationService ChartGenerationService
@inject IPlaceResolver PlaceResolver
@inject NavigationManager Nav
@inject AyanamsaRuleRepository AyanamsaRules

<PageTitle>Iki-Astrro · Discover Your Path</PageTitle>

<div class="home">
    <div class="home-main">

        <div class="home-prefs">
            <MudButton Variant="Variant.Text" DisableElevation="true" Class="home-prefs-toggle"
                       StartIcon="@(_prefsOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.Tune)"
                       OnClick="@(() => _prefsOpen = !_prefsOpen)">
                Preferences
            </MudButton>
            <MudCollapse Expanded="_prefsOpen">
                <div class="home-prefs-body">
                    <MudSelect T="string" Label="Choose Ayanāṁśa" @bind-Value="_ayanamsaCode"
                               Dense="true" Variant="Variant.Outlined">
                        @foreach (var a in AyanamsaDefinition.Catalog)
                        {
                            <MudSelectItem T="string" Value="@a.Code">@AyanamsaLabel(a)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="string" Label="Choose Chart Type" @bind-Value="_chartStyle"
                               Dense="true" Variant="Variant.Outlined">
                        <MudSelectItem T="string" Value="@("south-indian")">South Indian — default</MudSelectItem>
                        <MudSelectItem T="string" Value="@("north-indian")">North Indian</MudSelectItem>
                    </MudSelect>
                </div>
            </MudCollapse>
        </div>

        <h1 class="home-title">Discover Your Path</h1>

        <MudAutocomplete T="string" Label="Name" Placeholder="Search saved people…"
                         SearchFunc="SearchNames" Value="_search" ValueChanged="OnNamePicked"
                         Variant="Variant.Outlined" Dense="true" Strict="false" Clearable="true"
                         ResetValueOnEmptyText="true" Class="home-name" />

        @if (_adding)
        {
            <div class="home-form">
                <MudText Class="home-form-caption">New person</MudText>
                <MudTextField T="string" Label="Name" @bind-Value="_f.Name" Variant="Variant.Outlined" Dense="true" />
                <MudSelect T="string" Label="Sex" @bind-Value="_f.Sex" Variant="Variant.Outlined" Dense="true">
                    <MudSelectItem T="string" Value="@("Male")">Male</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Female")">Female</MudSelectItem>
                </MudSelect>
                <MudDatePicker Label="Date of Birth" @bind-Date="_f.Dob" Variant="Variant.Outlined" />
                <MudTimePicker Label="Time of Birth" @bind-Time="_f.Tob" Variant="Variant.Outlined" />
                <MudTextField T="string" Label="City" @bind-Value="_f.City" Variant="Variant.Outlined" Dense="true" />
                <MudTextField T="string" Label="Country" @bind-Value="_f.Country" Variant="Variant.Outlined" Dense="true"
                              OnBlur="@(() => TryGenerate(showErrors: false))" />

                @if (_error is not null)
                {
                    <MudText Class="home-form-error">@_error</MudText>
                }

                <div class="home-form-actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="@(() => TryGenerate(showErrors: true))" Disabled="_busy">
                        @(_busy ? "Generating…" : "Generate Chart")
                    </MudButton>
                    <MudButton Variant="Variant.Text" OnClick="CancelAdd">Cancel</MudButton>
                </div>
            </div>
        }
    </div>

    <aside class="home-art" aria-hidden="true">
        <img src="/images/ganesha-navagraha-brand.png" alt="" />
    </aside>
</div>

@code {
    private List<BirthDetails> _people = new();
    private bool _prefsOpen;
    private bool _adding;
    private bool _busy;
    private string? _error;

    // Preferences — in-memory for the first cut; localStorage / DB default is a follow-up.
    private string _ayanamsaCode = AyanamsaDefinition.Default.Code;
    private string _chartStyle = "south-indian";
    private AyanamsaDefinition _activeDefault = AyanamsaDefinition.Default;

    private readonly AddForm _f = new();
    private const string AddNewOption = "＋  Add New";
    private string? _search;      // bound value of the name-search box
    private string _lastQuery = string.Empty;  // last text typed into the search

    protected override void OnInitialized()
    {
        _people = BirthDetailsRepo.GetAll().ToList();
        try
        {
            _activeDefault = AyanamsaRules.GetActiveDefault();
            _ayanamsaCode = _activeDefault.Code;
        }
        catch { /* fall back to AyanamsaDefinition.Default */ }
    }

    private string AyanamsaLabel(AyanamsaDefinition a) =>
        a.Code == _activeDefault.Code ? $"{a.DisplayName} — default" : a.DisplayName;

    private Task<IEnumerable<string>> SearchNames(string? value, CancellationToken _)
    {
        _lastQuery = (value ?? string.Empty).Trim();
        var names = _people
            .Where(p => _lastQuery.Length == 0 || p.Name.Contains(_lastQuery, StringComparison.OrdinalIgnoreCase))
            .Select(p => p.Name)
            .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
            .ToList();
        names.Add(AddNewOption); // always the last selection
        return Task.FromResult<IEnumerable<string>>(names);
    }

    private void OnNamePicked(string? value)
    {
        if (value == AddNewOption)
        {
            _adding = true;
            _error = null;
            if (string.IsNullOrWhiteSpace(_f.Name) && !string.IsNullOrWhiteSpace(_lastQuery))
                _f.Name = _lastQuery;       // seed the new person's name from what was typed
            _search = null;                 // don't leave "＋ Add New" sitting in the box
            return;
        }

        _search = value;
        if (string.IsNullOrEmpty(value)) return;

        var person = _people.FirstOrDefault(p => string.Equals(p.Name, value, StringComparison.OrdinalIgnoreCase));
        if (person is not null) Nav.NavigateTo($"/charts/{person.Id}");
    }

    private void CancelAdd()
    {
        _adding = false;
        _error = null;
    }

    private async Task TryGenerate(bool showErrors)
    {
        if (_busy) return;
        _error = null;

        if (string.IsNullOrWhiteSpace(_f.Name) || _f.Dob is null || _f.Tob is null
            || string.IsNullOrWhiteSpace(_f.City) || string.IsNullOrWhiteSpace(_f.Country))
        {
            // Country can blur before the rest is filled — only nag on an explicit submit.
            if (showErrors) _error = "Fill in name, date, time, city and country.";
            return;
        }

        _busy = true;
        try
        {
            var dob = DateOnly.FromDateTime(_f.Dob.Value);
            var tob = TimeOnly.FromTimeSpan(_f.Tob.Value);
            var place = await PlaceResolver.ResolveAsync(_f.City!.Trim(), _f.Country!.Trim(), dob);

            var birth = new BirthDetails
            {
                Name = _f.Name!.Trim(),
                Sex = string.IsNullOrWhiteSpace(_f.Sex) ? null : _f.Sex,
                DateOfBirth = dob,
                TimeOfBirth = tob,
                PlaceCity = _f.City!.Trim(),
                PlaceCountry = _f.Country!.Trim(),
                Latitude = place.Latitude,
                Longitude = place.Longitude,
                UtcOffset = place.UtcOffset.ToString(),
                IanaTimeZoneId = place.IanaTimeZoneId,
            };

            BirthDetailsRepo.Insert(birth);
            ChartGenerationService.GenerateAll(birth, AyanamsaDefinition.FromCode(_ayanamsaCode));
            Nav.NavigateTo($"/transit-wheel/{birth.Id}");
        }
        catch (Exception ex)
        {
            _error = $"Could not generate the chart: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class AddForm
    {
        public string? Name { get; set; }
        public string Sex { get; set; } = string.Empty;
        public DateTime? Dob { get; set; }
        public TimeSpan? Tob { get; set; }
        public string? City { get; set; }
        public string? Country { get; set; }
    }
}
