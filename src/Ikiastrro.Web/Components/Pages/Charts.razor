@page "/charts"
@inject BirthDetailsRepository BirthDetailsRepo
@inject BirthDetailDeletionService DeletionService

<PageTitle>Saved Charts — ikiastrro</PageTitle>

<h1>Saved charts</h1>

@if (people.Count == 0)
{
    <p class="muted">No charts saved yet.</p>
}
else
{
    <div class="table-scroll">
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Date of Birth</th>
                    <th>Place</th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in people)
                {
                    <tr>
                        <td>@p.Name</td>
                        <td>@p.DateOfBirth.ToString("d MMM yyyy")</td>
                        <td>@p.PlaceCity, @p.PlaceCountry</td>
                        <td><a href="@($"/charts/{p.Id}")">View chart &rarr;</a></td>
                        <td>
                            <DeleteIconButton Title="@($"Delete {p.Name}")" OnClick="() => pendingDelete = p" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<ConfirmDialog IsOpen="@(pendingDelete is not null)"
               Message="@($"Delete {pendingDelete?.Name}'s chart and all computed data? This can't be undone.")"
               IsBusy="isDeleting"
               OnConfirm="HandleDelete"
               OnCancel="@(() => pendingDelete = null)" />

@code {
    private IReadOnlyList<BirthDetails> people = Array.Empty<BirthDetails>();
    private BirthDetails? pendingDelete;
    private bool isDeleting;

    protected override void OnInitialized()
    {
        people = BirthDetailsRepo.GetAll();
    }

    private void HandleDelete()
    {
        if (pendingDelete is null) return;
        isDeleting = true;
        DeletionService.DeleteBirthDetail(pendingDelete.Id);
        people = BirthDetailsRepo.GetAll();
        pendingDelete = null;
        isDeleting = false;
    }
}
