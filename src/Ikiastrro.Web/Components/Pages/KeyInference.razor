@page "/key-inference/{Id:int}"
@page "/life-matters/{Id:int}"
@* /life-matters is this page's old name (Life Matters, renamed Key Inference 2026-10-01), kept for bookmarks. *@
@using Ikiastrro.Core.Engines.Astronomy
@using Ikiastrro.Core.Engines.Dignity
@using Ikiastrro.Core.Engines.Houses
@using Ikiastrro.Core.Engines.PlanetaryStates
@using Ikiastrro.Core.LifeMatters.Activation
@using Ikiastrro.Core.LifeMatters
@using Ikiastrro.Core.Models
@using Ikiastrro.Core.Presentation
@using Ikiastrro.Web.Components.Charts
@using Ikiastrro.Web.Components.LifeMatters
@using Ikiastrro.Web.Components.Workspace
@inject BirthDetailsRepository BirthDetailsRepo
@inject ChartResultsRepository ChartResultsRepo
@inject ChartKeyDetailsRepository ChartKeyDetailsRepo
@inject ChartHouseLordsRepository ChartHouseLordsRepo
@inject ChartHouseLordInterpretationRepository ChartHouseLordInterpretationRepo
@inject ChartAspectsRepository ChartAspectsRepo
@inject ChartConjunctionsRepository ChartConjunctionsRepo
@inject ChartMultiGrahaConjunctionRepository ChartMultiGrahaConjunctionRepo
@inject ChartTypeRepository ChartTypeRepo
@inject LifeMatterReferenceRepository LifeMatterReferenceRepo
@inject LifeMatterFocusRepository LifeMatterFocusRepo
@inject KarakaMatterRepository KarakaMatterRepo
@inject PlanetaryStateRepository PlanetaryStateRepo
@inject PlanetaryStateRuleRepository PlanetaryStateRuleRepo
@inject PostureStateInterpretationRepository PostureStateInterpretationRepo
@inject PlanetaryStrengthRepository PlanetaryStrengthRepo
@inject BhavaStrengthRepository BhavaStrengthRepo
@inject AshtakavargaRepository AshtakavargaRepo
@inject AmsabalaRepository AmsabalaRepo
@inject ArgalaFactRepository ArgalaFactRepo
@inject Ikiastrro.Data.Statistics.LifeMatterTimingDataService LifeMatterTiming
@inject Ikiastrro.Data.Statistics.PopulationEvidenceRepository PopulationEvidenceRepo
@inject InterpretationRepository InterpretationRepo
@inject ActivePerson Active
@inject NavigationManager Nav
@inject IJSRuntime JS


@* docs/ui/components/specs_key_inference_page.md "Customer flow". Three levels: EXPLORE (area →
   question), UNDERSTAND (one answer card: the selected question's support, D1 foundation vs the
   matter's own chart, strongest and limiting factors) and INVESTIGATE (the chart, perspectives,
   the lagna × chart matrix, Argala, planet strength and provenance as expandable sections).
   A matter opens in its own varga (PrimaryChartsText / divisional subject), read from the chosen
   lagna; D1 is the promise, the varga the confirmation. LifeMatterStatistics supplies every
   figure; LifeMatterReading only puts them into words. *@

@if (PrintModules is null)
{
    <PageTitle>@(_data?.Person.Name ?? "Key Inference") · Key Inference</PageTitle>
}

@if (_data is null)
{
    <section class="lm-unavailable" role="status">
        <h1 class="lm-heading">KEY INFERENCE</h1>
        <p>No saved charts found for that person.</p>
        <a href="/">Choose a saved person</a>
    </section>
}
else if (PrintModules is { } print)
{
    @* Print report (PrintReport.razor): the foundation and each chosen life area as a static table —
       every question in the area read from Lagna in its own chart, against the main birth chart. *@
    @if (print.Contains(Ikiastrro.Web.Components.Shared.PrintModules.Foundation))
    {
        <section class="pr-ki-sec">
            <h2 class="pr-modhead"><span>Key Inference</span>Foundation</h2>
            <table class="lm-table pr-ki-table">
                <thead><tr><th>Factor</th><th>Value</th><th>Detail</th></tr></thead>
                <tbody>
                    @foreach (var f in _foundation)
                    {
                        <tr class="@(f.Tone is null ? null : $"is-{f.Tone}")"><th scope="row">@f.Label</th><td><b>@f.Value</b></td><td>@f.Detail</td></tr>
                    }
                </tbody>
            </table>
        </section>
    }
    @foreach (var area in _categories.Where(c => print.Contains(c.CategoryCode)))
    {
        var areaPct = AreaStats(area.CategoryCode).StrengthPercent;
        var core = CoreHouses(area.CategoryCode);
        <section class="pr-ki-sec">
            <h2 class="pr-modhead"><span>Key Inference</span>@LifeMatterQuestions.AreaLabel(area.CategoryCode, area.CategoryName)</h2>
            <p class="pr-ki-area">Area overview @Pct(areaPct, "Area overview") <b>@LifeMatterReading.Band(areaPct).Label</b> —
                the @string.Join(" & ", core.Select(Ordinal)) house@(core.Count > 1 ? "s" : "") of the main birth chart. Each question is read from Lagna.</p>
            <table class="lm-table pr-ki-table">
                <thead>
                    <tr><th>Question</th><th>Chart</th><th class="num">Main chart<br />D1</th><th class="num">Own<br />chart</th><th>Support</th><th>Strongest factors</th><th>Limiting or uncertain</th></tr>
                </thead>
                <tbody>
                    @foreach (var s in StepsIn(area.CategoryCode))
                    {
                        var home = HomeChart(s);
                        var d1Read = Read(s, "LAGNA", "D1");
                        var homeRead = home == "D1" ? d1Read : Read(s, "LAGNA", home);
                        var pct = ReadPercent(homeRead);
                        var factors = LifeMatterReading.Factors(homeRead?.Items.Select(i => i.Stats).ToList() ?? [], home);
                        <tr>
                            <th scope="row">@s.MatterText</th>
                            <td title="@ChartName(home)">@home</td>
                            <td class="num">@ReadStrength(d1Read)</td>
                            <td class="num">@if (home == "D1") { <span class="lm-muted">—</span> } else { @ReadStrength(homeRead) }</td>
                            <td><b>@LifeMatterReading.Band(pct).Label</b></td>
                            <td>@FactorList(LifeMatterReading.Strongest(factors))</td>
                            <td>@FactorList(LifeMatterReading.Limiting(factors))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }
}
else
{
    var d1 = _data.Charts["D1"];
    var question = LifeMatterQuestions.Get(_question);
    var perspective = LifeMatterReading.PerspectiveName(question);
    var areaSteps = StepsIn(_area);
    var step = areaSteps.FirstOrDefault(s => s.LifeMatterId == _selectedLifeMatterId);
    var chartType = step is null ? "D1" : ChartTypeFor(step);
    var displayed = _data.Charts.GetValueOrDefault(chartType);
    var read = step is null || displayed is null ? null : Read(step, _question, chartType);
    var d1Read = step is null ? null : Read(step, _question, "D1");
    var theme = LifeMatterQuestions.AreaTheme(_area, CategoryName(_area));
    var areaLabel = LifeMatterQuestions.AreaLabel(_area, CategoryName(_area));
    var readPct = ReadPercent(read);
    var askText = step is null ? question.Ask(theme) : question.AskOf(step.MatterText, theme);

    <div class="lm-full" hidden></div>

    @* ---------------- Sticky context: where the reader is ---------------- *@
    <div class="lm-context" aria-label="Current selection">
        <span class="lm-crumb">@areaLabel</span>
        <span class="lm-crumb-sep" aria-hidden="true">→</span>
        <span class="lm-crumb lm-crumb-matter">@(step?.MatterText ?? "Choose a question")</span>
        <span class="lm-crumb-sep" aria-hidden="true">→</span>
        <span class="lm-crumb" title="@ChartName(chartType)">@chartType</span>
        <span class="lm-crumb-sep" aria-hidden="true">→</span>
        <span class="lm-crumb">@perspective</span>
        <span class="lm-context-pct">@Pct(readPct, "Selected question")</span>
        <button type="button" class="lm-copy" @onclick="CopyLink" title="Copy a link to this exact reading">@(_copyStatus ?? "Copy link")</button>
        @if (_copyFailed)
        {
            @* The clipboard needs permission; the link itself is always here to copy by hand. *@
            <input class="lm-link-field" readonly value="@Nav.Uri" aria-label="Link to this reading" onfocus="this.select()" />
        }
    </div>

    @* ---------------- Foundation: what every reading stands on (D1) ---------------- *@
    <section class="lm-foundation" aria-label="Chart foundation">
        <p class="lm-kicker">Foundation · main birth chart</p>
        <ul>
            @foreach (var f in _foundation)
            {
                <li class="lm-found @(f.Tone is null ? null : $"is-{f.Tone}")">
                    <a href="@AstroFactsLink.Url(Id, f.Step)" title="@($"{f.Detail} Open in Astro Facts.")">
                        <span class="lm-found-label">@f.Label</span>
                        <span class="lm-found-value">@f.Value</span>
                        <span class="lm-found-detail">@f.Detail</span>
                    </a>
                </li>
            }
        </ul>
    </section>

        <div class="lm-view-tabs" role="tablist" aria-label="Key inference view">
            <button type="button" role="tab" aria-selected="@Aria(_viewTab == "READING")"
                    class="@(_viewTab == "READING" ? "selected" : null)" @onclick='() => SelectView("READING")'>
                READING
            </button>
            <button type="button" role="tab" aria-selected="@Aria(_viewTab == "STATISTICAL")"
                    class="@(_viewTab == "STATISTICAL" ? "selected" : null)" @onclick='() => SelectView("STATISTICAL")'>
                TIMING
            </button>
            <button type="button" role="tab" aria-selected="@Aria(_viewTab == "STATS")"
                    class="@(_viewTab == "STATS" ? "selected" : null)" @onclick='() => SelectView("STATS")'>
                POPULATION
            </button>
        </div>
    <div class="lm-top" hidden="@(_viewTab == "STATS")">
        @* ================= 1 · EXPLORE ================= *@
        <nav class="lm-explore" aria-label="Choose a life area and question">
            <p class="lm-step"><b>1</b> Choose a life area</p>
            <div class="lm-pills" role="tablist" aria-label="Life area">
                @foreach (var area in _categories)
                {
                    <button type="button" role="tab" class="lm-pill" aria-selected="@Aria(area.CategoryCode == _area)"
                            title="Area overview — @string.Join(" & ", CoreHouses(area.CategoryCode).Select(Ordinal)) house of the main birth chart"
                            @onclick="() => SelectArea(area.CategoryCode)">
                        @LifeMatterQuestions.AreaLabel(area.CategoryCode, area.CategoryName)
                        @Strength(AreaStats(area.CategoryCode))
                    </button>
                }
            </div>

            <p class="lm-step"><b>2</b> Pick a question about @theme</p>
            @{
                var selectedIndex = areaSteps.ToList().FindIndex(s => s.LifeMatterId == _selectedLifeMatterId);
                var showAll = _showAllMatters || selectedIndex >= LifeMatterReading.PrimaryMatterCount;
                var visible = showAll ? areaSteps : areaSteps.Take(LifeMatterReading.PrimaryMatterCount).ToList();
            }
            <div class="lm-drill" role="listbox" aria-label="@($"{areaLabel} questions")">
                @foreach (var s in visible)
                {
                    var homeRead = Read(s, _question, HomeChart(s));
                    <button type="button" role="option" class="lm-matter" aria-selected="@Aria(s.LifeMatterId == _selectedLifeMatterId)"
                            title="@($"{s.MatterText} — read in the {ChartName(HomeChart(s))}")"
                            @onclick="() => SelectStep(s.LifeMatterId)">
                        <span class="lm-matter-name">@s.MatterText</span>
                        @ReadStrength(homeRead)
                    </button>
                }
            </div>
            @if (areaSteps.Count > LifeMatterReading.PrimaryMatterCount && selectedIndex < LifeMatterReading.PrimaryMatterCount)
            {
                <button type="button" class="lm-more" aria-expanded="@Aria(showAll)" @onclick="() => _showAllMatters = !_showAllMatters">
                    @(showAll ? "Fewer questions" : $"More questions ({areaSteps.Count - LifeMatterReading.PrimaryMatterCount})")
                </button>
            }
        </nav>

        <div class="lm-tab-panel" role="tabpanel" hidden="@(_viewTab != "READING")">
        @* ================= 2 · UNDERSTAND ================= *@
        <section class="lm-answer" aria-label="Answer">
            <p class="lm-step"><b>3</b> Your answer</p>
            @if (step is null)
            {
                <p class="lm-note">Choose a question to see how well it is supported.</p>
            }
            else
            {
                var band = LifeMatterReading.Band(readPct);
                var home = HomeChart(step);
                var factors = LifeMatterReading.Factors(read?.Items.Select(i => i.Stats).ToList() ?? [], chartType);
                var strongest = LifeMatterReading.Strongest(factors);
                var limiting = LifeMatterReading.Limiting(factors);
                var areaPct = AreaStats(_area).StrengthPercent;

                <p class="lm-kicker">Selected question</p>
                <h1 class="lm-question">@askText</h1>

                <div class="lm-score lm-tone-@band.Tone">
                    <span class="lm-big">@(readPct is null ? "—" : $"{readPct}%")</span>
                    <span class="lm-score-words"><b>@band.Label</b><span>@band.Meaning</span></span>
                    <button type="button" class="lm-info" aria-expanded="@Aria(_showExplain)" aria-controls="lm-explain"
                            @onclick="() => _showExplain = !_showExplain">
                        <span aria-hidden="true">i</span><span class="lm-sr">What does this figure mean?</span>
                    </button>
                </div>
                @if (_showExplain)
                {
                    <div class="lm-explain" id="lm-explain">
                        <p>The figure is how well this part of life is supported in the chart, on a scale where
                            <b>50% is the ordinary midpoint</b>. It averages three things equally:</p>
                        <ul>
                            <li><b>Strength of the ruling planets</b> — @Percent(Axis(read, 0))</li>
                            <li><b>Consistency across the divisional charts</b> — @Percent(Axis(read, 1))</li>
                            <li><b>The house's own setting</b> (its support, its ruler's comfort there, its strength
                                and the help or hindrance of other planets) — @Percent(Axis(read, 2))</li>
                        </ul>
                        @if (read is { Items.Count: > 1 })
                        {
                            <p>This question reads @ReadsText(read); the figure is their average.</p>
                        }
                    </div>
                }

                <PopulationEvidenceCard Snapshot="_populationEvidence" Rows="PopulationRows(d1Read)" />

                <dl class="lm-compare">
                    <div>
                        <dt>Foundation <span>main birth chart · D1</span></dt>
                        <dd>@Pct(ReadPercent(d1Read), "Main birth chart")<span>@LifeMatterReading.Band(ReadPercent(d1Read)).Label</span></dd>
                    </div>
                    @if (home != "D1")
                    {
                        var homePct = ReadPercent(Read(step, _question, home));
                        <div>
                            <dt>Confirmation <span>@ChartName(home) · @home</span></dt>
                            <dd>@Pct(homePct, ChartName(home))<span>@LifeMatterReading.Band(homePct).Label</span></dd>
                        </div>
                    }
                    @if (chartType != "D1" && chartType != home)
                    {
                        <div>
                            <dt>Chart shown <span>@ChartName(chartType) · @chartType</span></dt>
                            <dd>@Pct(readPct, ChartName(chartType))<span>@band.Label</span></dd>
                        </div>
                    }
                </dl>

                <div class="lm-factors">
                    <div>
                        <h3>Strongest factors</h3>
                        @if (strongest.Count == 0)
                        {
                            <p class="lm-note">No factor reaches the midpoint.</p>
                        }
                        else
                        {
                            <ul>@foreach (var f in strongest) { <li>@Factor(f)</li> }</ul>
                        }
                    </div>
                    <div>
                        <h3>Limiting or uncertain</h3>
                        @if (limiting.Count == 0)
                        {
                            <p class="lm-note">Every factor is at or above the midpoint.</p>
                        }
                        else
                        {
                            <ul>@foreach (var f in limiting) { <li>@Factor(f)</li> }</ul>
                        }
                    </div>
                </div>

                var acts = Influences(read, displayed, 0, false, step);
                @if (acts is not null)
                {
                    var helpers = TargetInfluenceText.Helpers(acts.Reading);
                    var hinderers = TargetInfluenceText.Hinderers(acts.Reading);
                    <div class="lm-acts">
                        <h3>What acts on the @acts.Label <span>@DisplaySign(acts.Sign) · @chartType</span></h3>
                        <p><b>Helps</b>
                            @if (helpers.Count == 0) { <span class="lm-muted">no planet acting on it leans in its favour</span> }
                            @foreach (var h in helpers) { <span class="lm-act">@h.Planet <em>@TargetInfluenceText.Why(h)</em></span> }
                        </p>
                        <p><b>Hinders</b>
                            @if (hinderers.Count == 0) { <span class="lm-muted">no planet acting on it leans against it</span> }
                            @foreach (var h in hinderers) { <span class="lm-act">@h.Planet <em>@TargetInfluenceText.Why(h)</em></span> }
                        </p>
                    </div>
                }

                <p class="lm-area-line">
                    <span class="lm-kicker">Area overview</span>
                    @areaLabel @Pct(areaPct, "Area overview") —
                    the area's core @string.Join(" & ", CoreHouses(_area).Select(Ordinal)) house@(CoreHouses(_area).Count > 1 ? "s" : "") in the main birth chart,
                    before any single question.
                </p>

                <div class="lm-refine">
                    <div class="lm-refine-row">
                        <span class="lm-label">Read from</span>
                        <div class="lm-chips" role="group" aria-label="Perspective">
                            @foreach (var (code, name) in LifeMatterReading.PrimaryPerspectives)
                            {
                                var pRead = Read(step, code, chartType);
                                <button type="button" class="lm-chip @(pRead?.Sourced == true ? "sourced" : "")"
                                        aria-pressed="@Aria(code == _question)" disabled="@(pRead is null)"
                                        title="@PerspectiveTitle(code, pRead, chartType)"
                                        @onclick="() => SelectQuestion(code)">
                                    @name @Pct(ReadPercent(pRead), name)
                                </button>
                            }
                        </div>
                    </div>
                    <details class="lm-advanced" open="@(!LifeMatterReading.IsPrimaryPerspective(_question))">
                        <summary>Advanced perspectives</summary>
                        <div class="lm-chips" role="group" aria-label="Advanced perspective">
                            @foreach (var q in LifeMatterQuestions.All.Where(q => !LifeMatterReading.IsPrimaryPerspective(q.ReferenceCode)))
                            {
                                var qRead = Read(step, q.ReferenceCode, chartType);
                                <button type="button" class="lm-chip @(qRead?.Sourced == true ? "sourced" : "")"
                                        aria-pressed="@Aria(q.ReferenceCode == _question)" disabled="@(qRead is null)"
                                        title="@PerspectiveTitle(q.ReferenceCode, qRead, chartType)"
                                        @onclick="() => SelectQuestion(q.ReferenceCode)">
                                    @q.Label @Pct(ReadPercent(qRead), q.Label)
                                </button>
                            }
                        </div>
                    </details>
                    <div class="lm-refine-row">
                        <span class="lm-label">Chart</span>
                        <div class="lm-chips" role="group" aria-label="Relevant charts">
                            @foreach (var c in RelevantCharts(step))
                            {
                                <button type="button" class="lm-chip" aria-pressed="@Aria(c == chartType)"
                                        title="@($"{ChartName(c)} · {_data.Charts[c].Label}")" @onclick="() => SelectChart(c)">
                                    @ChartShort(c) <span class="lm-chip-code">@c</span>
                                </button>
                            }
                        </div>
                        <label class="lm-all-charts">
                            <span class="lm-sr">All charts</span>
                            <select value="@(RelevantCharts(step).Contains(chartType) ? "" : chartType)"
                                    @onchange="e => SelectChart(e.Value?.ToString() is { Length: > 0 } v ? v : home)">
                                <option value="" disabled>All charts…</option>
                                @foreach (var c in AllCharts())
                                {
                                    <option value="@c">@c · @ChartShort(c)</option>
                                }
                            </select>
                        </label>
                    </div>
                    <p class="lm-note">A gold edge marks a perspective whose houses the classical texts name for this
                        question; the others count the same houses from that point.</p>
                </div>

                <p class="lm-disclaimer">Strength shows <b>capacity</b> — how well this part of life is supported —
                    not a prediction of what will happen. A strong figure is not by itself a favourable outcome.</p>
            }
        </section>
    </div>

        <section class="lm-statistical lm-tab-panel" role="tabpanel" hidden="@(_viewTab != "STATISTICAL")"
                 aria-label="Statistical timing model">
            <div class="lm-stat-head">
                <div>
                    <p class="lm-step"><b>V10</b> Statistical timing model</p>
                    <h2>@(step?.MatterText ?? "Choose a question")</h2>
                    <p>D1 establishes the promise, the relevant varga confirms its domain, DashaMatters activates it, and transit identifies a manifestation window.</p>
                </div>
                <label>Evaluation date
                    <input type="date" value="@_timingDate.ToString("yyyy-MM-dd")" @onchange="OnTimingDateChanged" />
                </label>
            </div>

            @if (step is null)
            {
                <p class="lm-note">Choose a question to evaluate the timing chain.</p>
            }
            else if (_timingResult is null)
            {
                <p class="lm-note">The timing model could not be evaluated for this question.</p>
                @if (_timingMissing.Count > 0)
                {
                    <ul class="lm-stat-missing">@foreach (var item in _timingMissing) { <li>@item</li> }</ul>
                }
            }
            else
            {
                var timing = _timingResult;
                <div class="lm-stage-grid">
                    <article class="lm-stage @StageTone(timing.Activation.D1Verdict.ToString())">
                        <span>1 · Natal gate</span><h3>D1 promise</h3>
                        <b>@Words(timing.Activation.D1Verdict.ToString())</b>
                        <p>@timing.Activation.Lines.FirstOrDefault()</p>
                    </article>
                    <article class="lm-stage @StageTone(timing.Activation.VargaSupport.ToString())">
                        <span>2 · Domain</span><h3>Varga support</h3>
                        <b>@Words(timing.Activation.VargaSupport.ToString())</b>
                        <p>@(timing.Activation.Varga?.Inference ?? "Relevant varga evidence is not available.")</p>
                    </article>
                    <article class="lm-stage @StageTone(timing.Activation.State.ToString())">
                        <span>3 · Period</span><h3>Dasha activation</h3>
                        <b>@Words(timing.Activation.State.ToString())</b>
                        <p>@timing.Activation.Lines.LastOrDefault()</p>
                        @if (timing.Activation.Matches.Count > 0)
                        {
                            <small>@string.Join(" · ", timing.Activation.Matches.Select(m => $"{m.Level}: {m.Lord}"))</small>
                        }
                    </article>
                    <article class="lm-stage @StageTone(timing.Manifestation.State.ToString())">
                        <span>4 · Window</span><h3>Transit manifestation</h3>
                        <b>@Words(timing.Manifestation.State.ToString())</b>
                        <p>@timing.Manifestation.Lines.FirstOrDefault()</p>
                        @if (timing.Manifestation.RelevantTransits.Count > 0)
                        {
                            <small>@string.Join(" · ", timing.Manifestation.RelevantTransits.Select(t => t.Planet))</small>
                        }
                    </article>
                </div>
                <p class="lm-stat-policy">A transit trigger is a qualified timing window, not an event guarantee. It cannot override an indeterminate D1 promise or an inactive dasha.</p>
                @if (_timingMissing.Count > 0)
                {
                    <div class="lm-stat-gaps"><b>Evidence gaps</b><ul>@foreach (var item in _timingMissing) { <li>@item</li> }</ul></div>
                }
            }
        </section>
    @* ================= 3 · INVESTIGATE ================= *@
    @if (step is not null && _viewTab == "READING")
    {
        <section class="lm-investigate" aria-label="Investigate">
            <p class="lm-step"><b>4</b> Investigate the evidence</p>

            <details class="lm-section" open>
                <summary>Chart <span>@ChartName(chartType) · @chartType · from @question.Label</span></summary>
                <p class="lm-ki-link"><a href="@AstroFactsLink.Url(Id, AstroFactsLink.Overview, chartType)">Planet positions for @chartType in Astro Facts →</a></p>
                <div class="lm-chart">
                    @if (displayed is null)
                    {
                        <EmptyState Message="@($"{chartType} not generated for this person")" Cli="backfill-charts" />
                    }
                    else
                    {
                        var trackSign = ResolveReferenceSign(displayed, _question);
                        @* SIND-UNI-3 micro view with the special-lagna bars (docs/ui/components/spec_SIND-UNI_GridChart.md) —
                           the same view as Astro Facts → Spl Lagnas; keeps SindHovGrid's hover / pin contract. *@
                        <SindUni3Grid Chart="UniChart(displayed)" ShowSpecialLagnas="true"
                                      RelevantSigns="RelevantSigns(displayed, step)"
                                      FocusCodes="SpecialPointCodes(step).ToHashSet()"
                                      PinnedSign="ToSign(_pinnedSign)"
                                      PinnedSignChanged="s => _pinnedSign = s?.ToString()"
                                      TrackSign="@(_question == "LAGNA" ? null : ToSign(trackSign))"
                                      TrackTag="@question.Tag"
                                      TrackLabel="@question.Label"
                                      KarakaPlanets="KarakaPlanets(displayed, step)"
                                      Title="@step.MatterText"
                                      Note="@(read is null ? question.Label + " not available" : $"{string.Join(" & ", read.Items.Select(i => i.SpecialPoint ?? Ordinal(i.House)))} from {question.Label}")"
                                      Meta="@($"{displayed.ChartType} · Lagna {DisplaySign(displayed.AscendantSign)}{(trackSign is not null && _question != "LAGNA" ? $" · {question.Tag} {DisplaySign(trackSign)}" : "")}")"
                                      AriaLabel="@($"{displayed.ChartType} South Indian chart")"
                                      PrefsKey="key-inference" />
                    }
                </div>
            </details>

            <details class="lm-section">
                <summary>Every perspective in every chart <span>@SummaryCharts(step).Count charts × @LifeMatterQuestions.All.Count perspectives</span></summary>
                <p class="lm-ki-link"><a href="@AstroFactsLink.Url(Id, AstroFactsLink.SpecialLagnas)">The special lagnas in Astro Facts →</a></p>
                @{ var summaryCharts = SummaryCharts(step); }
                <p class="lm-note">@SummaryNote(step) Choose a figure to show that perspective in that chart.</p>
                <div class="lm-scroll">
                    <table class="lm-table lm-matrix">
                        <thead>
                            <tr>
                                <th>Perspective</th>
                                <th>Houses read</th>
                                @foreach (var c in summaryCharts)
                                {
                                    <th class="num" title="@ChartName(c)">@c<span class="lm-col-role">@ChartRole(step, c)</span></th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var q in LifeMatterQuestions.All)
                            {
                                var qD1 = Read(step, q.ReferenceCode, "D1");
                                <tr class="@(q.ReferenceCode == _question ? "selected" : "") @(qD1?.Sourced == true ? "sourced" : "")">
                                    <th scope="row">
                                        <button type="button" class="lm-q-link" @onclick="() => SelectQuestion(q.ReferenceCode)">
                                            <span class="lm-chart-tag">@q.Tag</span> @q.Label
                                        </button>
                                    </th>
                                    <td class="lm-muted">@(qD1 is null ? "—" : $"{ReadsText(qD1)} · {SourceText(qD1)}")</td>
                                    @foreach (var c in summaryCharts)
                                    {
                                        var cell = Read(step, q.ReferenceCode, c);
                                        <td class="num">
                                            <button type="button" class="lm-cell" disabled="@(cell is null)"
                                                    aria-pressed="@Aria(q.ReferenceCode == _question && c == chartType)"
                                                    aria-label="@($"{q.Label} in {c}")"
                                                    @onclick="() => SelectCell(q.ReferenceCode, c)">
                                                @ReadStrength(cell)
                                            </button>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>

            <details class="lm-section">
                @{ var detailCharts = DetailCharts(step, chartType); }
                <summary>House-by-house evidence <span>@question.Label · @string.Join(" · ", detailCharts)</span></summary>
                <p class="lm-ki-link"><a href="@AstroFactsLink.Url(Id, AstroFactsLink.Houses, chartType)">House lords and occupants for @chartType in Astro Facts →</a></p>
                <p class="lm-note">@SourceSentence(read, question) The main birth chart (D1) is the foundation; the
                    question's own charts confirm it.</p>
                @{ var reads = detailCharts.Select(c => (Chart: c, Read: Read(step, _question, c))).ToList(); }
                @if (reads.All(r => r.Read is null))
                {
                    <p class="lm-note">@question.Label is not available for this person yet.</p>
                }
                else if (reads.All(r => r.Read is null || r.Read.Items.Count == 0))
                {
                    <p class="lm-note">Relevant evidence not yet structured for this question.</p>
                }
                else
                {
                    var keys = reads.SelectMany(r => r.Read?.Items ?? []).Select(ItemKey).Distinct().ToList();
                    @foreach (var key in keys)
                    {
                        var items = reads.Select(r => (r.Chart, Item: r.Read?.Items.FirstOrDefault(i => ItemKey(i) == key))).ToList();
                        var head = items.First(i => i.Item is not null).Item!;
                        <h3>@(head.SpecialPoint is null ? $"{Ordinal(head.House)} house" : head.SpecialPoint) from @question.Label</h3>
                        <div class="lm-scroll">
                            <table class="lm-table lm-cmp">
                                <thead><tr><th></th>
                                    @foreach (var (c, _) in items)
                                    {
                                        <th>@c · @(c == "D1" ? "foundation" : ChartRole(step, c))</th>
                                    }
                                </tr></thead>
                                <tbody>
                                    @foreach (var row in StatRows)
                                    {
                                        <tr>
                                            <th scope="row">@row.Label@if (row.Technical is not null) {<span class="lm-tech">@row.Technical</span>}</th>
                                            @foreach (var (c, item) in items)
                                            {
                                                <td>@Cell(row.Key, item, _data.Charts[c])</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    @if (read?.Sourced == true && FocusNote(step) is { } note)
                    {
                        <div class="lm-focus-note">
                            <h3>Why @question.Label</h3>
                            <p><InterpretationText StandardText="@note.StandardText" ShortText="@note.ShortText" /></p>
                        </div>
                    }
                }
            </details>

            <details class="lm-section">
                @{ var infl = Influences(read, displayed, _influenceIndex, _influenceOnPada, step); }
                <summary>What acts on it <span>Influences · @(infl?.Label ?? "—") · @chartType</span></summary>
                <p class="lm-ki-link"><a href="@AstroFactsLink.Url(Id, AstroFactsLink.Relationships, chartType)">Every aspect and conjunction for @chartType in Astro Facts →</a></p>
                @if (infl is null || read is null)
                {
                    <p class="lm-note">Not available in @chartType.</p>
                }
                else
                {
                    var current = read.Items[Math.Clamp(_influenceIndex, 0, read.Items.Count - 1)];
                    <div class="lm-refine-row">
                        @if (read.Items.Count > 1)
                        {
                            <span class="lm-label">Target</span>
                            <div class="lm-chips" role="group" aria-label="Which house or point">
                                @for (var i = 0; i < read.Items.Count; i++)
                                {
                                    var index = i;
                                    var it = read.Items[i];
                                    <button type="button" class="lm-chip" aria-pressed="@Aria(it == current)" @onclick="() => _influenceIndex = index">
                                        @(it.SpecialPoint ?? $"{Ordinal(it.House)} house")
                                    </button>
                                }
                            </div>
                        }
                        @if (current.SpecialPoint is null)
                        {
                            <span class="lm-label">Read</span>
                            <div class="lm-chips" role="group" aria-label="House or its Āruḍha pada">
                                <button type="button" class="lm-chip" aria-pressed="@Aria(!_influenceOnPada)" @onclick="() => _influenceOnPada = false"
                                        title="The house itself: the matter as it is">The house</button>
                                <button type="button" class="lm-chip" aria-pressed="@Aria(_influenceOnPada)" @onclick="() => _influenceOnPada = true"
                                        title="The house's Āruḍha pada: the matter as the world sees it">Its Āruḍha</button>
                            </div>
                        }
                    </div>
                    <p class="lm-note">
                        @infl.Label in @DisplaySign(infl.Sign). Ruled by <b>@infl.Reading.Lord</b>, placed
                        @TargetInfluenceText.PositionText(infl.Reading.LordHouseFromTarget, infl.Reading.LordPosition).
                        Its bādhaka (the planet that can obstruct it) is <b>@infl.Reading.Baadhaka.Baadhaka</b>, lord of
                        @DisplaySign(infl.Reading.Baadhaka.SthaanaSign.ToString()), the @Ordinal(infl.Reading.Baadhaka.SthaanaOffset) from it.
                    </p>
                    <div class="lm-scroll">
                        <table class="lm-table lm-infl">
                            <thead><tr><th>Planet</th><th>Where from it</th><th>Reaches it by</th><th>Nature for @chartType Lagna</th><th>Role</th><th>Reads as</th></tr></thead>
                            <tbody>
                                @foreach (var p in infl.Reading.Planets)
                                {
                                    <tr class="@(p.Touches || p.IsLord ? "is-acting" : null)">
                                        <td>@p.Planet</td>
                                        <td>@TargetInfluenceText.PositionText(p.HouseFromTarget, p.Position) <span class="lm-muted">· @DisplaySign(p.Sign.ToString())</span></td>
                                        <td>@(p.Touches ? string.Join(", ", TargetInfluenceText.Links(p.Links)) : "—")</td>
                                        <td>@TargetInfluenceText.FunctionalText(p.Functional) <span class="lm-muted">· natural @(p.IsNaturalMalefic ? "malefic" : "benefic")</span></td>
                                        <td>@InfluenceRole(p)</td>
                                        <td><span class="lm-lean is-@p.Lean.ToString().ToLowerInvariant()">@TargetInfluenceText.LeanText(p.Lean)</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="lm-note">Where a planet stands counted from the target is PVR's step 5: quadrants (1, 4, 7, 10)
                        sustain the matter, trines (1, 5, 9) let it prosper, upachayas (3, 6, 10, 11) let it grow, dusthānas
                        (6, 8, 12) bring obstacles; its bādhaka, and planets in the bādhaka's sign, can create trouble.
                        Planets that sit in, aspect or intervene on it are in bold; the rest act through their periods.
                        Nature for the Lagna is shown for judgement, not counted, and none of this changes the strength %.</p>
                }
            </details>

            <details class="lm-section">
                <summary>Help or hindrance from other planets <span>Argala &amp; Virodhargala · @chartType</span></summary>
                <p class="lm-ki-link"><a href="@AstroFactsLink.Url(Id, AstroFactsLink.Houses, chartType)">Every house's Argala for @chartType in Astro Facts →</a></p>
                <p class="lm-note">Planets placed to intervene on each house in @chartType@(chartType == "D1" ? "" : ", from that chart's own placements").
                    An intervention holds when its planets outnumber the obstructing ones; planet strength is not
                    compared yet.</p>
                @if (read is null || read.Items.Count == 0)
                {
                    <p class="lm-note">No house to analyse.</p>
                }
                else
                {
                    @foreach (var item in read.Items)
                    {
                        var arg = item.Stats.Argala;
                        <h3>@Ordinal(item.House) house · @DisplaySign(item.Stats.Sign)</h3>
                        @if (!arg.Any)
                        {
                            <p class="lm-note">No planet intervenes on this house.</p>
                        }
                        else
                        {
                            <div class="lm-scroll">
                                <table class="lm-table">
                                    <thead><tr><th>Pair</th><th>Helping (Argala)</th><th>Obstructing (Virodhargala)</th><th>Result</th></tr></thead>
                                    <tbody>
                                    @foreach (var pair in arg.Pairs.Where(p => p.ArgalaPlanets.Count > 0 || p.ObstructingPlanets.Count > 0))
                                    {
                                        <tr>
                                            <td>@pair.ArgalaOffset / @pair.ObstructionOffset <span class="lm-muted">@pair.Kind</span></td>
                                            <td>@(pair.ArgalaPlanets.Count == 0 ? "—" : string.Join(", ", pair.ArgalaPlanets)) <span class="lm-muted">(@Ordinal(pair.ArgalaOffset))</span>@(pair.ExceptionApplied ? " · exception" : "")</td>
                                            <td>@(pair.ObstructingPlanets.Count == 0 ? "—" : string.Join(", ", pair.ObstructingPlanets)) <span class="lm-muted">(@Ordinal(pair.ObstructionOffset))</span></td>
                                            <td>@ArgalaResult(pair.Verdict)</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                }
            </details>

            @{ IReadOnlyList<(string PlanetA, string PlanetB, string? Relationship)> relationships = displayed is null ? [] : KarakaRelationships(displayed, step); }
            @if (relationships.Count > 0)
            {
                <details class="lm-section">
                    <summary>How the significator planets relate <span>Kāraka relationships · @chartType</span></summary>
                    <p class="lm-ki-link"><a href="@AstroFactsLink.Url(Id, AstroFactsLink.Relationships, chartType)">Dṛṣṭi, dispositors and conjunctions for @chartType in Astro Facts →</a></p>
                    <p class="lm-note">Compound relationship (natural + temporary) between this question's significator
                        planets in @chartType.</p>
                    <table class="lm-table">
                        <thead><tr><th>Planet</th><th>Planet</th><th>Relationship</th></tr></thead>
                        <tbody>
                        @foreach (var (pa, pb, rel) in relationships)
                        {
                            <tr><td>@pa</td><td>@pb</td><td>@(rel ?? "—")</td></tr>
                        }
                        </tbody>
                    </table>
                </details>
            }

            <details class="lm-section">
                @{ var planetRows = PlanetRows(read ?? d1Read, step); }
                <summary>Planet strength &amp; condition <span>Ṣaḍbala &amp; Avastha · D1</span></summary>
                <p class="lm-ki-link"><a href="@AstroFactsLink.Url(Id, AstroFactsLink.Strength)">Full Ṣaḍbala and Bhāva Bala in Astro Facts →</a></p>
                @if (planetRows.Count == 0)
                {
                    <p class="lm-note">No ruling or significator planets for this question.</p>
                }
                else
                {
                    <p class="lm-note">The rulers of this question's houses in @chartType and its significator planets
                        (@string.Join(", ", planetRows.Select(r => r.Planet))). Condition (Avastha) and Ṣaḍbala are
                        computed once per planet, from D1.</p>
                    <PlanetaryStateTable Rows="planetRows" StateNames="_stateNames"
                                         PostureInterpretations="_postureInterpretations"
                                         KeyDetails="d1.KeyDetails" Strengths="_shadbala" />
                }
            </details>

            <details class="lm-section">
                <summary>How these figures are calculated <span>method &amp; sources</span></summary>
                <p class="lm-note">Strength % is the mean of three axes, each counting equally. Capacity: Ṣaḍbala of
                    the lord and the matter's kārakas (the required minimum reads 50%). Consistency: the same planets'
                    Shodasavarga Amsabala. Context: SAV out of 56 bindus, the lord's own BAV in the sign out of 8,
                    Bhava Bala and Argala. Bhava Bala here is Dig + Drik only — its Bhavadhipati part is the lord's
                    Ṣaḍbala, already in Capacity — scored against this chart's 12 houses (the chart's mean reads 50%).
                    Bands: SAV above 30 / below 25 and BAV 5+ / 3 or fewer (PVR); Ṣaḍbala strong at 100% of its
                    required minimum (Parāśara) and weak under 80%; Bhava Bala strong or weak beyond one standard
                    deviation of the chart's houses. The 80% floor and the Bhava Bala band are the app's own
                    heuristics, not classical rules. Argala in a varga is computed from that varga's placements.</p>
                <p class="lm-note">The words beside a figure are the app's display bands around the 50% midpoint:
                    65%+ strong, 55%+ good, 45–54% moderate, 35–44% limited, under 35% weak.</p>
                <p class="lm-note">Perspectives: a <b>classical</b> perspective reads the houses the texts name for this
                    question from that lagna (sourced); a <b>counted</b> one counts the question's Lagna houses from that
                    lagna instead (re-counted). The area overview reads the area's most-used house from Lagna in D1.
                    @SummaryNote(step)</p>
            </details>
        </section>
    }
        </div>

    @if (_viewTab == "STATS")
    {
        <KeyStatsPanel Id="Id" />
    }
}

@code {
    [Parameter] public int Id { get; set; }

    // Deep link (KeyInferenceLink): ?matter=WEALTH_02&lagna=MO&chart=D9. Read on load and whenever the
    // URL changes (back/forward, a pasted link); every selection writes the URL back in place.
    [SupplyParameterFromQuery(Name = "matter")] public string? Matter { get; set; }
    [SupplyParameterFromQuery(Name = "lagna")] public string? Lagna { get; set; }
    [SupplyParameterFromQuery(Name = "chart")] public string? Chart { get; set; }
    /// <summary>?view=reading|timing|stats opens that view (Key Stats links land here).</summary>
    [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }
    private string? _appliedView;

    /// <summary>PrintReport's Key Inference codes: PrintModules.Foundation and life-area codes. Set,
    /// the page renders those as static tables instead of the interactive reading.</summary>
    [Parameter] public IReadOnlySet<string>? PrintModules { get; set; }

    private const byte RuleSetId = 1;
    private static readonly LifeMatterFocusResolver Resolver = new();

    private WorkspaceData? _data;
    private IReadOnlyList<LifeMatterCategoryRow> _categories = [];
    private IReadOnlyList<LifeMatterStepRow> _allSteps = [];
    private IReadOnlyList<HouseReferenceRow> _references = [];
    private Dictionary<int, ResolvedLifeMatterFocus> _resolved = new();

    // Persisted facts, read once; LifeMatterStatistics is built per chart on first use.
    private IReadOnlyList<AshtakavargaRow> _ashtakavarga = [];
    private IReadOnlyList<BhavaBalaSummaryRow> _bhavaBala = [];
    private IReadOnlyList<BhavaBalaComponentRow> _bhavaComponents = [];
    private IReadOnlyList<AmsabalaRow> _amsabala = [];
    private IReadOnlyList<ArgalaFactRow> _argala = [];
    private readonly Dictionary<string, LifeMatterStatistics> _statsByChart = new();

    private IReadOnlyList<PlanetaryStateFact> _planetaryStates = [];
    private IReadOnlyDictionary<byte, PlanetaryStateRow> _stateNames = new Dictionary<byte, PlanetaryStateRow>();
    private IReadOnlyDictionary<(byte PlanetaryStateId, byte PlanetId), PostureStateInterpretationRow> _postureInterpretations =
        new Dictionary<(byte, byte), PostureStateInterpretationRow>();
    private IReadOnlyList<ShadbalaSummaryRow> _shadbala = [];
    private IReadOnlyList<FoundationItem> _foundation = [];
    private Ikiastrro.Data.Statistics.PopulationEvidenceSnapshot _populationEvidence =
        new("NOT_ENROLLED", null, null, 0, null, null, null, null, null, null, []);

    // Sourced rationale for a matter's special-lagna Focus row, tbl_Content_Interpretation
    // SubjectType 'LIFE_MATTER_FOCUS' keyed '{LifeMatterCode}_{ReferenceCode}' (db/153). Seeded so
    // far for the Indu/Pranapada links only; a missing row simply shows nothing.
    private IReadOnlyList<InterpretationRow> _focusNotes = [];

    private string _area = "";
    private string _question = "LAGNA";
    private int? _selectedLifeMatterId;
    private string? _chartOverride;   // null = the matter's own varga
    private string? _pinnedSign;
    private int? _loadedId;
    private bool _showAllMatters;   // "More questions" opened for the current area
    private bool _showExplain;      // the answer card's "i" explanation

    private string _viewTab = "READING";
    private DateTime _timingDate = DateTime.Today;
    private LifeMatterTimingResult? _timingResult;
    private IReadOnlyList<string> _timingMissing = [];

    protected override void OnParametersSet()
    {
        ApplyView();
        LoadOrApply();
    }

    private void ApplyView()
    {
        if (View is null) { _appliedView = null; return; }
        if (View == _appliedView) return;
        _appliedView = View;
        _viewTab = KeyInferenceView.Parse(View)!;
    }

    private void LoadOrApply()
    {
        if (_loadedId == Id)
        {
            ApplyQuery();
            return;
        }
        // Switching person (MainLayout.GoToPerson) drops the query string: carry the reading on
        // show — matter, lagna question and picked chart — over to the new person instead of
        // falling back to the first area.
        var carry = _loadedId is not null && Matter is null && Lagna is null && Chart is null
            ? _allSteps.FirstOrDefault(s => s.LifeMatterId == _selectedLifeMatterId)?.LifeMatterCode
            : null;
        var (carryQuestion, carryChart) = (_question, _chartOverride);
        _loadedId = Id;
        _statsByChart.Clear();
        _chartOverride = null;
        _question = "LAGNA";

        _data = WorkspaceData.Load(Id, BirthDetailsRepo, ChartResultsRepo, ChartKeyDetailsRepo,
            ChartHouseLordsRepo, ChartHouseLordInterpretationRepo, ChartAspectsRepo, ChartConjunctionsRepo,
            ChartMultiGrahaConjunctionRepo, ChartTypeRepo.GetAll());
        if (_data is not null && !_data.Charts.ContainsKey("D1")) _data = null;

        if (_data is null)
        {
            Active.Clear();
            return;
        }

        var p = _data.Person;
        Active.Set(Id, p.Name,
            $"{p.DateOfBirth:dd MMM yyyy} · {p.TimeOfBirth:HH\\:mm} · {p.PlaceCity}, {p.PlaceCountry}");
        Active.SetHeaderExtra(null);

        // One page-load snapshot; every Area/matter/chart/lagna switch after this is client-side.
        _categories = LifeMatterReferenceRepo.GetCategories(RuleSetId);
        _allSteps = LifeMatterReferenceRepo.GetAllSteps(RuleSetId);
        _references = LifeMatterFocusRepo.GetHouseReferences();
        _focusNotes = InterpretationRepo.GetBySubjectType(RuleSetId, "LIFE_MATTER_FOCUS");
        var subjects = LifeMatterFocusRepo.GetSubjects(RuleSetId);
        var foci = LifeMatterFocusRepo.GetFoci(RuleSetId);
        var karakas = KarakaMatterRepo.GetForRuleSet(RuleSetId);
        _resolved = _allSteps.ToDictionary(s => s.LifeMatterId,
            s => Resolver.Resolve(RuleSetId, s.LifeMatterId, subjects, karakas, foci));

        _planetaryStates = PlanetaryStateRepo.GetByBirthDetailId(Id).Where(r => r.AgeStateId.HasValue).ToList();
        _stateNames = PlanetaryStateRuleRepo.GetAllStates();
        var avasthaRuleSetId = _planetaryStates.FirstOrDefault()?.RuleSetId ?? (byte)1;
        _postureInterpretations = PostureStateInterpretationRepo.GetByRuleSet(avasthaRuleSetId);
        _shadbala = PlanetaryStrengthRepo.GetSummaryByBirthDetailId(Id);
        _foundation = LifeMatterFoundation.Build(_data.Charts["D1"], _shadbala);
        _populationEvidence = PopulationEvidenceRepo.GetLatestForBirthDetail(Id);
        _ashtakavarga = AshtakavargaRepo.GetByBirthDetailId(Id);
        _bhavaBala = BhavaStrengthRepo.GetSummaryByBirthDetailId(Id);
        _bhavaComponents = BhavaStrengthRepo.GetComponentsByBirthDetailId(Id);
        _amsabala = AmsabalaRepo.GetByBirthDetailId(Id);
        _argala = ArgalaFactRepo.GetByBirthDetailId(Id);
        _uniCharts.Clear();

        _appliedQuery = null;
        ApplyQuery();
        if (carry is not null)
        {
            Select(carry, carryQuestion, carryChart);
            SyncUrl();
        }
    }

    // ---------------- deep link ----------------

    private string? _appliedQuery;   // the matter|lagna|chart last applied or written, so a URL we wrote is not re-applied
    private string? _copyStatus;
    private bool _copyFailed;

    private static string QueryKey(string? matter, string? lagna, string? chart) => $"{matter}|{lagna}|{chart}";

    /// <summary>Selects what the URL names; anything it doesn't name (or names wrongly) falls back to
    /// the default — the first area's first matter, Lagna, the matter's own chart.</summary>
    private void ApplyQuery()
    {
        var key = QueryKey(Matter, Lagna, Chart);
        if (_data is null || key == _appliedQuery) return;
        _appliedQuery = key;
        Select(Matter, Lagna, Chart);
    }

    /// <summary>Selects a matter code, lagna (tag or reference code) and chart; each one missing or
    /// unknown for this person falls back to its default.</summary>
    private void Select(string? matter, string? lagna, string? chart)
    {
        var step = _allSteps.FirstOrDefault(s => string.Equals(s.LifeMatterCode, matter, StringComparison.OrdinalIgnoreCase));
        _area = step?.CategoryCode ?? _categories.FirstOrDefault()?.CategoryCode ?? "";
        _selectedLifeMatterId = step?.LifeMatterId ?? StepsIn(_area).FirstOrDefault()?.LifeMatterId;
        _question = KeyInferenceLink.ResolveLagna(lagna) ?? "LAGNA";
        _chartOverride = KeyInferenceLink.ResolveChart(chart, _data!.Charts.Keys);
        _pinnedSign = null;
        _influenceIndex = 0;
        _showAllMatters = false;
        _copyStatus = null;
        _copyFailed = false;
    }

    /// <summary>Writes the current selection into the URL (replacing the history entry), so the
    /// address bar is always a shareable link to this exact reading.</summary>
    private void SyncUrl()
    {
        _influenceIndex = 0;
        _copyStatus = null;
        if (_viewTab == "STATISTICAL") LoadTiming();

        _copyFailed = false;
        var step = _allSteps.FirstOrDefault(s => s.LifeMatterId == _selectedLifeMatterId);
        var chart = step is null || _chartOverride is null || _chartOverride == HomeChart(step) ? null : _chartOverride;
        _appliedQuery = QueryKey(step?.LifeMatterCode, _question == "LAGNA" ? null : LifeMatterQuestions.Get(_question).Tag, chart);
        var url = KeyInferenceLink.Url(Id, step?.LifeMatterCode, _question, chart);
        if (Nav.ToBaseRelativePath(Nav.Uri) != url.TrimStart('/')) Nav.NavigateTo(url, replace: true);
    }

    private async Task CopyLink()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Nav.Uri);
            _copyStatus = "Link copied";
            _copyFailed = false;
        }
        catch (JSException)
        {
            // Clipboard refused (no permission, not a secure context): show the link to copy by hand.
            _copyStatus = "Copy link";
            _copyFailed = true;
        }
    }

    // Persisted Argala where chart generation stored it (D1), else live — ArgalaFacts.ForChart,
    // the same source Astro Facts's ArgalaTable reads.
    private LifeMatterStatistics StatsFor(string chartType)
    {
        if (_statsByChart.TryGetValue(chartType, out var stats)) return stats;
        var chart = _data!.Charts[chartType];
        var argala = ArgalaFacts.ForChart(_argala, chartType, chart.AscendantSign, chart.Grahas);
        return _statsByChart[chartType] = new LifeMatterStatistics(chartType, chart.AscendantSign,
            _ashtakavarga, _bhavaBala, _shadbala, argala, _bhavaComponents, _amsabala);
    }

