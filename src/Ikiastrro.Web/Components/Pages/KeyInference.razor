                ? @<span class="lm-muted">@(chart.ChartType == "D1" ? "not computed" : "D1 only")</span>
                : @<span title="Bhava Dig + Drik only — Bhavadhipati Bala is the lord's own Ṣaḍbala, already under Capacity. Scored against this chart's 12 houses (50% = the chart's mean).">@Meter(LifeMatterStatistics.IndependentBhavaIndex(st.IndependentBhavaZ) ?? 0, 100, 50) @st.IndependentBhavaRupas.Value.ToString("0.00") rupas independent @Band(st.BhavaBand, "STRONG", "MOD", "WEAK") <span class="lm-muted">· total @(st.BhavaBalaRupas?.ToString("0.00") ?? "—")</span></span>,
            "Lord" => @<span>@st.LordPlanet@(st.LordShadbalaPercent is { } pct ? $" · Ṣaḍbala {pct:0}%" : "") @Band(st.LordShadbalaBand, "STRONG", "MOD", "WEAK")@(st.LordBavBindus is { } bav ? $" · BAV {bav}" : "") @Band(st.LordBavBand, "GOOD", "MID", "BAD")@(st.LordAmsabalaPercent is { } am ? $" · Amsabala {am}%" : "")</span>,
            "Kārakas" => st.Karakas.Count == 0 ? @<span class="lm-muted">none</span>
                : @<span>@string.Join(" · ", st.Karakas.Select(PlanetText))</span>,
            "Capacity" => Pct(st.Capacity, "Ṣaḍbala index (required minimum = 50%) of " + string.Join(", ", st.Planets.Select(PlanetText))),
            "Consistency" => Pct(st.Consistency, "Shodasavarga Amsabala of " + string.Join(", ", st.Planets.Select(PlanetText))),
            "Context" => Pct(st.Context, ContextBreakdown(st)),
            "Lord's dignity" => @<span>@(chart.Grahas.FirstOrDefault(g => g.Planet == st.LordPlanet)?.DignityStatus ?? "—") <span class="lm-muted">in @chart.ChartType</span></span>,
