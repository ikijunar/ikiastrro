        var st = item.Stats;
        return row switch
        {
            "Sign" => @<span>@DisplaySign(st.Sign) <span class="lm-muted">· H@(st.HouseFromLagna) from @chart.ChartType Lagna</span></span>,
            "SAV" => st.SavBindus is null ? @<span class="lm-muted">not computed</span>
