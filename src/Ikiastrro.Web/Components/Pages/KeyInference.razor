    /// <summary>The area's most-focused house(s) from Lagna across its matters (ties kept, ascending);
    /// house 1 when the area has no Lagna house focus at all.</summary>
    private IReadOnlyList<int> CoreHouses(string categoryCode)
    {
        var counts = StepsIn(categoryCode)
            .SelectMany(s => _resolved[s.LifeMatterId].HouseAndSpecialPointFoci)
            .Where(f => f.FocusKind == LifeMatterFocusKind.House && f.ReferenceCode == "LAGNA" && f.HouseNumber is not null)
            .GroupBy(f => f.HouseNumber!.Value)
            .Select(g => (House: g.Key, Count: g.Count()))
            .ToList();
        if (counts.Count == 0) return [1];
        var max = counts.Max(c => c.Count);
        return counts.Where(c => c.Count == max).Select(c => c.House).Order().ToList();
    }

