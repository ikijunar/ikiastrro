    private int _influenceIndex;     // which of the read's houses / special points
    private bool _influenceOnPada;   // the house's Āruḍha pada instead of the house

    private sealed record InfluenceTarget(string Label, string Sign, TargetInfluenceReading Reading);

    /// <summary>TargetInfluences for one item of a read: the house (or special point) sign, or with
    /// <paramref name="onPada"/> that house's Āruḍha pada in the same chart. Argala comes from the
    /// same statistics the strength % uses. Null when the chart lacks a planet's placement.</summary>
    private InfluenceTarget? Influences(SubRead? read, LoadedChart? chart, int index, bool onPada, LifeMatterStepRow? step)
    {
        if (read is null || chart is null || step is null || read.Items.Count == 0) return null;
        var item = read.Items[Math.Clamp(index, 0, read.Items.Count - 1)];
        var placements = new Dictionary<PlanetName, ZodiacName>();
        foreach (var g in chart.Grahas)
            if (Enum.TryParse<PlanetName>(g.Planet, out var planet) && Enum.TryParse<ZodiacName>(g.Sign, out var sign))
                placements[planet] = sign;
        if (placements.Count < 9 || !Enum.TryParse<ZodiacName>(item.Stats.Sign, out var target)) return null;

        var label = item.SpecialPoint ?? $"{Ordinal(item.House)} house";
        if (onPada && item.SpecialPoint is null)
        {
            var lord = Ikiastrro.Core.Engines.Karakas.StrongerCoLord.For(target, chart.ToAnalysisInput());
            target = Ikiastrro.Core.Engines.Karakas.ArudhaCalculator.PadaOf(target, placements[lord]);
            label = _question == "LAGNA"
                ? $"{(item.House == 1 ? "AL" : $"A{item.House}")}, the {Ordinal(item.House)}'s Āruḍha"
                : $"Āruḍha of the {Ordinal(item.House)}";
        }

        var karakas = KarakaPlanets(chart, step);
        var argala = StatsFor(chart.ChartType).ForSign(target.ToString(), karakas).Argala;
        var reading = TargetInfluences.Read(
            Enum.Parse<ZodiacName>(chart.AscendantSign), placements, target,
            Planets(karakas),
            Planets(argala.Pairs.Where(p => p.Verdict is ArgalaVerdict.Holds or ArgalaVerdict.Contested).SelectMany(p => p.ArgalaPlanets)),
            Planets(argala.Pairs.SelectMany(p => p.ObstructingPlanets)), MoonPhase.Of(chart.Grahas));
        return new InfluenceTarget(label, target.ToString(), reading);
    }

    private static IEnumerable<PlanetName> Planets(IEnumerable<string> names) =>
        names.Select(n => Enum.TryParse<PlanetName>(n, true, out var p) ? p : (PlanetName?)null)
            .Where(p => p is not null).Select(p => p!.Value).Distinct();

    private static string InfluenceRole(PlanetInfluence p)
    {
        var roles = new List<string>();
        if (p.IsLord) roles.Add("ruler");
        if (p.IsKaraka) roles.Add("kāraka");
        if (p.IsBaadhaka) roles.Add("bādhaka");
        if (p.InBaadhakaSthaana) roles.Add("in bādhaka sign");
        return roles.Count == 0 ? "—" : string.Join(", ", roles);
    }

