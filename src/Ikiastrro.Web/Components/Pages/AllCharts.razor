@page "/charts/{Id:int}/all-charts"
@inject BirthDetailsRepository BirthDetailsRepo
@inject ChartResultsRepository ChartResultsRepo
@inject ChartKeyDetailsRepository ChartKeyDetailsRepo
@inject ChartHouseLordsRepository ChartHouseLordsRepo
@inject ChartAspectsRepository ChartAspectsRepo
@inject ChartConjunctionsRepository ChartConjunctionsRepo
@inject ChartTypeRepository ChartTypeRepo
@inject LifeAreaReferenceRepository LifeAreaRepo
@inject SadeSatiRepository SadeSatiRepo
@inject IJSRuntime JS
@inject ReadingProfileState Profile
@using Ikiastrro.Web.Components.Workspace

@*
    "See all charts" gallery (2026-09-05, Workspace redesign; full-detail pass 2026-09-06) — every
    computed chart rendered with the same dense D1 template card the Workspace hero uses
    (TemplateChartCard → D1TemplateGrid), grouped by Life Area, so the whole set can be read at
    full detail in one scroll instead of one chart at a time through the Workspace hero. Each card
    still links into Workspace with that chart pre-selected (?area=&chart=). "Print / Save PDF"
    prints this same gallery, one chart per page, via css/print.css.
*@

<HeadContent>
    <link rel="stylesheet" href="css/print.css" media="print" />
</HeadContent>

<PageTitle>All charts — @(_data?.Person.Name ?? "Chart") — ikiastrro</PageTitle>

@if (_data is null || !_data.Charts.ContainsKey("D1"))
{
    <p class="ac-back"><a href="@($"/charts/{Id}")">← Workspace</a></p>
    <EmptyState Message="No D1 chart found for this person." />
}
else
{
    <div class="ac-nav">
        <a href="@($"/charts/{Id}")">← Workspace</a>
        <b>All charts</b>
        <button class="ac-profile-trigger" type="button" @onclick="() => _profileOpen = true">Reading profile <span>@Profile.Summary</span></button>
        <button type="button" class="ac-print" @onclick="Print">Print / Save PDF</button>
    </div>

    <WorkspaceHeader Person="_data.Person" D1="@(_data.Charts["D1"])" ComputationOpen="false"
                     OnToggleComputation="@((bool _) => { })" />

    @foreach (var (groupCode, title, codes) in VargaBundles.Groups(_data.ChartTypes, _lifeAreas))
    {
        <section class="ac-group">
            <h2>@title</h2>
            <div class="ac-list">
                @foreach (var code in codes)
                {
                    @if (_data.Charts.TryGetValue(code, out var lc))
                    {
                        <a class="ac-tile" href="@($"/charts/{Id}?area={Uri.EscapeDataString(groupCode)}&chart={Uri.EscapeDataString(code)}")">
                            <span class="ac-cap">@Caption(code)</span>
                            <TemplateChartCard Chart="lc" IsD1="@(code == "D1")"
                                               ShortDescription="@ShortDescriptionOf(code)"
                                               Rounds="@(code == "D1" ? _rounds : null)" BirthDate="_birthDate" />
                        </a>
                    }
                    else
                    {
                        <div class="ac-missing">
                            <EmptyState Message="@($"{code} not computed")" Cli="backfill-charts" />
                        </div>
                    }
                }
            </div>
        </section>
    }

    <ReadingProfileDrawer Profile="Profile" @bind-Open="_profileOpen" />
}

@code {
    [Parameter] public int Id { get; set; }

    private WorkspaceData? _data;

    /// <summary>tbl_Dim_LifeArea rows — drives the grouping and each tile's caption, same as
    /// VargaRail.</summary>
    private IReadOnlyList<LifeAreaRow> _lifeAreas = Array.Empty<LifeAreaRow>();

    /// <summary>The three Sade-Sati "Round" windows + birth instant — D1/Moon-specific, only used
    /// by the D1 card's centre cell (every varga card shows a Lagna line there instead).</summary>
    private IReadOnlyList<SadeSatiRounds.Round> _rounds = Array.Empty<SadeSatiRounds.Round>();
    private DateTime _birthDate;
    private bool _profileOpen;

    protected override void OnParametersSet()
    {
        _data = WorkspaceData.Load(Id, BirthDetailsRepo, ChartResultsRepo, ChartKeyDetailsRepo,
            ChartHouseLordsRepo, ChartAspectsRepo, ChartConjunctionsRepo, ChartTypeRepo.GetAll());
        if (_lifeAreas.Count == 0) _lifeAreas = LifeAreaRepo.GetAll();
        if (_data is null || !_data.Charts.ContainsKey("D1")) return;

        _birthDate = _data.Person.DateOfBirth.ToDateTime(_data.Person.EffectiveTimeOfBirth);
        _rounds = SadeSatiRounds.BuildRounds(SadeSatiRepo.GetByBirthDetailId(Id), _birthDate, DateTime.Now);
    }

    private async Task Print() => await JS.InvokeVoidAsync("window.print");

    private string? ShortDescriptionOf(string code) =>
        _data!.ChartTypes.FirstOrDefault(t => string.Equals(t.Code, code, StringComparison.OrdinalIgnoreCase))?.ChartShortDescription;

    /// <summary>"D9 · Marriage and spouse" — mirrors VargaRail.Caption.</summary>
    private string Caption(string code)
    {
        var areaName = _data!.ChartTypes.FirstOrDefault(t => string.Equals(t.Code, code, StringComparison.OrdinalIgnoreCase)) is { PrimaryLifeAreaId: int id }
            ? _lifeAreas.FirstOrDefault(a => a.Id == id)?.AreaName
            : null;
        return string.IsNullOrWhiteSpace(areaName) ? code : $"{code} · {areaName}";
    }
}
