        .Select(r => new SudarsanaChakra.Planet(r.Planet, r.LongitudeDegrees)).ToList();

    private IReadOnlyList<Natal_Transit_Comp_WheelChart.Point> TransitWheelPoints => _transits
        .Select(r => new Natal_Transit_Comp_WheelChart.Point(r.Planet.ToString(), r.LongitudeDegrees)).ToList();

    private IReadOnlyList<SadeSatiPeriod> _sadeSati = Array.Empty<SadeSatiPeriod>();

    /// <summary>The transiting planet's own D1 row (natal sign, degree, nakshatra, house, dignity)
    /// for the transit table's NATAL columns.</summary>
    private Ikiastrro.Data.Natal_Transit_Comp_WheelD1Row? NatalRow(PlanetTransitSnapshot s) =>
        _d1.FirstOrDefault(r => r.Planet.Equals(s.Planet.ToString(), StringComparison.OrdinalIgnoreCase));

    /// <summary>Saturn's phase from the natal Moon on the chosen transit date — the same
    /// GocharaReading.PhaseOf the Gochara table and the wheel use.</summary>
    private Ikiastrro.Core.Engines.Transits.SaturnPhase SaturnPhaseOnDate
    {
        get
        {
            var saturn = _transits.FirstOrDefault(t => t.Planet == PlanetName.Saturn);
            var moon = _natalSignByPlanet.GetValueOrDefault("Moon");
            var house = saturn is null ? null : Natal_Transit_Comp_WheelMath.HouseFromD1(moon, SignName(saturn.SignId));
            return house is { } h
                ? Ikiastrro.Core.Engines.Transits.GocharaReading.PhaseOf(h)
                : Ikiastrro.Core.Engines.Transits.SaturnPhase.None;
        }
    }

    private static string SignAbbrev(string? sign) => sign switch
    {
        null or "" => "—",
        "Capricornus" or "Capricorn" => "Cp",
        "Cancer" => "Cn",
        "Sagittarius" => "Sg",
        _ => sign[..2],
    };

    private IEnumerable<PlanetTransitSnapshot> TransitRows =>
        _transits.OrderBy(s => Natal_Transit_Comp_WheelMath.PlanetRank(s.Planet.ToString()));

    /// <summary>Houses between this graha's own natal sign and its current transit sign — how far
    /// it has moved from its own birth position (renamed from "House from D1" 2026-09-23; same
    /// calculation, clearer name now that "Planet in Natal House" below covers the Lagna-based
    /// reading).</summary>
    private int? HouseFromNatalPlanet(PlanetTransitSnapshot s) =>
        Natal_Transit_Comp_WheelMath.HouseFromD1(
            _natalSignByPlanet.GetValueOrDefault(s.Planet.ToString()), SignName(s.SignId));

    /// <summary>Which natal house (counted from the natal Lagna) this transiting planet is
    /// currently passing through — same sign-counting helper as <see cref="HouseFromNatalPlanet"/>,
    /// just anchored to the natal Ascendant instead of the planet's own natal sign.</summary>
    private int? PlanetInNatalHouse(PlanetTransitSnapshot s) =>
        Natal_Transit_Comp_WheelMath.HouseFromD1(
            _data?.Charts.GetValueOrDefault("D1")?.AscendantSign, SignName(s.SignId));

    /// <summary>The transits on the chosen date judged from the natal Moon (PVR ch.26.3 houses and
    /// Vedha), with each planet's own D1 BAV bindus in the sign it is crossing. Null without a
    /// natal Moon sign or transits.</summary>
    private Ikiastrro.Core.Engines.Transits.GocharaReadingResult? GocharaJudgement
    {
        get
        {
            if (_transits.Count == 0 || !Enum.TryParse<ZodiacName>(_natalSignByPlanet.GetValueOrDefault("Moon"), out var moon))
                return null;
            var signs = _transits.Where(t => t.SignId is >= 1 and <= 12)
                .GroupBy(t => t.Planet)
                .ToDictionary(g => g.Key, g => (ZodiacName)(g.First().SignId - 1));
            var bav = _ashtakavarga.Where(r => r.ChartType == "D1")
                .GroupBy(r => (r.RecipientCode.ToUpperInvariant(), (int)r.SignNumber))
                .ToDictionary(g => g.Key, g => (int)g.First().BinduCount);
            return Ikiastrro.Core.Engines.Transits.GocharaReading.Read(moon, signs, _vedhaRules,
                (planet, sign) => bav.TryGetValue((planet.ToString().ToUpperInvariant(), (int)sign + 1), out var b) ? b : null);
        }
    }

    /// <summary>The Gochara rows read as a whole (docs/architecture/transit_gochara_inference.md): net tiers, slow vs fast, and each slow planet's next crossing from the transit table.</summary>
    private Ikiastrro.Core.Engines.Transits.GocharaInference GocharaInferenceOf(Ikiastrro.Core.Engines.Transits.GocharaReadingResult reading)
    {
        var ingress = _transits
            .Where(t => Ikiastrro.Core.Engines.Transits.GocharaInferenceBuilder.SlowPlanets.Contains(t.Planet)
                        && t.NextChangeUtc is not null && t.NextChangeSignId is >= 1 and <= 12)
            .ToDictionary(t => t.Planet, t => new Ikiastrro.Core.Engines.Transits.GocharaIngress(
                DateTime.SpecifyKind(t.NextChangeUtc!.Value, DateTimeKind.Utc), (ZodiacName)(t.NextChangeSignId!.Value - 1),
                t.NextChangeMotion == "Retrograde"));
        return Ikiastrro.Core.Engines.Transits.GocharaInferenceBuilder.Build(reading, ingress, _vedhaRules, GocharaNatalFacts(), GocharaDashaOnDate());
    }

    /// <summary>The D1 facts a transit is qualified against: lagna, house lords, natal signs, and the
    /// Ṣaḍbala (planets) and independent Bhava Bala z-score (houses) bands Astro Facts step 3 shows.</summary>
    private Ikiastrro.Core.Engines.Transits.GocharaNatalContext? GocharaNatalFacts()
    {
        var d1 = _data?.Charts.GetValueOrDefault("D1");
        if (d1 is null || !TryZodiac(d1.AscendantSign, out var asc)) return null;
        var lords = d1.HouseLords
            .Where(h => Enum.TryParse<PlanetName>(h.LordPlanet, true, out _))
            .ToDictionary(h => h.HouseNumber, h => Enum.Parse<PlanetName>(h.LordPlanet, true));
        if (lords.Count != 12) return null;
        var signs = new Dictionary<PlanetName, ZodiacName>();
        foreach (var g in d1.Grahas)
            if (Enum.TryParse<PlanetName>(g.Planet, true, out var planet) && TryZodiac(g.Sign, out var sign)) signs[planet] = sign;
        var planetBands = new Dictionary<PlanetName, Ikiastrro.Core.Engines.Strength.StrengthTier>();
        foreach (var s in _shadbala)
            if (Enum.TryParse<PlanetName>(s.Planet, true, out var planet))
                planetBands[planet] = Ikiastrro.Core.Engines.Strength.StrengthBands.ShadbalaPercentOfMinimum.Classify(s.PercentOfMinimum);
        var rupas = Ikiastrro.Data.IndependentBhavaBala.RupasByHouse(_bhavaBalaComponents);
        var houseBands = new Dictionary<int, Ikiastrro.Core.Engines.Strength.StrengthTier>();
        if (rupas.Count >= 2)
        {
            var values = rupas.Values.Select(v => (double)v).ToList();
            var mean = values.Average();
            var sd = Math.Sqrt(values.Sum(v => (v - mean) * (v - mean)) / values.Count);
            foreach (var (house, value) in rupas)
                houseBands[house] = Ikiastrro.Core.Engines.Strength.StrengthBands.IndependentBhavaBalaZ.Classify(
                    sd == 0 ? 0m : (decimal)(((double)value - mean) / sd));
        }
        return new Ikiastrro.Core.Engines.Transits.GocharaNatalContext(asc, lords, signs, planetBands, houseBands);
    }

    private Ikiastrro.Core.Engines.Transits.GocharaDashaLords GocharaDashaOnDate() => new(
        DashaLord(_selection?.Maha), DashaLord(_selection?.Antar), DashaLord(_selection?.Pratyantar));

    private static PlanetName? DashaLord(Ikiastrro.Core.Engines.Dasha.DashaPeriodRecord? period) =>
        period is not null && Enum.TryParse<PlanetName>(period.Lord, true, out var lord) ? lord : null;

    private static bool TryZodiac(string? name, out ZodiacName sign) =>
        Enum.TryParse(string.Equals(name, "Capricorn", StringComparison.OrdinalIgnoreCase) ? "Capricornus" : name, true, out sign);

    private static string SignName(byte id) => id >= 1 && id <= 12 ? SignById[id] : "—";
}
