    /// <summary>Scorpio's and Aquarius's stronger co-lord in this chart (PVR sec.15.5.1), for the House lord placement
    /// table. Empty when the chart lacks any of the nine grahas.</summary>
    private static IReadOnlyDictionary<ZodiacName, Ikiastrro.Core.Engines.Karakas.CoLordReading> CoLordsOf(LoadedChart chart)
    {
        var result = new Dictionary<ZodiacName, Ikiastrro.Core.Engines.Karakas.CoLordReading>();
        if (chart.Grahas.Count(k => k.Planet != "Ascendant") < 9) return result;
        var input = chart.ToAnalysisInput();
        foreach (var sign in new[] { ZodiacName.Scorpio, ZodiacName.Aquarius })
            if (Ikiastrro.Core.Engines.Karakas.StrongerCoLord.Explain(sign, input) is { } reading) result[sign] = reading;
        return result;
    }

