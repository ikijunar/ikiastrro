    private static string PeriodStart(Ikiastrro.Core.Engines.Dasha.DashaPeriodRecord period) => SpanDate(period.StartDate, period.LevelNumber);

    private static string SpanDate(DateTime d, int level) => level >= 5 ? d.ToString("dd MMM yyyy HH:mm") : d.ToString("dd MMM yyyy");

    /// <summary>The chosen period's start and end, one per line, under its selector (the closed select only has room for the lord).</summary>
    private static RenderFragment SpanCaption(Ikiastrro.Core.Engines.Dasha.DashaPeriodRecord? p) => b =>
    {
        if (p is null) return;
        b.OpenElement(0, "small"); b.AddAttribute(1, "class", "ki-span");
        b.OpenElement(2, "span"); b.AddContent(3, "Start " + SpanDate(p.StartDate, p.LevelNumber)); b.CloseElement();
        b.OpenElement(4, "span"); b.AddContent(5, "End " + SpanDate(p.EndDate, p.LevelNumber)); b.CloseElement();
        b.CloseElement();
    };

    private static string PeriodDates(Ikiastrro.Core.Engines.Dasha.DashaPeriodRecord period) =>
        period.LevelNumber switch
        {
            <= 3 => $"{period.StartDate:MM/yyyy} – {period.EndDate:MM/yyyy}",
            4 => $"{period.StartDate:dd/MM/yyyy} – {period.EndDate:dd/MM/yyyy}",
            _ => $"{period.StartDate:dd/MM HH:mm} – {period.EndDate:dd/MM HH:mm}",
        };

