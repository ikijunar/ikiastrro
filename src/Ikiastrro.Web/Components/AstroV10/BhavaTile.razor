@using Ikiastrro.Core.Engines.Astronomy
@using Ikiastrro.Core.Engines.Strength
@using Ikiastrro.Web.Components.Charts
@* BhavaTile — one house as a small instrument. It always shows its number and sign; the rest depends on the layer the page is
   on, so a tile carries ONE fact at a time: Argala = the contest as a force meter with the winner in words; Strength = the SAV
   bindus of its sign and Bhava Bala; Yogas = how many yogas run through its lord. The whole tile is the button; the picked
   house is outlined. Built from ArgalaForceModel's HouseForce so it agrees with the Argala table and the chart. "bt" = BhavaTile. *@
<button type="button" class="bt @OutcomeCss @(Selected ? "bt-on" : "")" aria-pressed="@(Selected ? "true" : "false")"
        title="@Force.Reading.Headline" @onclick="() => OnPick.InvokeAsync(Force.House)">
    <span class="bt-num">@Force.House</span>
    <span class="bt-sign">@Short(Force.Sign)</span>
    @if (Layer == AfLayer.Argala)
    {
        <span class="bt-meter" aria-hidden="true"><span class="bt-meter-arg" style="width:@(Share)%"></span></span>
        <span class="bt-row"><span class="bt-word">@Word</span><span class="bt-score">@Force.ArgalaForce&ndash;@Force.VirodhargalaForce</span></span>
    }
    else if (Layer == AfLayer.Strength)
    {
        if (Strength is { } st && (st.SavBindus is not null || st.BhavaRupas is not null))
        {
            <span class="bt-str" title="@StrengthTitle(st)">
                @if (st.SavBindus is { } sav) { <span class="bt-pip bt-@TierCss(st.SavTier)">@sav<small> SAV</small></span> }
                @if (st.BhavaRupas is { } r) { <span class="bt-pip bt-@TierCss(st.BhavaTier)">@r.ToString("0.0")<small> r</small></span> }
            </span>
        }
    }
    else
    {
        <span class="bt-word">@(YogaCount == 0 ? "no yoga" : YogaCount + (YogaCount == 1 ? " yoga" : " yogas"))</span>
    }
</button>

@code {
    [Parameter, EditorRequired] public HouseForce Force { get; set; } = null!;
    [Parameter] public HouseStrength? Strength { get; set; }
    [Parameter] public AfLayer Layer { get; set; } = AfLayer.Argala;
    [Parameter] public int YogaCount { get; set; }
    [Parameter] public bool Selected { get; set; }
    [Parameter] public EventCallback<int> OnPick { get; set; }

    private int Share => ArgalaForceModel.ArgalaShare(Force);

    private string Word => Force.Outcome switch
    {
        ArgalaOutcome.ArgalaWins => "Argala",
        ArgalaOutcome.VirodhargalaWins => "Virodha",
        ArgalaOutcome.Tie => "Tie",
        ArgalaOutcome.Idle => "Idle",
        _ => "Quiet"
    };

    private string OutcomeCss => Layer != AfLayer.Argala ? "" : Force.Outcome switch
    {
        ArgalaOutcome.ArgalaWins => "bt-arg",
        ArgalaOutcome.VirodhargalaWins => "bt-vir",
        ArgalaOutcome.Tie => "bt-tie",
        _ => "bt-quiet"
    };

    private static string TierCss(StrengthTier t) => t switch
    {
        StrengthTier.Strong => "strong", StrengthTier.Weak => "weak", StrengthTier.Moderate => "mid", _ => "none"
    };

    private static string StrengthTitle(HouseStrength s) =>
        (s.SavBindus is { } v ? $"Sarvashtakavarga {v} bindus ({s.SavTier}). " : "") +
        (s.BhavaRupas is { } r ? $"Bhava Bala {r:0.0} rupas ({s.BhavaTier})." : "");

    private static string Short(ZodiacName sign) => (sign == ZodiacName.Capricornus ? "Capricorn" : sign.ToString())[..3];
}
