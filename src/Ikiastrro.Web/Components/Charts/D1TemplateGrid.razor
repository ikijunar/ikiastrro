@*
    Standalone dense South Indian D1 template grid — deliberately NOT a reskin of
    SouthIndianGrid.razor (kept separate per an explicit "new dedicated template" call,
    2026-09-05): this one packs more per cell (a karaka/special-point house-triplet row, whole-
    degree planet lines each ending in a Dg(±N) dignity score, an "ASP:" row, an upagraha row) and
    its own light "chart card" palette
    (--tmpl-* custom properties, read via var(...) the same cross-scope way SouthIndianGrid reads
    --paper/--ink — see its own doc comment) instead of the app's dark theme.

    The fixed 12-cell sign layout below is intentionally a small duplicate of SouthIndianGrid's
    own GridCells table — stable, unlikely to ever change, and duplicating 12 lines here is
    cheaper than coupling two otherwise-unrelated components.

    The "Ras(L)"/"Hor(L)" header tags and their house-triplet boxes are this component's one
    best-guess element (see the design spec's Open decisions) — confirm against the reference
    image once rendered and adjust if the intent was different.

    Ras(L) gets its own dark-orange highlight in light theme (2026-09-05, rammyps's call) — Hor(L)
    keeps the shared maroon banner both tags used before. See .thead-rashi in this component's .css
    and --tmpl-rashi-highlight in SouthIndianTemplate.razor.css.

    Per-cell house-number badges (2026-09-05, rammyps's call): each cell also shows its house
    counted from the Sun and from the Moon, next to the sign name — the same
    AstroMath.CountFromSignToSign two-axis idea SouthIndianGrid already uses for Lagna/Moon, just
    with Sun instead of Lagna as the first axis (this template shows Lagna/Moon house counts
    separately already, in the Ras(L)/Hor(L) points row above).
*@
@using Ikiastrro.Core.Engines.Astronomy
<div class="tmpl-chart">
    @foreach (var cell in GridCells)
    {
        var isAscendant = cell.MatchSign == AscendantSign;
        var points = PointsBySign.TryGetValue(cell.MatchSign, out var pts) ? pts : Array.Empty<TemplatePointLine>();
        var planets = PlanetsBySign.TryGetValue(cell.MatchSign, out var pls) ? pls : Array.Empty<TemplatePlanetLine>();
        var upagrahas = UpagrahasBySign.TryGetValue(cell.MatchSign, out var ug) ? ug : Array.Empty<string>();
        var aspects = AspectsBySign.TryGetValue(cell.MatchSign, out var asp) ? asp : Array.Empty<string>();
        var cellSign = Enum.Parse<ZodiacName>(cell.MatchSign);
        var houseFromSun = AstroMath.CountFromSignToSign(Enum.Parse<ZodiacName>(SunSign), cellSign);
        var houseFromMoon = AstroMath.CountFromSignToSign(Enum.Parse<ZodiacName>(MoonSign), cellSign);

        <div class="tcell @(isAscendant ? "asc" : "")" style="grid-column:@cell.Col;grid-row:@cell.Row;">
            @if (cell.Col == 1 && cell.Row == 1) { <div class="thead thead-rashi">Ras(L)</div> }
            @if (cell.Col == 2 && cell.Row == 1) { <div class="thead">Hor(L)</div> }

            @if (points.Count > 0)
            {
                <div class="tpoints">
                    @foreach (var p in points)
                    {
                        <span class="tpoint"><b class="lagna">@p.HouseFromLagna</b> @p.Code <b class="moon">@p.HouseFromMoon</b></span>
                    }
                </div>
            }

            <div class="tsign">
                @cell.DisplayEn
                <span class="thousenums">
                    <span class="thouse-num from-sun" title="House @houseFromSun from the Sun">@houseFromSun</span>
                    <span class="thouse-num from-moon" title="House @houseFromMoon from the Moon">@houseFromMoon</span>
                </span>
            </div>
            @if (isAscendant) { <div class="tasc">Asc</div> }

            @if (planets.Count > 0)
            {
                <div class="tplanets">
                    @foreach (var p in planets)
                    {
                        <span class="tplanet">
                            <span class="pglyph" style="color:var(--tmpl-planet-@(p.Key))">@(p.IsRetrograde ? $"({p.Glyph})" : p.Glyph)</span>
                            +@p.DegreesInSign@(p.IsCombust ? " 🔥" : "") <span class="tdignity">Dg(@(p.DignityScore > 0 ? "+" : "")@p.DignityScore)</span>
                        </span>
                    }
                </div>
            }

            @if (upagrahas.Count > 0)
            {
                <div class="tupagraha">@string.Join(" · ", upagrahas)</div>
            }

            @if (aspects.Count > 0)
            {
                <div class="tasp">ASP: @string.Join(",", aspects)</div>
            }
        </div>
    }

    <div class="tcell center" style="grid-column:2/4;grid-row:2/4;">
        @CenterContent
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string AscendantSign { get; set; } = "";

    /// <summary>This chart's own natal Sun sign (internal ZodiacName spelling) — drives the "from
    /// Sun" half of each cell's house-number badge pair (2026-09-05, rammyps's call).</summary>
    [Parameter, EditorRequired] public string SunSign { get; set; } = "";

    /// <summary>This chart's own natal Moon sign — drives the "from Moon" half of each cell's
    /// house-number badge pair. Distinct from PointsBySign's own HouseFromMoon (that one is
    /// per karaka/special-point; this one is per sign cell, shown next to the sign name).</summary>
    [Parameter, EditorRequired] public string MoonSign { get; set; } = "";

    [Parameter, EditorRequired]
    public IReadOnlyDictionary<string, IReadOnlyList<TemplatePlanetLine>> PlanetsBySign { get; set; }
        = new Dictionary<string, IReadOnlyList<TemplatePlanetLine>>();

    /// <summary>Ras(L)/Hor(L) row content: chara-karaka-bearing grahas + special-lagna points
    /// (AL/A2..A12/HL) in that sign — see D1TemplateCellData.TemplatePointLine.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyDictionary<string, IReadOnlyList<TemplatePointLine>> PointsBySign { get; set; }
        = new Dictionary<string, IReadOnlyList<TemplatePointLine>>();

    /// <summary>"ASP:" row content — plain "Ju-3" style labels (ChartViewModel.BuildAspectedByPlain).</summary>
    [Parameter, EditorRequired]
    public IReadOnlyDictionary<string, IReadOnlyList<string>> AspectsBySign { get; set; }
        = new Dictionary<string, IReadOnlyList<string>>();

    /// <summary>Upagraha row content — plain codes ("Gk"/"Md" today; laid out so the other 9
    /// classical upagrahas can be added later without a redesign).</summary>
    [Parameter] public IReadOnlyDictionary<string, IReadOnlyList<string>> UpagrahasBySign { get; set; }
        = new Dictionary<string, IReadOnlyList<string>>();

    [Parameter, EditorRequired] public RenderFragment CenterContent { get; set; } = null!;

    private static readonly (string MatchSign, string DisplayEn, int Col, int Row)[] GridCells = new[]
    {
        ("Pisces", "Pisces", 1, 1), ("Aries", "Aries", 2, 1),
        ("Taurus", "Taurus", 3, 1), ("Gemini", "Gemini", 4, 1),
        ("Aquarius", "Aquarius", 1, 2), ("Cancer", "Cancer", 4, 2),
        ("Capricornus", "Capricorn", 1, 3), ("Leo", "Leo", 4, 3),
        ("Sagittarius", "Sagittarius", 1, 4), ("Scorpio", "Scorpio", 2, 4),
        ("Libra", "Libra", 3, 4), ("Virgo", "Virgo", 4, 4)
    };
}
