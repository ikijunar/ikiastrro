@using Direction = Ikiastrro.Core.LifeMatters.Promise.Direction
@using Ikiastrro.Core.Engines.Astronomy
@using Ikiastrro.Core.Engines.Houses
@using Ikiastrro.Core.LifeMatters.Promise
@using Ikiastrro.Core.Presentation
@using static Ikiastrro.Core.Engines.Houses.ArgalaCalculator
@* Argala / Virodhargala — PVR sec.10.5-10.6 (SRC_PVR_INTEGRATED), pp.104-107. One row per house
   (Exercise 16's own scope), same 8-position shape as the book's own worked table for Chart 5
   (docs/research/domain/argala-virodhargala-drishti-lifematters.md §4): 2nd/4th/11th/5th cause
   argala, 12th/10th/3rd/9th obstruct it (virodhargala). Reads house-target tbl_Fact_Argala rows
   via ArgalaFacts.ForChart — the same rows Key Inference reads, so the two pages cannot disagree;
   stored for D1 by ChartGenerationService, computed live (same ArgalaFactBuilder) for a varga.
   Grahas supplies only the dignity tie-break for the Net column (sec.10.7). SignificanceNotes (tbl_Rule_Argala,
   migration 129) surface as header tooltips on the 4 argala columns; the 4 virodhargala columns
   have no PVR gloss to show. Cell/badge markup is written as literal Razor elements (not
   MarkupString) so Blazor's CSS-isolation scope attribute actually lands on them — a MarkupString
   is raw injected HTML and never gets the scope, so `.at-net`/`.at-exception` silently failed to
   style anything the first time this was built. "at" = ArgalaTable. *@
@if (Grahas.Count == 0)
{
    <EmptyState Message="No Argala/Virodhargala data — D1 positions not available." />
}
else
{
    <div class="at-scroll">
        <table class="at">
            <thead>
                <tr>
                    <th rowspan="2">House</th>
                    <th rowspan="2">Sign</th>
                    <th rowspan="2">Net</th>
                    <th rowspan="2" title="Benefic or malefic for this lagna (functional nature; Rahu/Ketu malefic) — the same reading D1-Promise uses for subhaargala / paapaargala">Nature</th>
                    <th colspan="4">Argala</th>
                    <th colspan="4">Virodhargala</th>
                </tr>
                <tr>
                    @foreach (var offset in ArgalaOffsetOrder)
                    {
                        <th class="at-offset" title="@SignificanceNotes.GetValueOrDefault(offset)">@Ordinal(offset)<span class="at-role">@ArgalaPositionRole.Label(offset)</span></th>
                    }
                    @foreach (var offset in VirodhargalaOffsetOrder)
                    {
                        <th class="at-offset">@Ordinal(offset)</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Rows)
                {
                    <tr>
                        <td class="mono">@row.HouseNumber@(row.CountedAntiZodiacally ? "*" : "")</td>
                        <td>@Disp(row.Sign)</td>
                        <td>
                            <span class="at-net @NetCss(row.Compare)">@NetLabel(row.Compare) @row.Compare.ArgalaCount&ndash;@row.Compare.VirodhargalaCount</span>
                        </td>
                        <td>
                            <span class="at-nat @NatureCss(row.Nature)">@NatureLabel(row.Nature)</span>
                        </td>
                        @foreach (var offset in ArgalaOffsetOrder)
                        {
                            var occupants = row.Occupants(offset);
                            <td>
                                @if (occupants.Count == 0)
                                {
                                    <text>—</text>
                                }
                                else
                                {
                                    @for (var i = 0; i < occupants.Count; i++)
                                    {
                                        var d = D1PromiseEngine.NatureDirection(ascendant, occupants[i], moonWaxing);
                                        <span class="at-p @PlanetCss(d)" title="@PlanetTitle(d)">@occupants[i]</span>@(i < occupants.Count - 1 ? ", " : "")
                                    }
                                    var argalaHouse = (row.HouseNumber + offset - 2) % 12 + 1;
                                    <span class="at-house" title="Argala planets stand in house @argalaHouse from lagna">H@argalaHouse@(HouseMatters.TryGetValue(argalaHouse, out var matters) ? " · " + matters : "")</span>
                                }
                            </td>
                        }
                        @foreach (var offset in VirodhargalaOffsetOrder)
                        {
                            var occupants = row.Occupants(offset);
                            <td>
                                @if (occupants.Count == 0)
                                {
                                    <text>—</text>
                                }
                                else
                                {
                                    @string.Join(", ", occupants)
                                    @if (offset == 3 && row.ThirdHouseExceptionApplied)
                                    {
                                        <span class="at-exception" title="2+ malefics here act as argala, not virodhargala (sec.10.6 exception)">&rarr;arg</span>
                                    }
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Rows.Any(r => r.CountedAntiZodiacally))
    {
        <p class="at-footnote">* Ketu occupies this house's sign — argala/virodhargala counted anti-zodiacally (sec.10.6 note).</p>
    }
}

@code {
    /// <summary>House-target Argala rows for this chart — pass <see cref="ArgalaFacts.ForChart"/>'s result.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<ArgalaFactRow> Facts { get; set; } = Array.Empty<ArgalaFactRow>();
    [Parameter, EditorRequired] public IReadOnlyList<ChartKeyDetail> Grahas { get; set; } = Array.Empty<ChartKeyDetail>();
    [Parameter, EditorRequired] public string AscendantSign { get; set; } = "";
    /// <summary>House number → its leading matters (PVR ch. 7), shown under the planets causing argala.</summary>
    [Parameter] public IReadOnlyDictionary<int, string> HouseMatters { get; set; } = new Dictionary<int, string>();
    [Parameter] public IReadOnlyDictionary<int, string> SignificanceNotes { get; set; } = new Dictionary<int, string>();

    private static readonly int[] ArgalaOffsetOrder = { 2, 4, 11, 5 };
    private static readonly int[] VirodhargalaOffsetOrder = { 12, 10, 3, 9 };

    private sealed record HouseRow(int HouseNumber, ZodiacName Sign, IReadOnlyList<ArgalaFactRow> Facts,
        ComparisonResult Compare, bool ThirdHouseExceptionApplied, bool CountedAntiZodiacally, Direction Nature)
    {
        /// <summary>Occupants at an offset regardless of side — the sec.10.6 exception stores the
        /// 3rd-from position as ARGALA, so a fixed "3rd" column has to check both.</summary>
        public IReadOnlyList<PlanetName> Occupants(int offset) => Planets(Facts.Where(f => f.HouseOffset == offset));
    }

    private IReadOnlyList<HouseRow> Rows => BuildRows();
    private ZodiacName ascendant => Enum.Parse<ZodiacName>(AscendantSign);
    private bool? moonWaxing => MoonPhase.Of(Grahas);

    /// <summary>Subhaargala vs paapaargala, as D1-Promise counts it: benefic planets against malefic
    /// planets among those causing argala on the house.</summary>
    private static Direction ArgalaNature(ZodiacName lagna, IReadOnlyList<PlanetName> planets, bool? moonWaxing)
    {
        var good = planets.Count(p => D1PromiseEngine.NatureDirection(lagna, p, moonWaxing) == Direction.Supportive);
        var bad = planets.Count(p => D1PromiseEngine.NatureDirection(lagna, p, moonWaxing) == Direction.Obstructive);
        return planets.Count == 0 ? Direction.Neutral : good > bad ? Direction.Supportive
            : bad > good ? Direction.Obstructive : good > 0 ? Direction.Mixed : Direction.Neutral;
    }

    private static string NatureLabel(Direction d) => d switch
    {
        Direction.Supportive => "Subha (benefic)",
        Direction.Obstructive => "Paapa (malefic)",
        Direction.Mixed => "Mixed",
        _ => "—"
    };
    private static string NatureCss(Direction d) => d switch
    {
        Direction.Supportive => "at-nat-good", Direction.Obstructive => "at-nat-bad", Direction.Mixed => "at-nat-mixed", _ => "at-nat-none"
    };
    private static string PlanetCss(Direction d) => d switch
    {
        Direction.Supportive => "at-p-good", Direction.Obstructive => "at-p-bad", _ => ""
    };
    private static string PlanetTitle(Direction d) => d switch
    {
        Direction.Supportive => "Benefic for this lagna", Direction.Obstructive => "Malefic for this lagna", _ => "Neutral for this lagna"
    };

    private List<HouseRow> BuildRows()
    {
        var factsByHouse = Facts.Where(f => f.TargetKind == "House").ToLookup(f => (int)f.TargetHouseNumber);
        var dignityByPlanet = Grahas
            .Where(k => k.Planet != "Ascendant" && Enum.TryParse<PlanetName>(k.Planet, out _))
            .ToDictionary(k => Enum.Parse<PlanetName>(k.Planet), k => k.DignityStatus);

        var rows = new List<HouseRow>();
        for (var house = 1; house <= 12; house++)
        {
            var facts = factsByHouse[house].ToList();
            var compare = Compare(
                Planets(facts.Where(f => f.RelationTypeCode == "ARGALA")),
                Planets(facts.Where(f => f.RelationTypeCode == "VIRODHARGALA")),
                p => ChartViewModel.DignityScore(dignityByPlanet.GetValueOrDefault(p)));
            rows.Add(new HouseRow(house, HouseEngine.GetHouseSign(ascendant, house), facts, compare,
                facts.Any(f => f.ExceptionApplied), facts.Any(f => f.CountedAntiZodiacally),
                ArgalaNature(ascendant, Planets(facts.Where(f => f.RelationTypeCode == "ARGALA")), moonWaxing)));
        }
        return rows;
    }

    private static IReadOnlyList<PlanetName> Planets(IEnumerable<ArgalaFactRow> facts) =>
        facts.Select(f => Enum.Parse<PlanetName>(f.OccupantPlanet)).OrderBy(p => p).ToList();

    private static string NetLabel(ComparisonResult compare) => compare.Dominant switch
    {
        RelationType.Argala => "Argala",
        RelationType.Virodhargala => "Virodhargala",
        _ => "Tie"
    };

    private static string NetCss(ComparisonResult compare) => compare.Dominant switch
    {
        RelationType.Argala => "at-net-argala",
        RelationType.Virodhargala => "at-net-virodh",
        _ => "at-net-tie"
    };

    private static string Ordinal(int offset) => offset switch
    {
        2 => "2nd", 3 => "3rd", 4 => "4th", 5 => "5th",
        9 => "9th", 10 => "10th", 11 => "11th", 12 => "12th",
        _ => offset.ToString()
    };

    private static string Disp(ZodiacName sign) => sign == ZodiacName.Capricornus ? "Capricorn" : sign.ToString();
}
