@using System.Globalization
@using Ikiastrro.Data
@using Ikiastrro.Core.Engines.Astronomy
@using Ikiastrro.Core.Engines.Strength
@using Ikiastrro.Core.Engines.Yoga

<section class="yg" aria-labelledby="yg-title">
    @* Summary card (rammyps, 2026-10-02): the present yogas split by OutcomeNatureCode (migration
       159). A tile filters the table below to that nature; clicking it again clears the filter. *@
    <article class="yg-card yg-summary" aria-labelledby="yg-summary-title">
        <header class="yg-card-head">
            <h2 id="yg-summary-title">Yoga Summary</h2>
            <p>@PresentCount present of @EvaluatedCount evaluated · @NotEvaluatedCount pending · @VariantRows.Count catalogued variants</p>
        </header>
        <div class="yg-tiles">
            @foreach (var (nc, label) in NatureTiles)
            {
                var count = PresentByNature(nc);
                <button type="button" class="yg-tile yg-tile-@nc.ToLowerInvariant() @(_nature == nc ? "is-on" : null)"
                        aria-pressed="@(_nature == nc ? "true" : "false")" @onclick="() => ToggleNature(nc)">
                    <b>@count</b>
                    <span>@label</span>
                    <small>@(PresentCount == 0 ? 0 : (int)Math.Round(100.0 * count / PresentCount))% of present</small>
                </button>
            }
        </div>
        @if (PresentCount > 0)
        {
            <span class="yg-split" aria-hidden="true">
                @foreach (var (nc, _) in NatureTiles)
                {
                    var count = PresentByNature(nc);
                    @if (count > 0)
                    {
                        <i class="yg-nature-@nc.ToLowerInvariant()" style="flex:@count"></i>
                    }
                }
            </span>
        }
    </article>

    <article class="yg-card">
        <header class="yg-card-head">
            <div>
                <h2 id="yg-title">Yogas Present</h2>
                <p>@DisplayRows.Count shown@(_nature is { } n ? $" · {NatureTiles.First(t => t.Code == n).Label} only" : "")</p>
            </div>
        </header>
        @if (Vargas.Count > 1)
        {
            @* JHora's Yogas list is per-varga (right-click > Select a varga); same here, over the charts its rules
               name. D1 carries the full source-attributed set; the others are single-chart geometry rules only. *@
            <div class="yg-vargas" role="group" aria-label="Yogas in divisional chart">
                @foreach (var v in Vargas)
                {
                    <button type="button" class="yg-varga @(v == Varga ? "is-on" : null)" aria-pressed="@(v == Varga ? "true" : "false")"
                            @onclick="() => SelectVarga(v)">@VargaLabel(v)</button>
                }
            </div>
            @if (Varga != "D1")
            {
                <p class="yg-varga-note">@VargaLabel(Varga): single-chart yoga rules read off this divisional chart, with the planets taken from it. Ṣaḍbala is the natal (D1) strength. Rules that need birth-level inputs or several charts are listed under D1.</p>
            }
        }
        <div class="yg-controls" aria-label="Yoga filters">
            <label class="yg-toggle">
                <input type="checkbox" @bind="_showAll" />
                <span>Show all evaluated variants</span>
            </label>
        </div>
        @if (DisplayRows.Count == 0)
        {
            <p class="yg-empty">@(Rows.Count == 0 && Varga != "D1"
                ? $"No yogas are stored for {VargaLabel(Varga)} yet — run refresh-yogas <name> --vargas."
                : "No yoga variants match the current filters.")</p>
        }
        else
        {
            <div class="yg-table-scroll">
                <table>
                    <thead>
                        <tr>
                            @foreach (var col in VisibleColumns)
                            {
                                <th aria-sort="@AriaSort(col)">
                                    <button type="button" class="yg-sort @(_sortKey == col ? "on" : "")" @onclick="() => SortBy(col)">
                                        @ColumnHeader(col)
                                        <span class="yg-arrow">@(_sortKey == col ? (_desc ? "▼" : "▲") : "")</span>
                                    </button>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{ string? lastSet = null; var span = VisibleColumns.Count(); }
                        @foreach (var r in DisplayRows)
                        {
                            var set = SetOf(r);
                            @if (set != lastSet)
                            {
                                lastSet = set;
                                <tr class="yg-group"><th colspan="@span" scope="colgroup">@set <small>@DisplayRows.Count(x => SetOf(x) == set)</small></th></tr>
                            }
                            <tr>
                                <td>@DisplayYoga(r.YogaCode)</td>
                                <td>@BasedLabel(r)</td>
                                <td><span class="yg-nature yg-nature-@NatureClass(r)">@NatureLabel(r)</span></td>
                                @if (_showAll)
                                {
                                    <td><span class="yg-status yg-status-@StatusClass(r)">@StatusLabel(r)</span></td>
                                }
                                <td class="yg-strength">
                                    @{ var causing = PlanetsOf(r); }
                                    @if (causing.Count == 0)
                                    {
                                        <span class="yg-interp-empty">—</span>
                                    }
                                    else
                                    {
                                        @foreach (var planet in causing)
                                        {
                                            var row = StrengthOf(planet);
                                            <div class="yg-pstrength yg-tier-@TierOf(row).ToString().ToLowerInvariant()"
                                                 title="@StrengthTitle(planet, row)">
                                                <b>@planet</b>
                                                <span>@(row?.PercentOfMinimum is { } pct ? $"{pct:0}%" : "—")</span>
                                            </div>
                                        }
                                    }
                                </td>
                                <td>
                                    @(r.YogaRule ?? "—")
                                    @if (!string.IsNullOrWhiteSpace(r.Notes))
                                    {
                                        <div class="yg-notes">@r.Notes</div>
                                    }
                                </td>
                                <td class="yg-variants">
                                    @foreach (var m in SourcesOf(r))
                                    {
                                        <div><b>@VariantName(m)</b> <small>@DisplaySource(m.SourceRefCode)</small></div>
                                    }
                                </td>
                                <td class="yg-inference">
                                    @if (!string.IsNullOrWhiteSpace(r.InferenceText))
                                    {
                                        @r.InferenceText
                                        @if (!string.IsNullOrWhiteSpace(r.InferenceSourceRefCode))
                                        {
                                            <small>@DisplaySource(r.InferenceSourceRefCode)@(string.IsNullOrWhiteSpace(r.InferenceSourceLocator) ? "" : $", {r.InferenceSourceLocator}")</small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="yg-interp-empty">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </article>

    <PlainWords Lines="SummaryLines" Title="Yogas in plain words" />
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<YogaEvaluationRow> Rows { get; set; } = Array.Empty<YogaEvaluationRow>();
    /// <summary>House number to its lord, D1 — resolves "Lagna lord", "5th lord" ... in a yoga's rule to a planet.</summary>
    [Parameter] public IReadOnlyDictionary<int, PlanetName> HouseLords { get; set; } = new Dictionary<int, PlanetName>();
    /// <summary>Each graha's house from Lagna, Sun and Moon, for the yogas read from the Sun or Moon.</summary>
    [Parameter] public IReadOnlyDictionary<PlanetName, YogaPlacement> Placements { get; set; } = new Dictionary<PlanetName, YogaPlacement>();
    /// <summary>Ṣaḍbala per planet; its % of the required minimum is each planet's strength here.</summary>
    [Parameter] public IReadOnlyList<ShadbalaSummaryRow> Shadbala { get; set; } = Array.Empty<ShadbalaSummaryRow>();
    /// <summary>The divisional chart the rows were evaluated on (D1 unless a varga is selected).</summary>
    [Parameter] public string Varga { get; set; } = "D1";
    /// <summary>Charts offered in the selector; hidden when there is only one.</summary>
    [Parameter] public IReadOnlyList<string> Vargas { get; set; } = Array.Empty<string>();
    [Parameter] public EventCallback<string> OnVargaChanged { get; set; }
    private IReadOnlyList<string> SummaryLines => YogaSummary.Build(VariantRows.Where(r => r.Present != true).Concat(PresentYogas).Select(r =>
    {
        var planets = PlanetsOf(r);
        var weakest = WeakestPercent(r);
        return new YogaFact(DisplayYoga(r.YogaCode), r.OutcomeNatureCode, r.YogaTypeCode is null ? null : BasedLabel(r),
            r.Present == true, planets.Select(p => p.ToString()).ToList(), weakest == double.MaxValue ? null : (decimal)weakest);
    }).ToList());

    private static readonly Dictionary<string, string> VargaNames = new()
    {
        ["D1"] = "Rasi", ["D2"] = "Hora", ["D3"] = "Drekkana", ["D9"] = "Navamsa", ["D12"] = "Dwadasamsa", ["D30"] = "Trimsamsa",
    };

    private static string VargaLabel(string code) => VargaNames.TryGetValue(code, out var n) ? $"{code} {n}" : code;


    private async Task SelectVarga(string code)
    {
        if (code == Varga) return;
        _nature = null;
        await OnVargaChanged.InvokeAsync(code);
    }

    private bool _showAll;
    private IReadOnlyList<YogaEvaluationRow> VariantRows => Rows
        .GroupBy(r => (r.SourceRefCode, r.SourceVariantCode))
        .Select(g => g.First()).ToList();

    // One yoga is often catalogued several times (PVR ch.11 and Raman 300 both list Adhi; Daridra has seven
    // variants) with the same rule, inference and nature, so a present yoga would repeat as identical rows.
    // Present yogas are therefore counted and listed once per YogaCode (and chart); the source cell lists every
    // catalogue entry behind it. "Show all evaluated variants" lifts the collapse.
    private IReadOnlyList<YogaEvaluationRow> PresentYogas => VariantRows
        .Where(r => r.Present == true)
        .GroupBy(r => r.YogaCode)
        .Select(g => g.OrderBy(r => r.SourceRefCode).ThenBy(r => r.SourceVariantCode).First()).ToList();

    private IReadOnlyList<YogaEvaluationRow> SourcesOf(YogaEvaluationRow r) => _showAll || r.Present != true
        ? new[] { r }
        : VariantRows.Where(x => x.Present == true && x.YogaCode == r.YogaCode)
            .OrderBy(x => x.SourceRefCode).ThenBy(x => x.SourceVariantCode).ToList();

    // rammyps's requested default order: Lagna, Sun, Moon, Combination first, any other
    // YogaTypeCode that shows up later follows alphabetically after those four.
    private static readonly string[] TypeOrder = { "LAGNA", "SUN", "MOON", "COMBINATION" };

    private static int TypeRank(string? type)
    {
        var i = Array.IndexOf(TypeOrder, type?.ToUpperInvariant() ?? string.Empty);
        return i < 0 ? TypeOrder.Length : i;
    }

    // Every column sorts on its header; before any click the rows keep the Set → type → variant
    // order above. Status only shows when "Show all" lets absent/pending rows in — otherwise every
    // row is Present by the filter itself.
    private enum Col { Yoga, Based, Nature, Status, Strength, Rule, Variants, Inference }

    private static string BasedLabel(YogaEvaluationRow r) => r.YogaTypeCode?.ToUpperInvariant() switch
    {
        "SUN" => "Sun based",
        "MOON" => "Moon based",
        "LAGNA" => "Lagna based",
        "COMBINATION" => "Combination",
        _ => "—",
    };

    // The planets that make the yoga, and each one's Ṣaḍbala — only for yogas present in this chart.
    private IReadOnlyList<PlanetName> PlanetsOf(YogaEvaluationRow r) => r.Present == true
        ? YogaPlanetResolver.Resolve(r.YogaCode, r.YogaRule, HouseLords, Placements)
        : Array.Empty<PlanetName>();

    private ShadbalaSummaryRow? StrengthOf(PlanetName planet)
        => Shadbala.FirstOrDefault(s => s.Planet.Equals(planet.ToString(), StringComparison.OrdinalIgnoreCase));

    private static StrengthTier TierOf(ShadbalaSummaryRow? row)
        => StrengthBands.ShadbalaPercentOfMinimum.Classify(row?.PercentOfMinimum);

    private static string StrengthTitle(PlanetName planet, ShadbalaSummaryRow? row) => row is null
        ? $"{planet}: Ṣaḍbala not computed"
        : row.PercentOfMinimum is null
            ? $"{planet}: {row.ShadbalaRupas:0.00} rūpas, no required minimum on file"
            : $"{planet}: {row.ShadbalaRupas:0.00} rūpas, {row.PercentOfMinimum:0}% of its required minimum ({TierOf(row)})";

    // Weakest planet's % — the yoga is only as strong as its weakest cause. Yogas without planets sort last.
    private double WeakestPercent(YogaEvaluationRow r)
    {
        var values = PlanetsOf(r).Select(p => StrengthOf(p)?.PercentOfMinimum).Where(v => v.HasValue).Select(v => (double)v!.Value).ToList();
        return values.Count == 0 ? double.MaxValue : values.Min();
    }

    private Col? _sortKey;
    private bool _desc;

    private IEnumerable<Col> VisibleColumns => Enum.GetValues<Col>().Where(c => c != Col.Status || _showAll);

    private static string ColumnHeader(Col c) => c switch
    {
        Col.Based => "Based on",
        Col.Nature => "Good / Bad",
        Col.Strength => "Planet strength (Ṣaḍbala)",
        _ => c.ToString(),
    };

    private void SortBy(Col c)
    {
        if (_sortKey == c) _desc = !_desc;
        else { _sortKey = c; _desc = false; }
    }

    private string AriaSort(Col c) => _sortKey != c ? "none" : _desc ? "descending" : "ascending";

    private IComparable SortValue(YogaEvaluationRow r, Col c) => c switch
    {
        Col.Yoga => DisplayYoga(r.YogaCode),
        Col.Based => TypeRank(r.YogaTypeCode),
        Col.Nature => NatureRank(r.OutcomeNatureCode),
        Col.Status => StatusLabel(r),
        Col.Strength => WeakestPercent(r),
        Col.Rule => r.YogaRule ?? "",
        Col.Variants => SourcesOf(r).Count,
        Col.Inference => r.InferenceText ?? "",
        _ => "",
    };

    private IReadOnlyList<YogaEvaluationRow> DisplayRows
    {
        get
        {
            var rows = (_showAll ? VariantRows : PresentYogas)
                .Where(r => _showAll || r.Present == true)
                .Where(r => _nature is null || (r.OutcomeNatureCode ?? "") == _nature);
            if (_sortKey is not { } key)
                return rows.OrderBy(SetOf).ThenBy(r => TypeRank(r.YogaTypeCode)).ThenBy(r => DisplayYoga(r.YogaCode)).ToList();
            // Rows stay grouped under their Set; the clicked column sorts within each set.
            var ordered = rows.OrderBy(SetOf);
            ordered = _desc ? ordered.ThenByDescending(r => SortValue(r, key)) : ordered.ThenBy(r => SortValue(r, key));
            return ordered.ThenBy(r => DisplayYoga(r.YogaCode)).ToList();
        }
    }

    // tbl_Rule_Yoga.OutcomeNatureCode (migration 159): good first, bad last.
    private static int NatureRank(string? code) => code switch
    {
        "AUSPICIOUS" => 0,
        "MIXED" => 1,
        "CONTEXTUAL" => 2,
        "INAUSPICIOUS" => 3,
        _ => 4,
    };

    private static string NatureLabel(YogaEvaluationRow r) => r.OutcomeNatureCode switch
    {
        "AUSPICIOUS" => "Good",
        "INAUSPICIOUS" => "Bad",
        "MIXED" => "Mixed",
        "CONTEXTUAL" => "Depends",
        _ => "—",
    };

    private static string NatureClass(YogaEvaluationRow r) => r.OutcomeNatureCode?.ToLowerInvariant() ?? "none";

    private static readonly (string Code, string Label)[] NatureTiles =
    {
        ("AUSPICIOUS", "Good"), ("INAUSPICIOUS", "Bad"), ("MIXED", "Mixed"), ("CONTEXTUAL", "Depends"),
    };

    private string? _nature;

    private void ToggleNature(string code) => _nature = _nature == code ? null : code;

    private int PresentByNature(string code) => PresentYogas.Count(r => r.OutcomeNatureCode == code);

    private int PresentCount => PresentYogas.Count;
    private int EvaluatedCount => VariantRows.Count(r => r.EvaluationStatus == "EVALUATED");
    private int NotEvaluatedCount => VariantRows.Count - EvaluatedCount;

    private static string SetOf(YogaEvaluationRow r) => r.YogaSetName ?? r.YogaTypeCode ?? "Other";

    // Display name of one catalogued variant: PVR's own title, else the catalogue entry from its locator
    // ("combination 104; printed p.128" -> "combination 104").
    private static string VariantName(YogaEvaluationRow r) =>
        !string.IsNullOrWhiteSpace(r.VariantDisplayName) ? r.VariantDisplayName
        : !string.IsNullOrWhiteSpace(r.SourceLocator) ? r.SourceLocator.Split(';')[0].Trim()
        : r.SourceVariantCode;

    private static string StatusLabel(YogaEvaluationRow r) => r.EvaluationStatus == "NOT_EVALUATED"
        ? "Pending" : r.Present == true ? "Present" : "Absent";

    private static string StatusClass(YogaEvaluationRow r) => r.EvaluationStatus == "NOT_EVALUATED"
        ? "pending" : r.Present == true ? "present" : "absent";

    private static string DisplayYoga(string code) => CultureInfo.InvariantCulture.TextInfo.ToTitleCase(
        code.Replace("YOGA_", "", StringComparison.OrdinalIgnoreCase).Replace('_', ' ').ToLowerInvariant());

    private static string DisplaySource(string code) => CultureInfo.InvariantCulture.TextInfo.ToTitleCase(
        code.Replace("SRC_", "", StringComparison.OrdinalIgnoreCase).Replace('_', ' ').ToLowerInvariant());
}
