@*
    Full-detail "D1 template" rendering of any one chart — the same dense D1TemplateGrid the
    Workspace hero and the standalone SouthIndianTemplate page use, packaged here with its own
    --tmpl-* parchment palette and centre-cell content so it can be dropped into a gallery
    (AllCharts) or a print sheet without pulling in a page-scoped wrapper.

    D1 gets the Jaimini karaka strip and, when Rounds are supplied, the three Sade-Sati "Round"
    boxes in the centre cell; a varga (IsD1 == false) gets the heading + a plain Lagna line, the
    same split Workspace's own CenterContent branch uses. The per-chart helper methods below are
    lifted verbatim from Workspace.razor / SouthIndianTemplate.razor so all three render identically.
*@
@using Ikiastrro.Web.Components.Workspace

<div class="tmpl-card @(Compact ? "compact" : "")">
    <D1TemplateGrid AscendantSign="@Chart.AscendantSign"
                    SunSign="@SignOf(Chart, "Sun")"
                    MoonSign="@SignOf(Chart, "Moon")"
                    PlanetsBySign="PlanetsBySign(Chart)"
                    PointsBySign="PointsBySign(Chart)"
                    AspectsBySign="ChartViewModel.BuildAspectedByPlain(Chart.KeyDetails, Chart.Aspects)"
                    UpagrahasBySign="UpagrahasBySign(Chart)"
                    ShowHoraLagnaHeader="false"
                    ShowDegrees="@IsD1"
                    DignityMode="TemplateDignityMode.Code">
        <CenterContent>
            <div class="center-stack">
                <div class="center-mid">
                    <div class="center-heading">
                        <span class="center-heading-main">@Chart.SanskritName.ToUpperInvariant()</span>
                        <span class="center-heading-sub">@Chart.ChartType@(string.IsNullOrWhiteSpace(ShortDescription) ? "" : $" · {ShortDescription}")</span>
                    </div>
                    @if (IsD1)
                    {
                        <div class="karaka-strip">
                            @foreach (var row in KarakaRows(Chart))
                            {
                                <div class="karaka-line">
                                    @foreach (var pair in row)
                                    {
                                        <span class="karaka"><b>@pair.Code</b> <span style="color:var(--tmpl-planet-@(pair.Key))">@pair.Glyph</span></span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
                @if (IsD1 && Rounds is { Count: > 0 })
                {
                    <div class="round-group">
                        <DashaRoundBox Label="ONE" Round="RoundAt(0)" BirthDate="BirthDate" />
                        <DashaRoundBox Label="TWO" Round="RoundAt(1)" BirthDate="BirthDate" />
                        <DashaRoundBox Label="THREE" Round="RoundAt(2)" BirthDate="BirthDate" />
                    </div>
                }
                else
                {
                    <div class="center-lagna"><b>Lagna</b> @Disp(Chart.AscendantSign)</div>
                }
            </div>
        </CenterContent>
    </D1TemplateGrid>
</div>

@code {
    [Parameter, EditorRequired] public LoadedChart Chart { get; set; } = null!;

    /// <summary>D1 → show the Jaimini karaka strip (and the Round boxes when <see cref="Rounds"/>
    /// is set). Any varga → heading + a plain Lagna line instead (CharaKaraka / Sade-Sati are
    /// D1-only in this codebase).</summary>
    [Parameter] public bool IsD1 { get; set; }
    [Parameter] public bool Compact { get; set; }

    /// <summary>tbl_Dim_ChartType.ChartShortDescription — the short "primary domain" tag shown
    /// under the chart name in the centre cell. Null/blank → just the name.</summary>
    [Parameter] public string? ShortDescription { get; set; }

    /// <summary>The three Sade-Sati "Round" windows (SadeSatiRounds.BuildRounds). Only rendered
    /// when <see cref="IsD1"/> is true; null/empty → the centre cell shows the Lagna line instead.</summary>
    [Parameter] public IReadOnlyList<SadeSatiRounds.Round>? Rounds { get; set; }

    [Parameter] public DateTime BirthDate { get; set; }

    private SadeSatiRounds.Round? RoundAt(int i) => Rounds is not null && i < Rounds.Count ? Rounds[i] : null;

    private static string Disp(string s) => s == "Capricornus" ? "Capricorn" : s;

    private static string SignOf(LoadedChart lc, string planet) =>
        lc.Grahas.First(k => k.Planet == planet).Sign;

    private static IReadOnlyDictionary<string, IReadOnlyList<TemplatePlanetLine>> PlanetsBySign(LoadedChart lc) =>
        lc.Grahas.Where(k => k.Planet != "Ascendant").GroupBy(k => k.Sign)
            .ToDictionary(g => g.Key, g => (IReadOnlyList<TemplatePlanetLine>)g.Select(k => new TemplatePlanetLine(
                ChartViewModel.PlanetGlyph(k.Planet),
                k.Planet.ToLowerInvariant(),
                (int)(k.DegreesInSignDecimal ?? 0),
                k.IsRetrograde ?? false,
                k.IsCombust ?? false,
                ChartViewModel.DignityScore(k.DignityStatus))
            {
                DignityCode = ChartViewModel.DignityShortCode(k.DignityStatus)
            }).ToList());

    private static IReadOnlyDictionary<string, IReadOnlyList<TemplatePointLine>> PointsBySign(LoadedChart lc)
    {
        var karakaLines = lc.Grahas.Where(k => k.CharaKaraka is not null)
            .Select(k => (k.Sign, Line: new TemplatePointLine(k.CharaKaraka!, k.HouseNumberFromLagna, k.HouseNumberFromMoon)));
        var lagnaLines = lc.SpecialPoints.Where(k => k.PointKind != "Upagraha")
            .Select(k => (k.Sign, Line: new TemplatePointLine(k.Planet, k.HouseNumberFromLagna, k.HouseNumberFromMoon)));

        return karakaLines.Concat(lagnaLines).GroupBy(x => x.Sign)
            .ToDictionary(g => g.Key, g => (IReadOnlyList<TemplatePointLine>)g.Select(x => x.Line).ToList());
    }

    private static IReadOnlyDictionary<string, IReadOnlyList<string>> UpagrahasBySign(LoadedChart lc) =>
        lc.SpecialPoints.Where(k => k.PointKind == "Upagraha")
            .GroupBy(k => k.Sign)
            .ToDictionary(g => g.Key, g => (IReadOnlyList<string>)g.Select(k => k.Planet switch { "Gulika" => "Gk", "Maandi" => "Md", _ => k.Planet }).ToList());

    private static IReadOnlyList<IReadOnlyList<(string Code, string Glyph, string Key)>> KarakaRows(LoadedChart lc)
    {
        var byCode = lc.Grahas.Where(k => k.CharaKaraka is not null)
            .ToDictionary(k => k.CharaKaraka!, k => (Glyph: ChartViewModel.PlanetGlyph(k.Planet), Key: k.Planet.ToLowerInvariant()));
        var order = new[] { "AK", "AmK", "BK", "MK", "PiK", "PK", "GK", "DK" };
        var pairs = order.Where(byCode.ContainsKey).Select(c => (Code: c, Glyph: byCode[c].Glyph, Key: byCode[c].Key)).ToList();
        return new IReadOnlyList<(string, string, string)>[] { pairs.Take(4).ToList(), pairs.Skip(4).Take(4).ToList() };
    }
}
