@using Ikiastrro.Web.Components.Workspace

<div class="insights-grid">
    <section class="insight-card">
        <h2>Rāśi characteristics</h2>
        <p><b>@Sign</b> · @Element · @Modality · Lord: @Lord</p>
        <p>Ascendant: @Chart.AscendantSign</p>
    </section>
    <section class="insight-card">
        <h2>Nakṣatra characteristics</h2>
        @foreach (var p in Chart.Grahas.Where(x => x.Nakshatra is not null))
        { <div class="insight-row"><b>@p.Planet</b><span>@p.Nakshatra · Pāda @p.NakshatraPada · Lord @p.NakshatraLordPlanet</span></div> }
    </section>
    <section class="insight-card insight-wide">
        <h2>Śadbala</h2>
        @if (Strengths.Count == 0) { <p class="muted">No Śadbala facts computed.</p> }
        else { <div class="strength-grid"><b>Planet</b><b>Rūpas</b><b>Total virūpas</b>
            @foreach (var row in Strengths) { <span>@row.PlanetId</span><span>@row.ShadbalaRupas.ToString("0.00")</span><span>@row.ShadbalaVirupas.ToString("0.0")</span> }
        </div> }
    </section>
</div>

@code {
    [Parameter, EditorRequired] public LoadedChart Chart { get; set; } = default!;
    [Parameter] public IReadOnlyList<dynamic> Strengths { get; set; } = Array.Empty<dynamic>();
    private string Sign => Chart.MoonSign ?? Chart.AscendantSign;
    private string Element => Sign switch { "Aries" or "Leo" or "Sagittarius" => "Fire", "Taurus" or "Virgo" or "Capricorn" => "Earth", "Gemini" or "Libra" or "Aquarius" => "Air", _ => "Water" };
    private string Modality => Sign switch { "Aries" or "Cancer" or "Libra" or "Capricorn" => "Movable", "Taurus" or "Leo" or "Scorpio" or "Aquarius" => "Fixed", _ => "Dual" };
    private string Lord => Sign switch { "Aries" or "Scorpio" => "Mars", "Taurus" or "Libra" => "Venus", "Gemini" or "Virgo" => "Mercury", "Cancer" => "Moon", "Leo" => "Sun", "Sagittarius" or "Pisces" => "Jupiter", "Capricorn" or "Aquarius" => "Saturn", _ => "—" };
}
