@using Ikiastrro.Core.Engines.Astronomy
@using Ikiastrro.Core.Engines.Houses
@using Ikiastrro.Core.Engines.PlanetNature
@using Ikiastrro.Web.Components.Workspace
@* Astro Facts 1.2 — planet benefic / malefic by school, in the chart shown. Facts side by side, no blended verdict: the
   schools disagree (what a kendra lordship does; where a benefic or malefic does well) and each is a column with its source.
   Computed live in Core (PlanetBeneficMaleficReader) from the stored key details and the rule rows of migration 180.
   docs/research/domain/planet-benefic-malefic-perspectives.md *@
@if (_rows is null)
{
    <p class="kit-muted">Needs a complete chart with all nine grahas and the Lagna.</p>
}
else
{
    <div class="kit-scroll">
        <table class="kit pbm">
            <thead>
                <tr>
                    <th rowspan="2">Planet</th>
                    <th rowspan="2" title="Fixed nature of the planet, with the Moon by paksha and Mercury by its company (PVR §3.2.2)">Natural</th>
                    <th colspan="@_lordSchools.Count" class="pbm-group" title="What the houses a planet rules make of it for this Lagna">Functional (house lordship)</th>
                    <th rowspan="2" title="The nature of the house the planet sits in, counting its lord, the planets in it (this planet and its conjunctions) and the planets aspecting it, each by functional nature">House (final)</th>
                    @if (_dasha is not null)
                    {
                        <th rowspan="2" title="The Vimshottari lords running on @AsOf.ToString("d MMM yyyy"), and what the classics say about each planet's dasa (Phaladeepika ch.20)">Dasha period</th>
                    }
                    <th rowspan="2">Sign</th>
                    <th rowspan="2">Nakṣatra</th>
                </tr>
                <tr>
                    @foreach (var s in _lordSchools) { <th class="pbm-school" title="@s.Name">@s.ShortName</th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr>
                        <td><b>@r.Planet</b><br /><span class="kit-muted">H@(r.House) · @SignName(r.Sign)</span></td>
                        <td>
                            <span class="@NatClass(r.Natural.Nature)" title="@r.Natural.Why">@NatLabel(r.Natural.Nature)</span>
                            @if (r.Natural.BphsDiffers is { } differs)
                            {
                                <br /><span class="pbm-diff" title="@differs">other schools differ</span>
                            }
                        </td>
                        @foreach (var s in _lordSchools)
                        {
                            var f = r.Functional.FirstOrDefault(x => x.SchoolCode == s.Code);
                            <td>@if (f is null) { <span class="kit-muted">—</span> } else { <span class="@FnClass(f.Verdict)" title="@f.Why">@FnLabel(f.Verdict)</span> }</td>
                        }
                        <td>
                            @if (r.HouseVerdict is { } hv)
                            {
                                <span class="@HouseClass(hv.Verdict)" title="@hv.Rationale">@hv.Verdict</span>
                                <br /><span class="kit-muted">Lord @(hv.LordPlanet): @(hv.LordFunctionalNature.ToString().ToLowerInvariant())</span>
                                @if (With(hv, r.Planet) is { Length: > 0 } with) { <br /><span class="kit-muted">With @with</span> }
                                @if (Aspects(hv) is { Length: > 0 } asp) { <br /><span class="kit-muted">Aspected by @asp</span> }
                            }
                            else { <span class="kit-muted">—</span> }
                        </td>
                        @if (_dasha?.FirstOrDefault(d => d.Planet == r.Planet) is { } dr)
                        {
                            <td>
                                @if (dr.Running is { } run) { <span class="pbm-b pbm-run" title="@run.Level, running until @run.End.ToString("d MMM yyyy")">@RunLabel(run.Level) · until @run.End.ToString("MMM yyyy")</span><br /> }
                                <span class="kit-muted">Lordship: @dr.Lordship</span><br />
                                @if (dr.HasAdverseFlag) { <span class="pbm-b pbm-bad" title="Phaladeepika ch.20 marks this dasa adverse; open the rules for why">Adverse flag</span> }
                                else { <span class="kit-muted">No adverse flag</span> }
                                <details class="pbm-facts">
                                    <summary>Rules</summary>
                                    <ul>
                                        @foreach (var f in dr.Facts)
                                        {
                                            <li class="@(f.Adverse ? "pbm-factbad" : "")">@f.Text <span class="kit-muted">(@f.Source)</span></li>
                                        }
                                        @if (dr.Facts.Count == 0) { <li class="kit-muted">Phaladeepika ch.20 states nothing further for this planet here.</li> }
                                    </ul>
                                </details>
                            </td>
                        }
                        <td>
                            <b>@(r.SignInfo.Dignity ?? "—")</b>
                            @if (r.SignInfo.IsOwnLord) { <br /><span class="kit-muted">Its own sign</span> }
                            else if (r.SignInfo.Lord is { } sl) { <br /><span class="kit-muted">Lord @(sl.Planet): @(Related(sl, false))</span> }
                        </td>
                        <td>
                            @if (r.NakshatraInfo.Nakshatra is { } nk)
                            {
                                <b>@(nk + (r.NakshatraInfo.Pada is { } pada ? $" {pada}" : ""))</b>
                                @if (r.NakshatraInfo.StarLord is { } star)
                                {
                                    <br /><span class="kit-muted">Star lord @(star.Planet): @(Related(star, true))</span>
                                }
                                @if (r.NakshatraInfo.SubLord is { } sub)
                                {
                                    <br /><span class="kit-muted">KP sub-lord @(sub.Planet): @(Related(sub, false))</span>
                                }
                            }
                            else { <span class="kit-muted">—</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="pbm-note">
        Hover a cell for the rule and its source. <b>—</b> means that school states nothing for the case; it is not a neutral verdict.
        Natural nature does not change between charts; the functional columns and the final house recount from this chart's own Lagna.
        <b>House (final)</b> counts, with equal weight, the house lord, every planet in the house (this planet and its conjunctions)
        and every planet aspecting it, each as benefic or malefic by its functional nature (PVR Table 30; a neutral planet counts on
        the malefic side, nodes are malefic) — B.V. Raman's method for judging a house. Strength and dignity are not folded in.
        @if (_chart.ChartType == "D60") { <text>The shashtiamsa's own benefic or malefic flag (BPHS) is in the Ṣaṣṭyaṃśa (D60) deities table under Vargas.</text> }
    </p>

    @if (_across is { Count: > 1 })
    {
        <h4 class="pbm-subhead">PVR functional nature across the vargas</h4>
        <div class="kit-scroll">
            <table class="kit pbm pbm-across">
                <thead><tr><th>Planet</th>@foreach (var c in _across.Keys) { <th class="pbm-school">@c</th> }</tr></thead>
                <tbody>
                    @foreach (var planet in _acrossPlanets)
                    {
                        <tr>
                            <td><b>@planet</b></td>
                            @foreach (var (chartType, byPlanet) in _across)
                            {
                                var v = byPlanet[planet];
                                <td><span class="@FnClass(v)" title="@planet in @chartType: @FnLabel(v).ToLowerInvariant() for that chart's Lagna">@FnLetter(v)</span></td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="pbm-note">Y yogakāraka · B benefic · N neutral · M malefic. Each column reads PVR's Table 30 for that varga's own Lagna,
            the way PVR reads functional nature in the dasamsa (Example 54). Rāhu and Ketu own no sign and are not in Table 30.</p>
    }
}

@code {
    [Parameter, EditorRequired] public LoadedChart Chart { get; set; } = default!;
    /// <summary>Every stored chart, for the across-vargas grid; leave empty to omit it.</summary>
    [Parameter] public IReadOnlyDictionary<string, LoadedChart>? Charts { get; set; }
    [Parameter, EditorRequired] public SchoolRuleBook Rules { get; set; } = default!;
    /// <summary>The birth Moon's phase; real longitudes are in every chart, so any chart's grahas give it.</summary>
    [Parameter] public bool? MoonWaxing { get; set; }
    /// <summary>The stored Vimshottari tree (Maha roots with their children); leave null to omit the Dasha period column.</summary>
    [Parameter] public IReadOnlyList<Ikiastrro.Core.Engines.Dasha.DashaPeriodRecord>? DashaPeriods { get; set; }
    /// <summary>The date the running lords are read for.</summary>
    [Parameter] public DateTime AsOf { get; set; } = DateTime.Today;
    private IReadOnlyList<DashaReading>? _dasha;

    private LoadedChart _chart = default!;
    private IReadOnlyList<PlanetNatureRow>? _rows;
    private List<BeneficMaleficSchool> _lordSchools = new();
    private Dictionary<string, IReadOnlyDictionary<PlanetName, SchoolFunctional>>? _across;
    private static readonly PlanetName[] _acrossPlanets =
        { PlanetName.Sun, PlanetName.Moon, PlanetName.Mars, PlanetName.Mercury, PlanetName.Jupiter, PlanetName.Venus, PlanetName.Saturn };

    protected override void OnParametersSet()
    {
        _chart = Chart;
        _rows = null;
        _across = null;
        var grahas = Chart.Grahas;
        if (grahas.Count(k => k.Planet != "Ascendant") < 9 || !Enum.TryParse<ZodiacName>(Chart.AscendantSign, out var lagna)) return;

        _lordSchools = Rules.WithTopic("LORDSHIP").Append(Rules.Schools.First(s => s.Code == SchoolCodes.Pvr)).Distinct()
            .OrderBy(s => s.DisplayOrder).ToList();
        _rows = PlanetBeneficMaleficReader.Read(Chart.KeyDetails, lagna, MoonWaxing, Rules);
        _dasha = DashaPeriods is { Count: > 0 }
            ? DashaNatureReader.Read(_rows, Chart.KeyDetails, lagna, RunningDasha.At(DashaPeriods, AsOf))
            : null;

        if (Charts is { Count: > 1 })
        {
            var ordered = Charts.Values.OrderBy(c => DivisionalNumber(c.ChartType)).ThenBy(c => c.ChartType)
                .Where(c => Enum.TryParse<ZodiacName>(c.AscendantSign, out _))
                .Select(c => (c.ChartType, Enum.Parse<ZodiacName>(c.AscendantSign)));
            var map = PlanetBeneficMaleficReader.PvrAcrossCharts(ordered, MoonWaxing);
            _across = ordered.ToDictionary(c => c.ChartType, c => map[c.ChartType]);
        }
    }

    private static int DivisionalNumber(string chartType)
    {
        var digits = new string(chartType.Skip(1).TakeWhile(char.IsDigit).ToArray());
        return int.TryParse(digits, out var n) ? n : int.MaxValue;
    }

    private static string RunLabel(string level) => level switch { "Mahadasha" => "MD", "Antardasha" => "AD", _ => "PD" };

    private static string SignName(string s) => s == "Capricornus" ? "Capricorn" : s;

    /// <summary>"Benefic · PVR malefic · H8": the related planet's natural nature, PVR functional verdict and (for a star lord) house.</summary>
    private static string Related(RelatedPlanetNature r, bool withHouse) =>
        NatLabel(r.Natural)
        + (r.Pvr is { } f && f != SchoolFunctional.NotStated ? $" · PVR {FnLabel(f).ToLowerInvariant()}" : "")
        + (withHouse && r.House is { } h ? $" · H{h}" : "");

    private static string NatLabel(NaturalNature n) => n switch { NaturalNature.Benefic => "Benefic", NaturalNature.Malefic => "Malefic", _ => "Mixed" };
    private static string NatClass(NaturalNature n) => n switch { NaturalNature.Benefic => "pbm-b pbm-good", NaturalNature.Malefic => "pbm-b pbm-bad", _ => "pbm-b pbm-mixed" };

    private static string FnLabel(SchoolFunctional f) => f switch
    {
        SchoolFunctional.Yogakaraka => "Yogakāraka", SchoolFunctional.Benefic => "Benefic", SchoolFunctional.Neutral => "Neutral",
        SchoolFunctional.Malefic => "Malefic", SchoolFunctional.Mixed => "Mixed", _ => "—",
    };
    private static string FnLetter(SchoolFunctional f) => f switch
    {
        SchoolFunctional.Yogakaraka => "Y", SchoolFunctional.Benefic => "B", SchoolFunctional.Neutral => "N", SchoolFunctional.Malefic => "M", _ => "—",
    };
    private static string FnClass(SchoolFunctional f) => f switch
    {
        SchoolFunctional.Yogakaraka or SchoolFunctional.Benefic => "pbm-b pbm-good",
        SchoolFunctional.Malefic => "pbm-b pbm-bad",
        SchoolFunctional.Neutral => "pbm-b pbm-neutral",
        SchoolFunctional.Mixed => "pbm-b pbm-mixed",
        _ => "pbm-b pbm-none",
    };

    private static string HouseClass(HouseBeneficMaleficVerdict v) => v switch
    {
        HouseBeneficMaleficVerdict.Benefic => "pbm-b pbm-good",
        HouseBeneficMaleficVerdict.Malefic => "pbm-b pbm-bad",
        HouseBeneficMaleficVerdict.Mixed => "pbm-b pbm-mixed",
        _ => "pbm-b pbm-neutral",
    };

    /// <summary>The other planets in the house with their side: "Venus (malefic), Mars (malefic)". The planet itself is left out.</summary>
    private static string With(HouseBeneficMaleficResult h, string self) => string.Join(", ",
        h.BeneficOccupants.Where(p => p != self).Select(p => $"{p} (benefic)")
            .Concat(h.MaleficOccupants.Where(p => p != self).Select(p => $"{p} (malefic)")));

    private static string Aspects(HouseBeneficMaleficResult h) => string.Join(", ",
        h.BeneficAspectors.Select(p => $"{p} (benefic)").Concat(h.MaleficAspectors.Select(p => $"{p} (malefic)")));
}
