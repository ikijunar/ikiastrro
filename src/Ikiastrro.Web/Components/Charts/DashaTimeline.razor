@* Vimshottari Dasha, three levels, selectable. Click a Mahadasha to open its Antardashas;
   click an Antardasha to open its Pratyantardashas. On first render the chain containing
   AsOf (the current period) is opened, and the active period at every level is badged —
   so "what's happening now" never depends on colour alone. *@
<div class="dasha-timeline">
@if (Compact)
{
    <ul class="maha-list compact">
        @foreach (var maha in Roots.OrderBy(p => p.StartDayOffset))
        {
            var mahaCurrent = IsCurrent(maha);
            <li class="maha-row @(mahaCurrent ? "current" : "")">
                <div class="period-line">
                    <span class="swatch" style="background:@DashaLordColors.CssVar(maha.Lord)"></span>
                    <span class="lord">@maha.Lord</span>
                    <span class="label">Mahadasha</span>
                    <span class="range">@FormatRange(maha.StartDate, maha.EndDate)</span>
                    @if (mahaCurrent)
                    {
                        <span class="current-badge">current</span>
                    }
                </div>
            </li>
        }
    </ul>
}
else
{
    <DashaLegend />

    <ul class="maha-list">
        @foreach (var maha in Roots.OrderBy(p => p.StartDayOffset))
        {
            var mahaCurrent = IsCurrent(maha);
            var mahaOpen = _openMahaId == maha.Id;
            <li class="maha-row @(mahaCurrent ? "current" : "") @(mahaOpen ? "open" : "")">
                <button type="button" class="period-line row-toggle" @onclick="() => ToggleMaha(maha.Id)">
                    <span class="tw">@(mahaOpen ? "▾" : "▸")</span>
                    <span class="swatch" style="background:@DashaLordColors.CssVar(maha.Lord)"></span>
                    <span class="lord">@maha.Lord</span>
                    <span class="label">Mahadasha</span>
                    <span class="range">@FormatRange(maha.StartDate, maha.EndDate)</span>
                    @if (mahaCurrent)
                    {
                        <span class="current-badge">current</span>
                    }
                </button>

                @if (mahaOpen)
                {
                    <ul class="antar-list">
                        @foreach (var antar in maha.Children.OrderBy(p => p.StartDayOffset))
                        {
                            var antarCurrent = mahaCurrent && IsCurrent(antar);
                            var antarOpen = _openAntarId == antar.Id;
                            <li class="antar-row @(antarCurrent ? "current" : "") @(antarOpen ? "open" : "")">
                                <button type="button" class="period-line row-toggle" @onclick="() => ToggleAntar(antar.Id)">
                                    <span class="tw">@(antar.Children.Count > 0 ? (antarOpen ? "▾" : "▸") : "·")</span>
                                    <span class="swatch" style="background:@DashaLordColors.CssVar(antar.Lord)"></span>
                                    <span class="lord">@antar.Lord</span>
                                    <span class="label">Antardasha</span>
                                    <span class="range">@FormatRange(antar.StartDate, antar.EndDate)</span>
                                    @if (antarCurrent)
                                    {
                                        <span class="current-badge">current</span>
                                    }
                                </button>

                                @if (antarOpen && antar.Children.Count > 0)
                                {
                                    <ul class="pratyantar-list">
                                        @foreach (var pratyantar in antar.Children.OrderBy(p => p.StartDayOffset))
                                        {
                                            var pratyantarCurrent = antarCurrent && IsCurrent(pratyantar);
                                            <li class="pratyantar-row @(pratyantarCurrent ? "current" : "")">
                                                <div class="period-line">
                                                    <span class="tw">·</span>
                                                    <span class="swatch" style="background:@DashaLordColors.CssVar(pratyantar.Lord)"></span>
                                                    <span class="lord">@pratyantar.Lord</span>
                                                    <span class="label">Pratyantardasha</span>
                                                    <span class="range">@FormatRange(pratyantar.StartDate, pratyantar.EndDate)</span>
                                                    @if (pratyantarCurrent)
                                                    {
                                                        <span class="current-badge">current</span>
                                                    }
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                }
                            </li>
                        }
                    </ul>
                }
            </li>
        }
    </ul>
}
</div>

@code {
    [Parameter] public IReadOnlyList<DashaPeriodRecord> Roots { get; set; } = Array.Empty<DashaPeriodRecord>();

    /// <summary>Defaults to now — overridable for testing/screenshots of a specific moment.</summary>
    [Parameter] public DateTime AsOf { get; set; } = DateTime.Now;

    /// <summary>When true, render only non-interactive Mahadasha rows (docked strip). Default: full interactive tree.</summary>
    [Parameter] public bool Compact { get; set; }

    private int? _openMahaId;
    private int? _openAntarId;
    private bool _seeded;

    protected override void OnParametersSet()
    {
        if (Compact) return;
        if (_seeded || Roots.Count == 0) return;
        _seeded = true;

        var currentMaha = Roots.FirstOrDefault(IsCurrent);
        if (currentMaha is null) return;
        _openMahaId = currentMaha.Id;

        var currentAntar = currentMaha.Children.FirstOrDefault(IsCurrent);
        if (currentAntar is not null)
            _openAntarId = currentAntar.Id;
    }

    private void ToggleMaha(int id)
    {
        _openMahaId = _openMahaId == id ? null : id;
        _openAntarId = null;
    }

    private void ToggleAntar(int id) => _openAntarId = _openAntarId == id ? null : id;

    private bool IsCurrent(DashaPeriodRecord period) => AsOf >= period.StartDate && AsOf <= period.EndDate;

    private static string FormatRange(DateTime start, DateTime end) =>
        $"{start:d MMM yyyy} → {end:d MMM yyyy}";
}
