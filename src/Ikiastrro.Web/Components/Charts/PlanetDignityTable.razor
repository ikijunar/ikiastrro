@using Ikiastrro.Core.Engines.Astronomy
@using Ikiastrro.Core.Presentation
@using Ikiastrro.Core.Engines.Houses
@* Astro Facts 2.2 is the canonical full-detail owner for planetary role and condition. *@
<div class="pdt-scroll">
    <table class="pdt">
        <thead><tr>
            <th>Planet</th><th>Functional</th><th>Rules</th><th>Ownership</th>
            <th>Dignity</th><th>Kāraka</th><th>Exaltation&nbsp;pt.</th><th>Δ&nbsp;from&nbsp;exalt.</th><th>Closeness</th>
        </tr></thead>
        <tbody>
        @foreach (var r in Rows)
        {
            var role = Functional(r.Planet);
            var flags = role is null ? Array.Empty<string>() : OwnershipFlags(role).ToArray();
            <tr>
                <td>@r.Planet</td>
                <td>
                    @if (role is null) { <span class="muted">—</span> }
                    else { <span class="role role-@role.Nature.ToString().ToLowerInvariant()">@DisplayNature(role.Nature)</span> }
                </td>
                <td class="mono">@(role is null ? "—" : string.Join(", ", role.RuledHouses.Select(h => $"H{h}")))</td>
                <td>
                    @if (role is null) { <span class="muted">—</span> }
                    else
                    {
                        <div class="ownership">
                            @foreach (var flag in flags) { <span class="flag">@flag</span> }
                            @if (flags.Length == 0) { <span class="muted">None</span> }
                        </div>
                        <details><summary>Rationale</summary><p>@role.Rationale</p></details>
                    }
                </td>
                <td>
                    @if (r.DignityStatus is null) { <span class="muted">—</span> }
                    else { <span class="pill @PlanetBand.Class(r.Planet, PlanetBand.FromDignity(r.DignityStatus))">@r.DignityStatus</span> }
                </td>
                <td>@(r.CharaKaraka ?? "—")</td><td>@(r.ExaltationPointDisplay ?? "—")</td>
                <td class="mono">@(r.DeltaFromExaltationDegrees is { } d ? $"{d:0.0}°" : "—")</td>
                <td class="mono">@(r.ClosenessPercent is { } c ? $"{c}%" : "—")</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ExaltationRow> Rows { get; set; } = Array.Empty<ExaltationRow>();
    [Parameter, EditorRequired] public string LagnaSign { get; set; } = "";
    /// <summary>The birth Moon's phase (<see cref="MoonPhase"/>); decides the Moon's role for Aries, Libra and Capricorn Lagnas.</summary>
    [Parameter] public bool? MoonWaxing { get; set; }

    private FunctionalNatureResult? Functional(string planet)
    {
        if (!Enum.TryParse<PlanetName>(planet, out var p) || p is PlanetName.Rahu or PlanetName.Ketu) return null;
        return Enum.TryParse<ZodiacName>(LagnaSign, out var lagna) ? LagnaFunctionalNature.For(lagna, p, MoonWaxing) : null;
    }
    private static string DisplayNature(FunctionalNature nature) => nature == FunctionalNature.Yogakaraka ? "Yogakāraka" : nature.ToString();
    private static IEnumerable<string> OwnershipFlags(FunctionalNatureResult role)
    {
        if (role.MarakaHouses.Length > 0) yield return $"Māraka · {Houses(role.MarakaHouses)}";
        if (role.IsBaadhakaLord) yield return $"Bādhaka · H{role.BaadhakaHouse}";
        if (role.DusthanaHouses.Length > 0) yield return $"Dusthāna · {Houses(role.DusthanaHouses)}";
        if (role.TrishadayaHouses.Length > 0) yield return $"Triṣaḍāya · {Houses(role.TrishadayaHouses)}";
        if (role.KendradhipatiDosha) yield return "Kendrādhipati doṣa";
    }
    private static string Houses(IEnumerable<int> houses) => string.Join("/", houses.Select(h => $"H{h}"));
}
