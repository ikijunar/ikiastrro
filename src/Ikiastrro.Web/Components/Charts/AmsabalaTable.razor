@using Ikiastrro.Core.Presentation
@using System.Globalization
@using Ikiastrro.Web.Components.Workspace

<section class="am" aria-labelledby="am-title">
    <article class="am-card">
        <header class="am-card-head">
            <div>
                <h2 id="am-title">@(_scheme == "VARGOTTAMA" ? "Vargottama" : $"Aṁśabala · Vaiśeṣikāṃśa — {SchemeLabel(_scheme)}")</h2>
                <p class="am-subtext">@Subtext(_scheme)</p>
                <nav class="am-schemes" aria-label="Varga scheme">
                    @foreach (var s in SchemeOrder)
                    {
                        <button type="button" class="@(s == _scheme ? "is-active" : null)" @onclick="@(() => SelectScheme(s))">@SchemeShort(s)</button>
                    }
                </nav>
            </div>
        </header>

        @if (_scheme == "VARGOTTAMA")
        {
            <div class="am-table-scroll">
                <table>
                    <thead><tr><th>Graha</th><th>D1 Sign</th><th>D9 Sign</th><th>Match</th></tr></thead>
                    <tbody>
                        @foreach (var r in VargottamaRows)
                        {
                            <tr>
                                <th>@DisplayPlanet(r.PlanetCode)</th>
                                <td>@Disp(r.D1Sign)</td>
                                <td>@Disp(r.D9Sign)</td>
                                <td class="@(r.IsVargottama ? "am-high" : "am-zero")">@(r.IsVargottama ? "Yes" : "No")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="am-bars">
                @foreach (var r in SchemeRows)
                {
                    var isOpen = _expanded.Contains(r.PlanetCode);
                    <div class="am-row @(isOpen ? "is-open" : "")">
                        <button type="button" class="am-summary" @onclick="@(() => Toggle(r.PlanetCode))">
                            <span class="am-bar-planet">@DisplayPlanet(r.PlanetCode)</span>
                            <span class="am-stack">
                                @foreach (var seg in Segments(r.PlanetCode))
                                {
                                    @if (seg.Token is { } tok)
                                    {
                                        <span class="am-seg @PlanetBand.Class(DisplayPlanet(r.PlanetCode), PlanetBand.FromToken(tok))" title="@seg.ChartType — @seg.DignityStatus">@seg.ChartType</span>
                                    }
                                    else
                                    {
                                        <span class="am-seg am-seg-empty" title="@seg.ChartType — @seg.DignityStatus"></span>
                                    }
                                }
                            </span>
                            <b class="am-bar-value @(r.GoodCount == 0 ? "am-zero" : r.GoodCount * 2 >= r.GroupSize ? "am-high" : "")">
                                @r.GoodCount<span>/@r.GroupSize &middot; @PercentOf(r.GoodCount, r.GroupSize)%</span>
                            </b>
                            <span class="am-amsa" title="Vaiśeṣikāṃśa: the grade for @r.GoodCount own / mūlatrikoṇa / exalted vargas of @r.GroupSize">@(r.AmsaName ?? "—")</span>
                            <span class="am-chevron">@(isOpen ? "▾" : "▸")</span>
                        </button>

                        @if (isOpen)
                        {
                            <div class="am-detail">
                                <table class="am-detail-table">
                                    <thead><tr><th>Varga</th><th>Sign</th><th>Lord</th><th>Dignity</th><th>Score</th></tr></thead>
                                    <tbody>
                                        @foreach (var lordRow in VargaLords(r.PlanetCode))
                                        {
                                            <tr class="@(lordRow.ChartType.Equals(SelectedChart, StringComparison.OrdinalIgnoreCase) ? "is-selected-chart" : null)">
                                                <th><button type="button" class="am-lord-chart" title="Show @lordRow.ChartType on the chart above" @onclick="() => SelectChart(lordRow.ChartType)">@lordRow.ChartType</button></th>
                                                <td>@Disp(lordRow.Sign)</td>
                                                <td>@(lordRow.Lord ?? "—")</td>
                                                <td>@(lordRow.DignityStatus ?? "—")</td>
                                                <td class="mono">@lordRow.ScoreDisplay</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                }
            </div>
            <p class="am-key">
                @foreach (var token in DignityKey)
                {
                    <span><i class="@PlanetBand.Class(null, PlanetBand.FromToken(token.Token))"></i> @token.Label</span>
                }
            </p>
        }
    </article>
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AmsabalaRow> Rows { get; set; } = Array.Empty<AmsabalaRow>();
    [Parameter, EditorRequired] public IReadOnlyList<AmsabalaGroupMember> Groups { get; set; } = Array.Empty<AmsabalaGroupMember>();
    [Parameter, EditorRequired] public IReadOnlyList<VargottamaRow> Vargottama { get; set; } = Array.Empty<VargottamaRow>();
    [Parameter, EditorRequired] public IReadOnlyDictionary<string, LoadedChart> Charts { get; set; } = new Dictionary<string, LoadedChart>();

    /// <summary>Two-way bound to the caller's own chart picker (AstroFacts's
    /// `_natalChart`/`ChartColumn`, same convention AshtakavargaChart established 2026-09-25):
    /// clicking a Varga row in the expanded detail table below moves the chart shown on the left
    /// to that divisional chart. Previously this table only ever displayed data — clicking a row
    /// did nothing beyond toggling the expand/collapse (rammyps, 2026-09-25: "click D6 while
    /// viewing D24 and the chart doesn't change").</summary>
    [Parameter] public string SelectedChart { get; set; } = "D1";
    [Parameter] public EventCallback<string> SelectedChartChanged { get; set; }

    private async Task SelectChart(string chartType)
    {
        if (chartType.Equals(SelectedChart, StringComparison.OrdinalIgnoreCase)) return;
        SelectedChart = chartType;
        await SelectedChartChanged.InvokeAsync(chartType);
    }

    private static readonly string[] PlanetOrder = { "SUN", "MOON", "MARS", "MERCURY", "JUPITER", "VENUS", "SATURN" };
    private static readonly string[] SchemeOrder = { "VARGOTTAMA", "SHADVARGA", "SAPTAVARGA", "DASAVARGA", "SHODASAVARGA" };

    private static readonly Dictionary<string, string> ShortSignNames = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Aries"] = "Ari", ["Taurus"] = "Tau", ["Gemini"] = "Gem", ["Cancer"] = "Can", ["Leo"] = "Leo",
        ["Virgo"] = "Vir", ["Libra"] = "Lib", ["Scorpio"] = "Sco", ["Sagittarius"] = "Sag",
        ["Capricornus"] = "Cap", ["Capricorn"] = "Cap", ["Aquarius"] = "Aqu", ["Pisces"] = "Pis",
    };

    /// <summary>The scheme pill, two-way bound so Vimśopaka Bala below follows it.</summary>
    [Parameter] public string Scheme { get; set; } = "VARGOTTAMA";
    [Parameter] public EventCallback<string> SchemeChanged { get; set; }

    private string _scheme => Scheme;

    private async Task SelectScheme(string scheme)
    {
        if (scheme == Scheme) return;
        Scheme = scheme;
        await SchemeChanged.InvokeAsync(scheme);
    }
    private readonly HashSet<string> _expanded = new(StringComparer.OrdinalIgnoreCase);

    private void Toggle(string planetCode)
    {
        if (!_expanded.Add(planetCode)) _expanded.Remove(planetCode);
    }

    // Highest planet count first (own / mūlatrikoṇa / exalted vargas out of the scheme's group); planets on the
    // same count keep the classical Sun-to-Saturn order, since OrderByDescending is stable over PlanetOrder.
    private IReadOnlyList<AmsabalaRow> SchemeRows =>
        PlanetOrder
            .Select(p => Rows.FirstOrDefault(r => r.PlanetCode.Equals(p, StringComparison.OrdinalIgnoreCase)
                                                 && r.SchemeCode.Equals(_scheme, StringComparison.OrdinalIgnoreCase)))
            .Where(r => r is not null)
            .Select(r => r!)
            .OrderByDescending(r => r.GoodCount)
            .ToList();

    private IReadOnlyList<VargottamaRow> VargottamaRows =>
        PlanetOrder
            .Select(p => Vargottama.FirstOrDefault(r => r.PlanetCode.Equals(p, StringComparison.OrdinalIgnoreCase)))
            .Where(r => r is not null)
            .Select(r => r!)
            .ToList();

    private static int PercentOf(int good, int groupSize) => groupSize == 0 ? 0 : (int)Math.Round(100.0 * good / groupSize);

    // "N charts compared (Rasi chart with D-x,D-y,...)" — built off the actual seeded group
    // membership (tbl_Rule_AmsabalaGroup, db/101), not a hardcoded copy of it.
    private string Subtext(string scheme)
    {
        if (scheme == "VARGOTTAMA") return "2 charts compared (Rasi chart with D-9)";
        var members = Groups.Where(g => g.SchemeCode.Equals(scheme, StringComparison.OrdinalIgnoreCase)).ToList();
        var rest = members.Where(g => !g.ChartType.Equals("D1", StringComparison.OrdinalIgnoreCase))
            .Select(g => "D-" + g.ChartType.TrimStart('D', 'd'));
        return $"{members.Count} charts compared (Rasi chart with {string.Join(",", rest)})";
    }

    private static string SchemeLabel(string s) => s switch
    {
        "SHADVARGA" => "Shadvarga (6)",
        "SAPTAVARGA" => "Saptavarga (7)",
        "DASAVARGA" => "Dasavarga (10)",
        "SHODASAVARGA" => "Shodasavarga (16)",
        _ => s,
    };

    private static string SchemeShort(string s) => s switch
    {
        "VARGOTTAMA" => "Vargottama",
        "SHADVARGA" => "Shadvarga",
        "SAPTAVARGA" => "Saptavarga",
        "DASAVARGA" => "Dasavarga",
        "SHODASAVARGA" => "Shodasavarga",
        _ => s,
    };

    private static string DisplayPlanet(string code) => CultureInfo.InvariantCulture.TextInfo.ToTitleCase(code.ToLowerInvariant());
    private static string Disp(string s) => s == "Capricornus" ? "Capricorn" : s;

    // One slot per varga in the current scheme (so the row still reads as "N out of GroupSize"),
    // coloured/named by the planet's actual 7-tier dignity in that specific chart
    // (ChartViewModel.DignityTierToken, read live off Charts, same as VargaLordsTable.Cell()) —
    // Neutral/Debilitated (not in rammyps's 7-tier list) render as a plain empty slot.
    private IEnumerable<(string ChartType, string DignityStatus, string? Token)> Segments(string planetCode) =>
        Groups.Where(g => g.SchemeCode.Equals(_scheme, StringComparison.OrdinalIgnoreCase))
            .Select(g =>
            {
                var status = Charts.TryGetValue(g.ChartType, out var chart)
                    ? chart.Grahas.FirstOrDefault(k => k.Planet.Equals(planetCode, StringComparison.OrdinalIgnoreCase))?.DignityStatus
                    : null;
                return (g.ChartType, DignityStatus: status ?? "Unknown",
                    Token: Ikiastrro.Core.Presentation.ChartViewModel.DignityTierToken(status));
            });

    // Varga-lords detail table under the expanded bar — same per-chart sign+lord lookup
    // VargaLordsTable.Cell() used, scoped to just this scheme's chart-type membership, plus the
    // 0..1 normalized dignity score (ChartViewModel.DignityScoreNormalized) for later statistics.
    private IEnumerable<(string ChartType, string Sign, string? Lord, string? DignityStatus, string ScoreDisplay)> VargaLords(string planetCode) =>
        Groups.Where(g => g.SchemeCode.Equals(_scheme, StringComparison.OrdinalIgnoreCase))
            .Select(g =>
            {
                if (!Charts.TryGetValue(g.ChartType, out var chart))
                    return (g.ChartType, "—", (string?)null, (string?)null, "—");
                var graha = chart.Grahas.FirstOrDefault(k => k.Planet.Equals(planetCode, StringComparison.OrdinalIgnoreCase));
                if (graha is null)
                    return (g.ChartType, "—", (string?)null, (string?)null, "—");
                var lord = chart.HouseLords
                    .FirstOrDefault(h => h.HouseSign.Equals(graha.Sign, StringComparison.OrdinalIgnoreCase))?.LordPlanet;
                var score = Ikiastrro.Core.Presentation.ChartViewModel.DignityScoreNormalized(graha.DignityStatus);
                return (g.ChartType, graha.Sign, lord, graha.DignityStatus, score.ToString("0.00", CultureInfo.InvariantCulture));
            });

    private static readonly (string Token, string Label)[] DignityKey =
    {
        ("exalted", "Exalted"),
        ("moolatrikona", "Moolatrikona"),
        ("own", "Own Sign"),
        ("great-friend", "Great Friend"),
        ("friend", "Friend"),
        ("enemy", "Enemy"),
        ("great-enemy", "Great Enemy"),
    };
}
