@using Ikiastrro.Core.Engines.PlanetaryStates
@using Ikiastrro.Core.Models
@using Ikiastrro.Data
@* Astro Facts "ABOUT PLANETS" — Bālādi/Jāgradādi/Śayanādi/Dīptādi/Lajjitādi avasthas, one row
   per graha. Bālādi/Śayanādi are D1-only: PlanetaryStateFact.AgeStateId/PostureStateId are
   populated for D1 alone (PlanetaryStateRepository's own doc comment), so filtering on
   AgeStateId.HasValue in the page (not here) is what already narrows Rows to the D1 chart before
   it reaches this table — Dīptādi/Lajjitādi are computed for every chart type, but only D1's
   rows ever reach this table anyway, same as Jāgradādi. *@
<div class="pst-note">
    <strong>Five lenses, PVR sec 15.4.3 for the last two:</strong>
    Bālādi describes effective capacity by degree, Jāgradādi describes availability by dignity,
    Śayanādi describes the planet's mode of activity, Dīptādi combines a dignity tier with up to
    3 affliction flags (Vikala/Khala/Kopita), and Lajjitādi is 6 independent condition flags — the
    book gives no precedence between simultaneous matches within Dīptādi or Lajjitādi, so every
    match is kept. Interpretations are source summaries, not deterministic predictions; weigh
    them with dignity, strength, houses and aspects. Combined inference keeps capacity, baseline
    condition and relational context separate so dignity is not counted repeatedly.
</div>
<details class="pst-defs">
    <summary>What each avastha set looks at, and how this app reads it</summary>
    <table class="pst-defs-table">
        <thead><tr><th>Set</th><th>PVR</th><th>Uses</th><th>How this app reads it</th><th>Computed for</th></tr></thead>
        <tbody>
        @foreach (var set in AvasthaPvrNotes.Systems)
        {
            <tr>
                <td><strong>@set.System</strong><span class="pst-meaning">@set.Title</span></td>
                <td>§@set.Section</td>
                <td><ul>@foreach (var use in set.Uses) { <li>@use</li> }</ul></td>
                <td>@set.AppReading</td>
                <td>@set.Scope</td>
            </tr>
        }
        </tbody>
    </table>
    <p class="pst-defs-not"><strong>Not part of any avastha</strong> (shown beside them, so nothing is counted twice):</p>
    <ul class="pst-defs-list">
        @foreach (var item in AvasthaPvrNotes.NotCoveredByAvasthas) { <li>@item</li> }
    </ul>
</details>
<div class="pst-scroll">
    <table class="pst">
        <thead><tr>
            <th>Planet</th><th>Bālādi<br />(capacity)</th><th>Jāgradādi<br />(availability)</th><th>Śayanādi<br />(activity)</th><th>Dīptādi</th><th>Lajjitādi</th><th>Combined inference</th><th>Interpretation</th>
        </tr></thead>
        <tbody>
        @foreach (var r in Rows)
        {
            <tr>
                <td>@r.Planet</td>
                <td>
                    <strong>@StateLabel(r.AgeStateId)@(r.AgeEffectFraction is { } f ? $" · {f:0.#%}" : null)</strong>
                    @if (StateMeaning(r.AgeStateId) is { } ageMeaning) { <span class="pst-meaning">@ageMeaning</span> }
                    @if (Why(r.Planet, "Baaladi", r.AgeStateId) is { } ageWhy) { <span class="pst-why">@ageWhy</span> }
                </td>
                <td>
                    <strong>@StateLabel(r.WakefulnessStateId)</strong>
                    @if (StateMeaning(r.WakefulnessStateId) is { } wakeMeaning) { <span class="pst-meaning">@wakeMeaning</span> }
                    @if (Why(r.Planet, "Jagradadi", r.WakefulnessStateId) is { } wakeWhy) { <span class="pst-why">@wakeWhy</span> }
                </td>
                <td>
                    <strong>@StateLabel(r.PostureStateId)@(StateIndex(r.PostureStateId) is { } idx ? $" · {idx}/12" : null)</strong>
                    @if (StateMeaning(r.PostureStateId) is { } postureMeaning) { <span class="pst-meaning">@postureMeaning</span> }
                    @if (Why(r.Planet, "Sayanadi", r.PostureStateId) is { } postureWhy) { <span class="pst-why">@postureWhy</span> }
                </td>
                <td>
                    @if (r.DeeptadiStateIds.Count == 0) { <strong>—</strong> }
                    @foreach (var id in r.DeeptadiStateIds)
                    {
                        <div class="pst-state"><strong>@StateLabel(id)</strong>
                            @if (Why(r.Planet, "Deeptadi", id) is { } why) { <span class="pst-why">@why</span> }</div>
                    }
                </td>
                <td>
                    @if (r.LajjitadiStateIds.Count == 0) { <strong>—</strong> }
                    @foreach (var id in r.LajjitadiStateIds)
                    {
                        <div class="pst-state"><strong>@StateLabel(id)</strong>
                            @if (Why(r.Planet, "Lajjitadi", id) is { } why) { <span class="pst-why">@why</span> }</div>
                    }
                </td>
                <td class="pst-inference">
                    @{ var synthesis = CombinedInference(r); }
                    <span class="pst-verdict pst-verdict-@synthesis.Tone">@synthesis.Headline</span>
                    <span><b>Capacity:</b> @synthesis.Capacity</span>
                    <span><b>Baseline:</b> @synthesis.Baseline</span>
                    <span><b>Context:</b> @synthesis.Context</span>
                </td>
                <td class="pst-reading">
                    @if (Interpretation(r) is { } interpretation)
                    {
                        <span>@interpretation.InterpretationText</span>
                        @if (!string.IsNullOrWhiteSpace(interpretation.ConditionNotes))
                        {
                            <span class="pst-condition"><b>Conditional:</b> @interpretation.ConditionNotes</span>
                        }
                        <span class="pst-source">@interpretation.SourceRefCode · @interpretation.SourceLocator</span>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PlanetaryStateFact> Rows { get; set; } = Array.Empty<PlanetaryStateFact>();
    [Parameter, EditorRequired] public IReadOnlyDictionary<byte, PlanetaryStateRow> StateNames { get; set; } = new Dictionary<byte, PlanetaryStateRow>();
    [Parameter, EditorRequired] public IReadOnlyDictionary<(byte PlanetaryStateId, byte PlanetId), PostureStateInterpretationRow> PostureInterpretations { get; set; } =
        new Dictionary<(byte PlanetaryStateId, byte PlanetId), PostureStateInterpretationRow>();
    [Parameter, EditorRequired] public IReadOnlyList<ChartKeyDetail> KeyDetails { get; set; } = Array.Empty<ChartKeyDetail>();
    [Parameter, EditorRequired] public IReadOnlyList<ShadbalaSummaryRow> Strengths { get; set; } = Array.Empty<ShadbalaSummaryRow>();

    /// <summary>How each state was reached, per planet — from <c>PlanetaryStateComputer</c> run live on this chart
    /// (the stored facts carry only ids). A state with no matching reason shows none, so the two can never disagree.</summary>
    [Parameter] public IReadOnlyDictionary<string, IReadOnlyList<StateReason>> Reasons { get; set; } =
        new Dictionary<string, IReadOnlyList<StateReason>>();

    private string? Why(string planet, string system, byte? stateId)
    {
        if (stateId is null || !Reasons.TryGetValue(planet, out var list)) return null;
        var name = StateLabel(stateId);
        return list.FirstOrDefault(x => x.System == system && x.State == name)?.Reason;
    }

    private static readonly HashSet<string> Supportive = new(StringComparer.OrdinalIgnoreCase)
        { "Deepta", "Swastha", "Mudita", "Saanta", "Garvita" };
    private static readonly HashSet<string> Adverse = new(StringComparer.OrdinalIgnoreCase)
        { "Duhkhita", "Vikala", "Khala", "Kopita", "Lajjita", "Kshudhita", "Trishita", "Kshobhita" };

    private string StateLabel(byte? id) => id is { } v && StateNames.TryGetValue(v, out var s) ? s.StateName : "—";
    private int? StateIndex(byte? id) => id is { } v && StateNames.TryGetValue(v, out var s) ? s.SequenceOrder : null;
    private string? StateMeaning(byte? id) => id is { } v && StateNames.TryGetValue(v, out var s) ? s.Meaning : null;
    private string StateNamesJoined(IReadOnlyList<byte> ids) =>
        ids.Count == 0 ? "—" : string.Join(", ", ids.Select(id => StateLabel(id)));
    private PostureStateInterpretationRow? Interpretation(PlanetaryStateFact row) =>
        row.PostureStateId is { } stateId && row.PlanetId is { } planetId
            ? PostureInterpretations.GetValueOrDefault((stateId, planetId))
            : null;

    private CombinedStateInference CombinedInference(PlanetaryStateFact row)
    {
        var dignity = KeyDetails.FirstOrDefault(k => k.Planet.Equals(row.Planet, StringComparison.OrdinalIgnoreCase))?.DignityStatus;
        var strength = Strengths.FirstOrDefault(s => s.Planet.Equals(row.Planet, StringComparison.OrdinalIgnoreCase));
        var deeptadi = StateLabels(row.DeeptadiStateIds);
        var lajjitadi = StateLabels(row.LajjitadiStateIds);
        var capacity = new List<string>();
        if (strength?.PercentOfMinimum is { } percent)
            capacity.Add($"{StrengthBand(percent)} Ṣaḍbala ({percent:0}% of minimum)");
        if (row.AgeStateId is { } ageId)
            capacity.Add($"{StateLabel(ageId)} Bālādi{(row.AgeEffectFraction is { } fraction ? $" ({fraction:0.#%})" : "")}");

        var baseline = new List<string>();
        if (!string.IsNullOrWhiteSpace(dignity)) baseline.Add(dignity);
        var wakefulness = StateLabel(row.WakefulnessStateId);
        if (wakefulness != "—") baseline.Add(wakefulness);
        if (deeptadi.Count > 0) baseline.Add(string.Join(", ", deeptadi));

        var allStates = deeptadi.Concat(lajjitadi).ToList();
        var hasSupport = allStates.Any(Supportive.Contains);
        var hasAdverse = allStates.Any(Adverse.Contains);
        var (headline, tone) = (hasSupport, hasAdverse) switch
        {
            (true, false) => ("Supported expression", "supportive"),
            (false, true) => ("Constrained expression", "adverse"),
            (true, true) => ("Mixed expression", "mixed"),
            _ => ("Baseline expression", "neutral")
        };
        return new CombinedStateInference(headline, tone,
            capacity.Count == 0 ? "not available" : string.Join("; ", capacity),
            baseline.Count == 0 ? "not available" : string.Join(" · ", baseline),
            lajjitadi.Count == 0 ? "no additional Lajjitādi condition stored" : string.Join(", ", lajjitadi));
    }

    private List<string> StateLabels(IReadOnlyList<byte> ids) =>
        ids.Select(id => StateLabel(id)).Where(s => s != "—").Distinct(StringComparer.OrdinalIgnoreCase).ToList();

    private static string StrengthBand(decimal percent) => percent switch
    {
        < 75 => "very weak", < 90 => "weak", < 110 => "adequate", < 130 => "strong", _ => "very strong"
    };

    private sealed record CombinedStateInference(string Headline, string Tone, string Capacity, string Baseline, string Context);
}
