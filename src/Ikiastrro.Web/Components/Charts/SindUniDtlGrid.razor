@using Ikiastrro.Core.Presentation
@*
    SIND-UNI-DTL — the detailed South Indian grid: a perfect-square 4x4 with fixed sign positions,
    one chip per planet ("Ju" direct, "(Ju)" retrograde, several to a row) with a dignity dot, an
    ascendant highlight, two house badges per cell and a 2x2 center info cell. Just the grid+center
    cell: the dignity legend is rendered once by the caller (a page can show several grids side by
    side, sharing one legend below them, since they use the same 7-tier dignity scale). Kept as one
    component so every caller reuses the exact same rendering. Spec: docs/ui/components/spec_SIND-UNI-DTL.md.

    Reads --paper/--ink/--dignity-* etc. via var(...) from a closer .page-scoped override (the
    caller's own tokens) — CSS custom-property inheritance follows the real DOM tree and isn't affected by
    Blazor's per-component scope attributes, so this works even though this component has its own
    separate CSS-isolation scope.

    House numbers are computed here from AscendantSign rather than passed in — reuses
    AstroMath.CountFromSignToSign, the same Whole-Sign house-counting helper every calculator already
    uses, so D1 and D9 both get correct house numbers just by passing their own respective AscendantSign.
*@

@using Ikiastrro.Core.Engines.Astronomy

<div class="grid-root @(Compact ? "compact" : "")">
    <div class="chart">
        @foreach (var cell in GridCells)
        {
            var isAscendant = cell.MatchSign == AscendantSign;
            var isLinked = !Compact && HighlightSign == cell.MatchSign;
            var glyphs = PlanetsBySign.TryGetValue(cell.MatchSign, out var list) ? list : Array.Empty<GridPlanetGlyph>();
            var cellSign = Enum.Parse<ZodiacName>(cell.MatchSign);
            var houseFromLagna = AstroMath.CountFromSignToSign(Enum.Parse<ZodiacName>(AscendantSign), cellSign);
            int? houseFromMoon = string.IsNullOrEmpty(MoonSign)
                ? null
                : AstroMath.CountFromSignToSign(Enum.Parse<ZodiacName>(MoonSign), cellSign);
            var aspectedBy = !Compact && AspectedByGlyphs.TryGetValue(cell.MatchSign, out var byList) ? byList : Array.Empty<string>();

            var argalaRole = !Compact ? ArgalaRole(cellSign) : null;

            <div class="cell @(isAscendant ? "ascendant" : "") @(isLinked ? "link-hl" : "") @argalaRole?.Css" data-sign="@cell.MatchSign" style="grid-column:@cell.Col;grid-row:@cell.Row;">
                <span class="house-nums">
                    <span class="house-num from-lagna" title="House @houseFromLagna from Lagna">@houseFromLagna</span>
                    @if (houseFromMoon is int hm)
                    {
                        <span class="house-num from-moon" title="House @hm from the Moon">@hm</span>
                    }
                </span>
                <div class="sign-label"><span class="sign-en">@cell.DisplayEn</span></div>
                @if (isLinked && !string.IsNullOrEmpty(HighlightLabel))
                {
                    <div class="special-labels"><span class="special-label link-label">@HighlightLabel</span></div>
                }
                @if (argalaRole is not null)
                {
                    <div class="special-labels">
                        <span class="special-label arg-label">@argalaRole.Label</span>
                        @foreach (var tag in argalaRole.Tags)
                        {
                            <span class="special-label arg-tag @(tag.Warn ? "arg-tag-warn" : "") @(tag.Deciding ? "arg-tag-deciding" : "")" title="@tag.Title">@ChartViewModel.PlanetGlyph(tag.Planet)@(tag.Tag.Length > 0 ? "·" + tag.Tag : "")@(tag.Warn ? " ⚠" : "")</span>
                        }
                    </div>
                }
                @if (SpecialPointLabels.TryGetValue(cell.MatchSign, out var sp) && sp.Count > 0)
                {
                    <div class="special-labels">
                        @foreach (var spLabel in sp) { <span class="special-label">@spLabel</span> }
                    </div>
                }
                <div class="planets">
                    @foreach (var g in glyphs)
                    {
                        <span class="planet-glyph" title="@g.PlanetName @(g.IsRetrograde ? "(retrograde)" : "(direct)")">
                            <span class="pg-name">@(g.IsRetrograde ? $"({ChartViewModel.PlanetGlyph(g.PlanetName)})" : ChartViewModel.PlanetGlyph(g.PlanetName))</span>
                            @if (g.DignityToken is not null)
                            {
                                <span class="dot @PlanetBand.Class(g.PlanetName, PlanetBand.FromToken(g.DignityToken))"></span>
                            }
                            @if (g.IsCombust) { <span class="combust-icon" title="Combust">🔥</span> }
                        </span>
                    }
                </div>
                @if (aspectedBy.Count > 0)
                {
                    <div class="aspect-strip" title="Aspected by">
                        <span class="aspect-label">Asp</span>
                        <div class="planets">
                            @foreach (var glyph in aspectedBy)
                            {
                                <span class="planet-glyph aspect">@glyph</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        <div class="cell center" style="grid-column:2/4;grid-row:2/4;">
            <div class="center-title">@CenterTitle</div>
            <div class="center-meta">@CenterMeta</div>
        </div>

        @if (!Compact && Argala is { Links.Count: > 0 } overlay)
        {
            @* Argala overlay: arrows from each argala sign into the target, a blocked-bar from each obstructing
               sign onto the argala it obstructs. 400x400 box = the 4x4 grid, so a cell is 100 units. *@
            <svg class="arg-arrows" viewBox="0 0 400 400" preserveAspectRatio="none" aria-hidden="true">
                <defs>
                    <marker id="arg-ah-good" class="arg-mk arg-mk-good" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" /></marker>
                    <marker id="arg-ah-bad" class="arg-mk arg-mk-bad" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" /></marker>
                    <marker id="arg-ah-none" class="arg-mk arg-mk-none" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" /></marker>
                    <marker id="arg-tbar" class="arg-mk arg-mk-block" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M5,0 L5,10" /></marker>
                </defs>
                @foreach (var link in overlay.Links)
                {
                    var (sx, sy) = Centre(link.ArgalaSign);
                    if (link.HasArgala)
                    {
                        var (tx, ty) = Centre(overlay.Target);
                        var (x1, y1, x2, y2) = Shorten(sx, sy, tx, ty, 38);
                        <line class="arg-ln @NatureCss(link.Nature) @VerdictCss(link.Verdict) @DeliveryCss(link.Delivery) @(link.Dimmed ? "arg-dim" : "")" x1="@x1" y1="@y1" x2="@x2" y2="@y2" marker-end="url(#@MarkerId(link.Nature))" />
                        @if (link.Verdict == Ikiastrro.Data.Statistics.ArgalaVerdict.Obstructed)
                        {
                            <g class="arg-x @(link.Dimmed ? "arg-dim" : "")" transform="translate(@((x1 + x2) / 2) @((y1 + y2) / 2))">
                                <circle r="10" /><path d="M-4,-4 L4,4 M4,-4 L-4,4" />
                            </g>
                        }
                    }
                    @if (link.ObstructionSign is { } obstruction)
                    {
                        var (ox, oy) = Centre(obstruction);
                        var (a1, b1, a2, b2) = Shorten(ox, oy, sx, sy, 38);
                        <line class="arg-ln arg-ln-block @(link.Dimmed ? "arg-dim" : "")" x1="@a1" y1="@b1" x2="@a2" y2="@b2" marker-end="url(#arg-tbar)" />
                    }
                }
            </svg>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string AscendantSign { get; set; } = "";

    /// <summary>This chart's own natal Moon sign (internal ZodiacName spelling, e.g. "Scorpio",
    /// "Capricornus"). When set, every cell also shows its house counted from the Moon, in silver
    /// beside the gold house-from-Lagna number. Null/empty → only the Lagna number is shown.</summary>
    [Parameter] public string? MoonSign { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyDictionary<string, IReadOnlyList<GridPlanetGlyph>> PlanetsBySign { get; set; }
        = new Dictionary<string, IReadOnlyList<GridPlanetGlyph>>();

    [Parameter, EditorRequired] public string CenterTitle { get; set; } = "";
    [Parameter, EditorRequired] public RenderFragment CenterMeta { get; set; } = null!;

    /// <summary>Reduced detail for the saved-charts card gallery: hides the aspect strips.</summary>
    [Parameter] public bool Compact { get; set; }

    /// <summary>Sign (internal ZodiacName spelling) to highlight as the target of a linked table row, with
    /// the point's label printed in that cell. Null = no link highlight.</summary>
    [Parameter] public string? HighlightSign { get; set; }
    [Parameter] public string? HighlightLabel { get; set; }

    /// <summary>
    /// Sign → distinct glyphs of the planets casting an aspect (Drishti) into that sign, sourced from
    /// tbl_Chart_Aspects via ChartViewModel.BuildAspectedByGlyphs. Rendered as a dashed "Asp" strip
    /// pinned to the bottom of the cell, below whatever's actually placed there — only for cells
    /// that receive at least one aspect. Hidden in Compact mode. Empty by default.
    /// </summary>
    [Parameter] public IReadOnlyDictionary<string, IReadOnlyList<string>> AspectedByGlyphs { get; set; }
        = new Dictionary<string, IReadOnlyList<string>>();

    /// <summary>Internal sign name → special-point short codes to print under that cell's sign name
    /// (AL / A2..A12 / HL / Gk / Md). Empty → nothing rendered.</summary>
    [Parameter] public IReadOnlyDictionary<string, IReadOnlyList<string>> SpecialPointLabels { get; set; }
        = new Dictionary<string, IReadOnlyList<string>>();

    /// <summary>The Argala table's selection, drawn on the chart: the target house outlined, each argala sign
    /// outlined in its planets' nature colour with an arrow into the target (solid = holds, dashed = contested,
    /// crossed = obstructed), each obstructing sign dashed with a blocked-bar onto the argala it obstructs.
    /// Null = nothing drawn. Hidden in Compact mode.</summary>
    [Parameter] public ArgalaOverlay? Argala { get; set; }

    private sealed record ArgalaCellRole(string Css, string Label, IReadOnlyList<OverlayPlanet> Tags);

    private ArgalaCellRole? ArgalaRole(ZodiacName sign)
    {
        if (Argala is not { } overlay) return null;
        if (sign == overlay.Target) return new("arg-target", $"ARGALA ON H{overlay.House}", []);
        var source = overlay.Links.FirstOrDefault(l => l.HasArgala && l.ArgalaSign == sign);
        if (source is not null)
            return new($"arg-src {NatureCss(source.Nature)} {(source.Dimmed ? "arg-dim" : "")}", "ARGALA", source.ArgalaPlanets);
        var obstructor = overlay.Links.FirstOrDefault(l => l.ObstructionSign == sign);
        return obstructor is not null ? new($"arg-vir {(obstructor.Dimmed ? "arg-dim" : "")}", "VIRODHARGALA", obstructor.ObstructionPlanets) : null;
    }

    private static string NatureCss(Ikiastrro.Core.LifeMatters.Promise.Direction d) => d switch
    {
        Ikiastrro.Core.LifeMatters.Promise.Direction.Supportive => "arg-good",
        Ikiastrro.Core.LifeMatters.Promise.Direction.Obstructive => "arg-bad",
        _ => "arg-none"
    };

    private static string MarkerId(Ikiastrro.Core.LifeMatters.Promise.Direction d) => d switch
    {
        Ikiastrro.Core.LifeMatters.Promise.Direction.Supportive => "arg-ah-good",
        Ikiastrro.Core.LifeMatters.Promise.Direction.Obstructive => "arg-ah-bad",
        _ => "arg-ah-none"
    };

    private static string DeliveryCss(Delivery d) => d switch
    {
        Delivery.Full => "arg-d-full", Delivery.Medium => "arg-d-medium", Delivery.Negligible => "arg-d-negligible", _ => ""
    };

    private static string VerdictCss(Ikiastrro.Data.Statistics.ArgalaVerdict? v) => v switch
    {
        Ikiastrro.Data.Statistics.ArgalaVerdict.Contested => "arg-contested",
        Ikiastrro.Data.Statistics.ArgalaVerdict.Obstructed => "arg-obstructed",
        _ => ""
    };

    private static (int X, int Y) Centre(ZodiacName sign)
    {
        var cell = GridCells.First(c => c.MatchSign == sign.ToString());
        return ((cell.Col - 1) * 100 + 50, (cell.Row - 1) * 100 + 50);
    }

    /// <summary>The segment pulled in by <paramref name="inset"/> at both ends, so arrows start and end outside the glyphs.</summary>
    private static (int X1, int Y1, int X2, int Y2) Shorten(int x1, int y1, int x2, int y2, double inset)
    {
        double dx = x2 - x1, dy = y2 - y1;
        var len = Math.Sqrt(dx * dx + dy * dy);
        if (len <= inset * 2) return (x1, y1, x2, y2);
        double ux = dx / len, uy = dy / len;
        return ((int)Math.Round(x1 + ux * inset), (int)Math.Round(y1 + uy * inset),
                (int)Math.Round(x2 - ux * inset), (int)Math.Round(y2 - uy * inset));
    }

    // Fixed South Indian grid: sign never moves. MatchSign uses this project's internal
    // ZodiacName spelling ("Capricornus"); DisplayEn is the reader-facing label.
    private static readonly (string MatchSign, string DisplayEn, int Col, int Row)[] GridCells = new[]
    {
        ("Pisces", "Pisces", 1, 1), ("Aries", "Aries", 2, 1),
        ("Taurus", "Taurus", 3, 1), ("Gemini", "Gemini", 4, 1),
        ("Aquarius", "Aquarius", 1, 2), ("Cancer", "Cancer", 4, 2),
        ("Capricornus", "Capricorn", 1, 3), ("Leo", "Leo", 4, 3),
        ("Sagittarius", "Sagittarius", 1, 4), ("Scorpio", "Scorpio", 2, 4),
        ("Libra", "Libra", 3, 4), ("Virgo", "Virgo", 4, 4)
    };
}
