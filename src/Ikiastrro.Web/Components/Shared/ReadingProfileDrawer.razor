@namespace Ikiastrro.Web.Components.Shared

@if (Open)
{
    <div class="profile-scrim" role="presentation" @onclick="Close">
        <aside class="profile-drawer" role="dialog" aria-modal="true" aria-label="Reading profile" @onclick:stopPropagation="true">
            <div class="profile-drawer-head">
                <div>
                    <span class="eyebrow">Reading profile</span>
                    <h2>How should charts be read?</h2>
                </div>
                <button class="profile-close" type="button" aria-label="Close reading profile" @onclick="Close">×</button>
            </div>

            <p class="profile-intro">These preferences follow you between the saved-person list, the focused chart, and the all-charts gallery.</p>

            <div class="profile-section">
                <h3>Display</h3>
                <label class="profile-field">Theme
                    <select @bind="Profile.Theme">
                        <option value="orange">Orange</option>
                        <option value="nocturne">Nocturne</option>
                    </select>
                </label>
                <label class="profile-field">Default chart
                    <select @bind="Profile.DefaultChart">
                        <option value="D1">D1 · Rasi</option>
                        <option value="D9">D9 · Navamsa</option>
                        <option value="D10">D10 · Dasamsa</option>
                        <option value="D24">D24 · Education</option>
                        <option value="D60">D60 · Karmic roots</option>
                    </select>
                </label>
                <label class="profile-check"><input type="checkbox" @bind="Profile.TechnicalMode" /> Technical detail</label>
                <label class="profile-check"><input type="checkbox" @bind="Profile.ShowAspects" /> Show aspects</label>
            </div>

            <div class="profile-section">
                <h3>Interpretation lens</h3>
                <label class="profile-check"><input type="checkbox" @bind="Profile.ShowPlanetaryDignity" /> Planetary dignity</label>
                <label class="profile-check"><input type="checkbox" @bind="Profile.ShowDispositorRelations" /> Dispositor relations</label>
                <label class="profile-check"><input type="checkbox" @bind="Profile.ShowHouseLordCombinations" /> House-lord combinations</label>
                <label class="profile-check"><input type="checkbox" @bind="Profile.ShowDivisionalConfirmation" /> Divisional confirmation</label>
            </div>

            <button class="profile-apply" type="button" @onclick="Close">Use this profile</button>
        </aside>
    </div>
}

@code {
    [Parameter, EditorRequired] public ReadingProfileState Profile { get; set; } = new();
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    private Task Close() => OpenChanged.InvokeAsync(false);
}
