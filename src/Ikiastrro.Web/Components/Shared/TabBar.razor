@* Workspace life-area tabs. Real <a href="?tab=…"> anchors so they're bookmarkable and the
   back button works; the active tab is a gold-filled box. *@
<nav class="tabbar">
    @foreach (var (key, label) in Tabs)
    {
        <a href="@($"?tab={key}")" class="@(key == Selected ? "on" : "")">@label</a>
    }
</nav>

@code {
    /// <summary>Ordered (query-key, display-label) pairs.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<(string Key, string Label)> Tabs { get; set; } = Array.Empty<(string, string)>();

    [Parameter, EditorRequired] public string Selected { get; set; } = "";
}
