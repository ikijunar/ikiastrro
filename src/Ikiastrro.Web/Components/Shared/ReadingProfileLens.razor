@namespace Ikiastrro.Web.Components.Shared

<div class="profile-lens" role="status" aria-label="Active reading lenses">
    <span class="profile-lens-title">Reading lens</span>
    @if (Profile.ShowPlanetaryDignity) { <span class="profile-lens-chip">Planetary dignity</span> }
    @if (Profile.ShowDispositorRelations) { <span class="profile-lens-chip">Dispositor relations</span> }
    @if (Profile.ShowHouseLordCombinations) { <span class="profile-lens-chip">House-lord combinations</span> }
    @if (Profile.ShowDivisionalConfirmation) { <span class="profile-lens-chip">Divisional confirmation</span> }
    @if (!Profile.ShowPlanetaryDignity && !Profile.ShowDispositorRelations && !Profile.ShowHouseLordCombinations && !Profile.ShowDivisionalConfirmation)
    {
        <span class="profile-lens-empty">No interpretation overlays selected</span>
    }
</div>

@code {
    [Parameter, EditorRequired] public ReadingProfileState Profile { get; set; } = new();
}
