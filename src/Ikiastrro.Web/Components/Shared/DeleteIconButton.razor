@* Real icon button for a destructive action — replaces the plain "Delete" text link that used to
   sit in the table and header of the pages that are now SavedCharts.razor and Workspace.razor
   (2026-08-28 UI cleanup). Opens the
   caller's ConfirmDialog; this component only renders the trigger. *@
<button type="button" class="delete-icon-btn" title="@Title" aria-label="@Title" @onclick="OnClick">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round">
        <polyline points="3 6 5 6 21 6"></polyline>
        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
        <path d="M10 11v6" />
        <path d="M14 11v6" />
        <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
    </svg>
</button>

@code {
    [Parameter] public string Title { get; set; } = "Delete";
    [Parameter] public EventCallback OnClick { get; set; }
}
