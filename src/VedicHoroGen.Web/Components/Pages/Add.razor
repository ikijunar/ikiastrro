@page "/add"
@using System.ComponentModel.DataAnnotations
@inject BirthDetailsRepository BirthDetailsRepo
@inject ChartGenerationService ChartGenerationService
@inject IPlaceResolver PlaceResolver
@inject NavigationManager Nav

<PageTitle>Add New Person — vedic_horo_gen</PageTitle>

<p class="back-link"><a href="/">&larr; Back</a></p>
<h1>Add a new person</h1>
<p>Enter birth details to generate and store D1 (Rasi) + D9 (Navamsa) charts.</p>

<EditForm Model="model" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    <div class="field">
        <label for="name">Name</label>
        <InputText id="name" @bind-Value="model.Name" @onblur="CheckDuplicateName" autocomplete="off" />
        <ValidationMessage For="() => model.Name" />
        @if (duplicateNameError is not null)
        {
            <div class="field-error">@duplicateNameError</div>
        }
    </div>

    <div class="field">
        <label for="dob">Date of Birth</label>
        <InputDate id="dob" @bind-Value="model.DateOfBirth" Type="InputDateType.Date" />
        <ValidationMessage For="() => model.DateOfBirth" />
    </div>

    <div class="field">
        <label for="tob">Time of Birth</label>
        <InputDate id="tob" @bind-Value="model.TimeOfBirth" Type="InputDateType.Time" />
        <ValidationMessage For="() => model.TimeOfBirth" />
    </div>

    <div class="field">
        <label for="city">Place of Birth - City</label>
        <InputText id="city" @bind-Value="model.PlaceCity" />
        <ValidationMessage For="() => model.PlaceCity" />
    </div>

    <div class="field">
        <label for="country">Place of Birth - Country</label>
        <InputText id="country" @bind-Value="model.PlaceCountry" />
        <ValidationMessage For="() => model.PlaceCountry" />
    </div>

    @if (needsManualLocation)
    {
        <div class="alert-warning">
            <p>@geocodeError</p>
            <p>Enter location details manually:</p>
        </div>
        <div class="field">
            <label for="lat">Latitude (decimal degrees, e.g. 13.0827)</label>
            <InputNumber id="lat" @bind-Value="manualLatitude" />
        </div>
        <div class="field">
            <label for="long">Longitude (decimal degrees, e.g. 80.2707)</label>
            <InputNumber id="long" @bind-Value="manualLongitude" />
        </div>
        <div class="field">
            <label for="utc">UTC offset (e.g. 05:30 or -08:00)</label>
            <InputText id="utc" @bind-Value="manualUtcOffset" />
        </div>
    }

    @if (submitError is not null)
    {
        <div class="field-error">@submitError</div>
    }

    <button class="btn" type="submit" disabled="@isSubmitting">
        @(isSubmitting ? "Working..." : "Generate Chart")
    </button>
</EditForm>

@code {
    private readonly BirthDetailsFormModel model = new();
    private string? duplicateNameError;
    private string? submitError;
    private bool isSubmitting;

    private bool needsManualLocation;
    private string? geocodeError;
    private double? manualLatitude;
    private double? manualLongitude;
    private string? manualUtcOffset;

    private void CheckDuplicateName()
    {
        duplicateNameError = null;
        var name = model.Name?.Trim();
        if (string.IsNullOrWhiteSpace(name)) return;

        if (BirthDetailsRepo.ExistsByName(name))
        {
            duplicateNameError = $"A record named \"{name}\" already exists. Go back and pick it from the Home dropdown, or use a different name.";
        }
    }

    private async Task HandleSubmit()
    {
        submitError = null;
        isSubmitting = true;
        try
        {
            var name = model.Name.Trim();

            // --- Duplicate name check (re-verified at submit time; the DB's unique index on
            //     Name is the final backstop against a race between this check and the insert). ---
            if (BirthDetailsRepo.ExistsByName(name))
            {
                duplicateNameError = $"A record named \"{name}\" already exists. Go back and pick it from the Home dropdown, or use a different name.";
                return;
            }

            // --- Resolve place -> lat/long/UTC-offset, unless the user already filled the manual fallback. ---
            double latitude, longitude;
            string utcOffset, ianaTimeZoneId;

            if (needsManualLocation)
            {
                if (manualLatitude is null || manualLongitude is null || string.IsNullOrWhiteSpace(manualUtcOffset))
                {
                    submitError = "Enter latitude, longitude, and UTC offset to continue.";
                    return;
                }
                latitude = manualLatitude.Value;
                longitude = manualLongitude.Value;
                utcOffset = NormalizeUtcOffset(manualUtcOffset);
                ianaTimeZoneId = "Manual";
            }
            else
            {
                try
                {
                    var resolved = await PlaceResolver.ResolveAsync(model.PlaceCity.Trim(), model.PlaceCountry.Trim(), model.DateOfBirth);
                    latitude = resolved.Latitude;
                    longitude = resolved.Longitude;
                    utcOffset = FormatUtcOffset(resolved.UtcOffset);
                    ianaTimeZoneId = resolved.IanaTimeZoneId;
                }
                catch (Exception ex)
                {
                    geocodeError = $"Automatic location resolution failed: {ex.Message}";
                    needsManualLocation = true;
                    return;
                }
            }

            var birthDetails = new BirthDetails
            {
                Name = name,
                DateOfBirth = model.DateOfBirth,
                TimeOfBirth = model.TimeOfBirth,
                PlaceCity = model.PlaceCity.Trim(),
                PlaceCountry = model.PlaceCountry.Trim(),
                Latitude = latitude,
                Longitude = longitude,
                UtcOffset = utcOffset,
                IanaTimeZoneId = ianaTimeZoneId
            };

            // --- Store input, then compute + store every chart type + Vimshottari Dasha ---
            BirthDetailsRepo.Insert(birthDetails);
            ChartGenerationService.GenerateAll(birthDetails);

            Nav.NavigateTo($"/charts/{birthDetails.Id}");
        }
        catch (Exception ex)
        {
            submitError = $"Could not save/calculate: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private static string FormatUtcOffset(TimeSpan offset)
    {
        var formatted = offset.ToString(@"hh\:mm\:ss");
        return offset < TimeSpan.Zero ? "-" + formatted : formatted;
    }

    private static string NormalizeUtcOffset(string input)
    {
        if (TimeSpan.TryParse(input, out var parsed))
        {
            var formatted = parsed.ToString(@"hh\:mm\:ss");
            return parsed < TimeSpan.Zero ? "-" + formatted : formatted;
        }
        return input;
    }

    private class BirthDetailsFormModel
    {
        [Required(ErrorMessage = "Name is required.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Date of Birth is required.")]
        public DateOnly DateOfBirth { get; set; }

        [Required(ErrorMessage = "Time of Birth is required.")]
        public TimeOnly TimeOfBirth { get; set; }

        [Required(ErrorMessage = "Place of Birth - City is required.")]
        public string PlaceCity { get; set; } = string.Empty;

        [Required(ErrorMessage = "Place of Birth - Country is required.")]
        public string PlaceCountry { get; set; } = string.Empty;
    }
}
