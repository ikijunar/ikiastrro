@* Mahadasha -> Antardasha list (Pratyantardasha shown only for whichever Antardasha is current —
   showing all 729 leaf periods by default would swamp the page). The currently-active period at
   every level is marked, not just colored, so "what's happening now" never depends on color alone. *@
<div class="dasha-timeline">
    <DashaLegend />

    <ul class="maha-list">
        @foreach (var maha in Roots.OrderBy(p => p.StartDayOffset))
        {
            var mahaCurrent = IsCurrent(maha);
            <li class="maha-row @(mahaCurrent ? "current" : "")">
                <div class="period-line">
                    <span class="swatch" style="background:@DashaLordColors.CssVar(maha.Lord)"></span>
                    <span class="lord">@maha.Lord</span>
                    <span class="label">Mahadasha</span>
                    <span class="range">@FormatRange(maha.StartDate, maha.EndDate)</span>
                    @if (mahaCurrent)
                    {
                        <span class="current-badge">current</span>
                    }
                </div>

                <ul class="antar-list">
                    @foreach (var antar in maha.Children.OrderBy(p => p.StartDayOffset))
                    {
                        var antarCurrent = mahaCurrent && IsCurrent(antar);
                        <li class="antar-row @(antarCurrent ? "current" : "")">
                            <div class="period-line">
                                <span class="swatch" style="background:@DashaLordColors.CssVar(antar.Lord)"></span>
                                <span class="lord">@antar.Lord</span>
                                <span class="label">Antardasha</span>
                                <span class="range">@FormatRange(antar.StartDate, antar.EndDate)</span>
                                @if (antarCurrent)
                                {
                                    <span class="current-badge">current</span>
                                }
                            </div>

                            @if (antarCurrent)
                            {
                                <ul class="pratyantar-list">
                                    @foreach (var pratyantar in antar.Children.OrderBy(p => p.StartDayOffset))
                                    {
                                        var pratyantarCurrent = IsCurrent(pratyantar);
                                        <li class="pratyantar-row @(pratyantarCurrent ? "current" : "")">
                                            <div class="period-line">
                                                <span class="swatch" style="background:@DashaLordColors.CssVar(pratyantar.Lord)"></span>
                                                <span class="lord">@pratyantar.Lord</span>
                                                <span class="label">Pratyantardasha</span>
                                                <span class="range">@FormatRange(pratyantar.StartDate, pratyantar.EndDate)</span>
                                                @if (pratyantarCurrent)
                                                {
                                                    <span class="current-badge">current</span>
                                                }
                                            </div>
                                        </li>
                                    }
                                </ul>
                            }
                        </li>
                    }
                </ul>
            </li>
        }
    </ul>
</div>

@code {
    [Parameter] public IReadOnlyList<DashaPeriodRecord> Roots { get; set; } = Array.Empty<DashaPeriodRecord>();

    /// <summary>Defaults to now — overridable for testing/screenshots of a specific moment.</summary>
    [Parameter] public DateTime AsOf { get; set; } = DateTime.Now;

    private bool IsCurrent(DashaPeriodRecord period) => AsOf >= period.StartDate && AsOf <= period.EndDate;

    private static string FormatRange(DateTime start, DateTime end) =>
        $"{start:d MMM yyyy} → {end:d MMM yyyy}";
}
