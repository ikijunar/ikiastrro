@using VedicHoroGen.Core.Calculators
@using VedicHoroGen.Core.Models

<div class="page">

    <header>
        <meta name="theme-color" content="cornflowerblue" />
        <div class="eyebrow">D1 · Lagna Kundali</div>
        <h1>@BirthDetails.Name</h1>
        <div class="byline">
            Born <strong>@BirthDetails.DateOfBirth.ToString("d MMMM yyyy") @FormatTime(BirthDetails.EffectiveTimeOfBirth) (@BirthDetails.UtcOffset)</strong>
            · <strong>@BirthDetails.PlaceCity, @BirthDetails.PlaceCountry</strong><br>
            Lahiri ayanamsha
        </div>
    </header>

    <section>
        <h2>Divisional charts</h2>
        <p class="section-note">D1 (Rasi) on the left, D9 (Navamsa) on the right. Each planet's dot shows its classical dignity in that chart's sign — see legend below. The number on the right edge of each cell is that sign's house counted from its own chart's Lagna. A house that receives a classical aspect (Drishti) from another planet or house gets a dashed "Aspected by" strip at the bottom, from <code>tbl_Chart_Aspects</code>.</p>

        <div class="chart-row">
            <div class="chart-col">
                <h3>D1 · Rasi</h3>
                <SouthIndianGrid AscendantSign="@AscendantSign" PlanetsBySign="@D1PlanetsBySign" AspectedByGlyphs="@D1AspectedByGlyphs" CenterTitle="Rasi · D1">
                    <CenterMeta>
                        <b>Nakshatra</b> @(MoonRow?.Nakshatra ?? "—") (Moon)<br>
                        <b>Rasi Lord</b> @RasiLordDisplay<br>
                        <b>Computed</b> vedic_horo_gen
                    </CenterMeta>
                </SouthIndianGrid>
            </div>
            <div class="chart-col">
                <h3>D9 · Navamsa</h3>
                @if (D9AscendantSign is not null)
                {
                    <SouthIndianGrid AscendantSign="@D9AscendantSign" PlanetsBySign="@D9PlanetsBySign" AspectedByGlyphs="@D9AspectedByGlyphs" CenterTitle="Navamsa · D9">
                        <CenterMeta>
                            <b>Lagna Lord</b> @D9RasiLordDisplayName<br>
                            <b>Computed</b> vedic_horo_gen
                        </CenterMeta>
                    </SouthIndianGrid>
                }
                else
                {
                    <p class="muted">No D9 chart computed yet.</p>
                }
            </div>
        </div>

        <div class="legend">
            <div class="legend-item"><span class="legend-dot" style="background:var(--dignity-exalted)"></span>Exalted</div>
            <div class="legend-item"><span class="legend-dot" style="background:var(--dignity-good)"></span>Moolatrikona / Own / Great Friend</div>
            <div class="legend-item"><span class="legend-dot" style="background:var(--dignity-friend)"></span>Friend</div>
            <div class="legend-item"><span class="legend-dot" style="background:var(--dignity-neutral)"></span>Neutral</div>
            <div class="legend-item"><span class="legend-dot" style="background:var(--dignity-enemy)"></span>Enemy</div>
            <div class="legend-item"><span class="legend-dot" style="background:var(--dignity-great-enemy)"></span>Great Enemy</div>
            <div class="legend-item"><span class="legend-dot" style="background:var(--dignity-debilitated)"></span>Debilitated</div>
            <div class="legend-item">(D) Direct / (R) Retrograde</div>
            <div class="legend-item">🔥 Combust (within orb of the Sun)</div>
        </div>
    </section>

    <section>
        <h2>D1 · Planetary positions</h2>
        <p class="section-note">Lahiri ayanamsha (Swiss Ephemeris <code>SE_SIDM_LAHIRI</code>, applied directly) · Whole Sign houses from Lagna · dignity per classical Panchadha Maitri. Nakshatra Lord, Direction, and Combust are the same real values on the D9 table below — see that section's note.</p>
        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th>Graha</th>
                        <th>Rasi</th>
                        <th>Degree</th>
                        <th>Nakshatra</th>
                        <th>Pada</th>
                        <th>Nakshatra Lord</th>
                        <th>Direction</th>
                        <th>Combust</th>
                        <th>House</th>
                        <th>House (Chandra)</th>
                        <th>Dignity</th>
                        <th>Rules</th>
                        <th>Aspects</th>
                        <th>Aspected By</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in PlanetRows)
                    {
                        <tr class="@(row.Planet == "Ascendant" ? "ascendant-row" : "")">
                            <td><span class="planet-name-en">@PlanetDisplayName(row.Planet)</span>@if (PlanetSecondaryName(row.Planet) is { } secondary) { <span class="planet-name-sa">@secondary</span> }</td>
                            <td>@DisplaySignName(row.Sign)</td>
                            <td class="degree">@row.DegreesInSignDisplay</td>
                            <td>@(row.Nakshatra ?? "—")</td>
                            <td>@(row.NakshatraPada?.ToString() ?? "—")</td>
                            <td>@(row.NakshatraLordPlanet is null ? "—" : PlanetDisplayName(row.NakshatraLordPlanet))</td>
                            <td>@ChartViewModel.DirectionLabel(row.IsRetrograde)</td>
                            <td>@ChartViewModel.CombustionLabel(row.IsCombust, row.DistanceFromSunDegrees, row.CombustionOrbUsedDegrees)</td>
                            <td>@row.HouseFromLagna</td>
                            <td>@row.HouseFromMoon</td>
                            <td>
                                @if (row.DignityStatus is null)
                                {
                                    <span class="muted">—</span>
                                }
                                else
                                {
                                    <span class="dignity-pill"><span class="dot" style="background:var(--dignity-@ChartViewModel.DignityToken(row.DignityStatus))"></span>@row.DignityStatus</span>
                                }
                            </td>
                            <td>@(row.RulesHouseNumbers ?? "—")</td>
                            <td class="@(row.AspectsCast is null ? "muted" : "")">@(row.AspectsCast ?? "—")</td>
                            <td class="@(row.AspectedBy is null ? "muted" : "")">@(row.AspectedBy ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    @if (D9AscendantSign is not null)
    {
        <section>
            <h2>D9 · Planetary positions</h2>
            <p class="section-note">Navamsa sign/house only — a varga sign is a discrete bucket, not a continuous 30° span, so Degree/Nakshatra/Pada (D1-only concepts) aren't shown here. Nakshatra Lord, Direction, and Combust ARE shown — all three are derived from the same real longitude D1 uses, so they're identical to that planet's D1 row above, not separately computed per chart.</p>
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>Graha</th>
                            <th>Navamsa Rasi</th>
                            <th>Nakshatra Lord</th>
                            <th>Direction</th>
                            <th>Combust</th>
                            <th>House</th>
                            <th>House (Chandra)</th>
                            <th>Dignity</th>
                            <th>Rules</th>
                            <th>Aspects</th>
                            <th>Aspected By</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in D9PlanetRows)
                        {
                            <tr class="@(row.Planet == "Ascendant" ? "ascendant-row" : "")">
                                <td><span class="planet-name-en">@PlanetDisplayName(row.Planet)</span>@if (PlanetSecondaryName(row.Planet) is { } secondary) { <span class="planet-name-sa">@secondary</span> }</td>
                                <td>@DisplaySignName(row.Sign)</td>
                                <td>@(row.NakshatraLordPlanet is null ? "—" : PlanetDisplayName(row.NakshatraLordPlanet))</td>
                                <td>@ChartViewModel.DirectionLabel(row.IsRetrograde)</td>
                                <td>@ChartViewModel.CombustionLabel(row.IsCombust, row.DistanceFromSunDegrees, row.CombustionOrbUsedDegrees)</td>
                                <td>@row.HouseFromLagna</td>
                                <td>@row.HouseFromMoon</td>
                                <td>
                                    @if (row.DignityStatus is null)
                                    {
                                        <span class="muted">—</span>
                                    }
                                    else
                                    {
                                        <span class="dignity-pill"><span class="dot" style="background:var(--dignity-@ChartViewModel.DignityToken(row.DignityStatus))"></span>@row.DignityStatus</span>
                                    }
                                </td>
                                <td>@(row.RulesHouseNumbers ?? "—")</td>
                                <td class="@(row.AspectsCast is null ? "muted" : "")">@(row.AspectsCast ?? "—")</td>
                                <td class="@(row.AspectedBy is null ? "muted" : "")">@(row.AspectedBy ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <section>
        <h2>House lordship</h2>
        <p class="section-note">Each house's sign, its ruling planet, and where that ruler actually sits in this chart — the classical "Lord of the Nth house is placed in..." reading.</p>
        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th>House</th>
                        <th>Sign</th>
                        <th>Lord</th>
                        <th>Placed In (Lagna)</th>
                        <th>Lord's Dignity</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in HouseLords.OrderBy(h => h.HouseNumber))
                    {
                        <tr>
                            <td>@h.HouseNumber</td>
                            <td>@DisplaySignName(h.HouseSign)</td>
                            <td>@h.LordPlanet</td>
                            <td>House @h.LordPlacedInHouseFromLagna, @DisplaySignName(h.LordPlacedInSign)</td>
                            <td>
                                @if (h.LordDignityStatus is null)
                                {
                                    <span class="muted">—</span>
                                }
                                else
                                {
                                    <span class="dignity-pill"><span class="dot" style="background:var(--dignity-@ChartViewModel.DignityToken(h.LordDignityStatus))"></span>@h.LordDignityStatus</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <footer>
        vedic_horo_gen &middot; BirthDetailId @BirthDetails.Id &middot; engine <code>@EngineVersion</code>.
        Lahiri sidereal longitudes come directly from Swiss Ephemeris (<code>SE_SIDM_LAHIRI</code>) — no post-hoc ayanamsha correction.
        Dignity and aspects computed from classical Parashari reference tables (<code>ClassicalDignity.cs</code>, <code>ClassicalRelationships.cs</code>), shared by every chart type via <code>ChartAnalyzer.cs</code>.
        Rahu/Ketu use the Parashari exaltation/debilitation convention and the Jupiter-style 5th/7th/9th aspect convention; "House (Chandra)" is counted from the Moon's sign rather than the Ascendant.
    </footer>

</div>

@code {
    [Parameter, EditorRequired] public BirthDetails BirthDetails { get; set; } = null!;
    [Parameter, EditorRequired] public IReadOnlyList<ChartKeyDetail> KeyDetails { get; set; } = Array.Empty<ChartKeyDetail>();
    [Parameter, EditorRequired] public IReadOnlyList<ChartHouseLord> HouseLords { get; set; } = Array.Empty<ChartHouseLord>();
    [Parameter, EditorRequired] public IReadOnlyList<ChartAspect> Aspects { get; set; } = Array.Empty<ChartAspect>();
    [Parameter, EditorRequired] public string EngineVersion { get; set; } = "";

    /// <summary>D9's Ascendant (Navamsa Lagna) sign — null if no D9 chart has been computed for this person yet.</summary>
    [Parameter] public string? D9AscendantSign { get; set; }
    [Parameter] public IReadOnlyList<ChartKeyDetail> D9KeyDetails { get; set; } = Array.Empty<ChartKeyDetail>();
    /// <summary>D9's house-1 (Navamsa Lagna) lord planet, plain name — formatted for display here.</summary>
    [Parameter] public string? D9RasiLordDisplay { get; set; }
    [Parameter] public IReadOnlyList<ChartAspect> D9Aspects { get; set; } = Array.Empty<ChartAspect>();
    /// <summary>D9's house-lordship rows — needed for the D9 "Planetary positions" table's Rules column (2026-08-28; the grid alone never needed this).</summary>
    [Parameter] public IReadOnlyList<ChartHouseLord> D9HouseLords { get; set; } = Array.Empty<ChartHouseLord>();

    // EXTENSION POINT: a future divisional chart (D2, D10, ...) needs the same two lines — its own
    // KeyDetails/Aspects in, a BuildAspectedByGlyphs result out, passed to its own SouthIndianGrid's
    // AspectedByGlyphs parameter — see ChartViewModel.BuildAspectedByGlyphs's doc comment.
    private IReadOnlyDictionary<string, IReadOnlyList<string>> D1AspectedByGlyphs => ChartViewModel.BuildAspectedByGlyphs(KeyDetails, Aspects);
    private IReadOnlyDictionary<string, IReadOnlyList<string>> D9AspectedByGlyphs => ChartViewModel.BuildAspectedByGlyphs(D9KeyDetails, D9Aspects);

    private IReadOnlyList<PlanetRow> PlanetRows => ChartViewModel.BuildPlanetRows(KeyDetails, HouseLords, Aspects);
    // D9's own table (2026-08-28) — BuildPlanetRows was already chart-type-generic, just never called for D9 before.
    private IReadOnlyList<PlanetRow> D9PlanetRows => ChartViewModel.BuildPlanetRows(D9KeyDetails, D9HouseLords, D9Aspects);
    private string AscendantSign => KeyDetails.FirstOrDefault(k => k.Planet == "Ascendant")?.Sign ?? "";
    private ChartKeyDetail? MoonRow => KeyDetails.FirstOrDefault(k => k.Planet == "Moon");

    private string RasiLordDisplay => FormatLordDisplay(HouseLords.FirstOrDefault(h => h.HouseNumber == 1)?.LordPlanet);
    private string D9RasiLordDisplayName => FormatLordDisplay(D9RasiLordDisplay);

    private static string FormatLordDisplay(string? lord)
    {
        if (lord is null) return "—";
        var sanskrit = PlanetDisplayName(lord);
        return sanskrit == lord ? lord : $"{sanskrit} ({lord})"; // Rahu/Ketu have no separate Sanskrit name
    }

    private IReadOnlyDictionary<string, IReadOnlyList<GridPlanetGlyph>> D1PlanetsBySign => BuildPlanetsBySign(KeyDetails);
    private IReadOnlyDictionary<string, IReadOnlyList<GridPlanetGlyph>> D9PlanetsBySign => BuildPlanetsBySign(D9KeyDetails);

    private static IReadOnlyDictionary<string, IReadOnlyList<GridPlanetGlyph>> BuildPlanetsBySign(IReadOnlyList<ChartKeyDetail> keyDetails) =>
        keyDetails
            .Where(k => k.Planet != "Ascendant")
            .GroupBy(k => k.Sign)
            .ToDictionary(
                g => g.Key,
                g => (IReadOnlyList<GridPlanetGlyph>)g
                    .Select(k => new GridPlanetGlyph(
                        ChartViewModel.PlanetGlyph(k.Planet),
                        ChartViewModel.DignityToken(k.DignityStatus),
                        k.IsRetrograde ?? false,
                        k.IsCombust ?? false))
                    .ToList());

    private static string DisplaySignName(string sign) => sign == "Capricornus" ? "Capricorn" : sign;

    /// <summary>Primary name shown for a graha — Sanskrit for the 7 classical planets, "Lagna" for the
    /// Ascendant, and the plain name for Rahu/Ketu (no separate Sanskrit form in either tradition).</summary>
    private static string PlanetDisplayName(string planet) => planet switch
    {
        "Ascendant" => "Lagna",
        "Sun" => "Surya",
        "Moon" => "Chandra",
        "Mars" => "Mangal",
        "Mercury" => "Budh",
        "Jupiter" => "Guru",
        "Venus" => "Shukra",
        "Saturn" => "Shani",
        _ => planet // Rahu, Ketu
    };

    /// <summary>Secondary (English) name shown under the primary one — null for Rahu/Ketu, which have no secondary.</summary>
    private static string? PlanetSecondaryName(string planet) => planet switch
    {
        "Ascendant" or "Sun" or "Moon" or "Mars" or "Mercury" or "Jupiter" or "Venus" or "Saturn" => planet,
        _ => null // Rahu, Ketu
    };

    private static string FormatTime(TimeOnly time) => time.ToString("h:mm tt");
}
